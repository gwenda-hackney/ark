---
import "../styles/global.css";
import { siteConfig, cfBeaconToken } from "../config/site";
import { isStaging } from "../config/env";
import Analytics from "../components/Analytics.astro";
import SocialMeta from "../components/SocialMeta.astro";
import StagingRibbon from "../components/StagingRibbon.astro";
import favicon from "../assets/images/logos/favicon-dark.png";

interface Props {
  title?: string;
  description?: string;
  socialTitle?: string;
  socialDescription?: string;
}

const {
  title = `${siteConfig.name} — ${siteConfig.tagline}`,
  description = siteConfig.description,
  socialTitle,
  socialDescription,
} = Astro.props;

const siteOrigin = isStaging
  ? "https://gwenda-staging.pages.dev"
  : siteConfig.domain;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}
    <SocialMeta
      title={socialTitle ?? title}
      description={socialDescription ?? siteConfig.social.shareDescription}
      url={canonicalUrl}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href={favicon.src} />

    {cfBeaconToken && <Analytics />}
    <slot name="head" />
  </head>
  <body>
    <StagingRibbon />
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <script src="../scripts/main.js"></script>
  </body>
</html>
