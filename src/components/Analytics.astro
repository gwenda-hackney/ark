---
import { cfBeaconToken } from "../config/site";

/** Cloudflare snippet uses single-quoted data-cf-beacon to avoid HTML entity encoding. */
const beaconSnippet = cfBeaconToken
  ? `<!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='${JSON.stringify({ token: cfBeaconToken })}'></script><!-- End Cloudflare Web Analytics -->`
  : "";
---

{beaconSnippet && <Fragment set:html={beaconSnippet} />}
