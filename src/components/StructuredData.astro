---
import { siteConfig } from "../config/site";

interface Props {
  url: string;
  title: string;
  description: string;
}

const { url, title, description } = Astro.props;
const { location, social, name, domain, contact, brand } = siteConfig;
const logoUrl = new URL(brand.organizationLogoPath, domain).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${domain}/#organization`,
      name,
      url: domain,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
        width: brand.organizationLogoWidth,
        height: brand.organizationLogoHeight,
      },
      sameAs: [social.instagram].filter(Boolean),
    },
    {
      "@type": "WebSite",
      "@id": `${domain}/#website`,
      url: domain,
      name,
      description: siteConfig.description,
      publisher: { "@id": `${domain}/#organization` },
      inLanguage: "en-GB",
    },
    {
      "@type": "WebPage",
      "@id": `${url}#webpage`,
      url,
      name: title,
      description,
      isPartOf: { "@id": `${domain}/#website` },
      about: { "@id": `${domain}/#business` },
      inLanguage: "en-GB",
    },
    {
      "@type": "BarOrPub",
      "@id": `${domain}/#business`,
      name,
      description: siteConfig.description,
      url: domain,
      image: logoUrl,
      email: contact.email,
      parentOrganization: { "@id": `${domain}/#organization` },
      address: {
        "@type": "PostalAddress",
        streetAddress: location.streetAddress,
        addressLocality: location.addressLocality,
        addressRegion: location.addressRegion,
        postalCode: location.postalCode,
        addressCountry: "GB",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: location.geo.latitude,
        longitude: location.geo.longitude,
      },
      hasMap: location.mapsUrl,
      servesCuisine: "Italian",
      sameAs: [social.instagram].filter(Boolean),
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
