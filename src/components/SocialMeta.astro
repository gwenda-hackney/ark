---
import { siteConfig } from "../config/site";
import sharePreviewImage from "../assets/images/social/logo-board.png";

interface Props {
  title?: string;
  description?: string;
  url?: string;
}

const { social } = siteConfig;
const title = Astro.props.title ?? social.shareTitle;
const description = Astro.props.description ?? social.shareDescription;
const url = Astro.props.url ?? siteConfig.domain;
const image = new URL(sharePreviewImage.src, url).href;
---

<link rel="canonical" href={url} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(sharePreviewImage.width)} />
<meta property="og:image:height" content={String(sharePreviewImage.height)} />
<meta property="og:image:alt" content={social.imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={social.imageAlt} />
