---
import { getImage } from "astro:assets";
import { heroBackground, heroLogo } from "../lib/hero-assets";

const [hero, logo] = await Promise.all([
  getImage(heroBackground),
  getImage(heroLogo),
]);
---

<link
  rel="preload"
  as="image"
  href={hero.src}
  type="image/webp"
  fetchpriority="high"
/>
<link
  rel="preload"
  as="image"
  href={logo.src}
  type="image/webp"
  fetchpriority="high"
/>
