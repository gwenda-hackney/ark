---
import type { SiteMode } from "../types/features";
import { siteConfig } from "../config/site";
import { getCopy } from "../config/copy";

interface Props {
  mode: SiteMode;
}

const { mode } = Astro.props;
const copy = getCopy(mode);
const hasStoryBody = copy.storyBody.length > 0 || copy.storyClosing;
---

<section class="story section" id="story">
  <div class="container">
    <div class="story-grid story-grid--split">
      <p class="section-eyebrow story-grid-eyebrow reveal">Est. MMXXVI</p>
      <div class="story-grid-left reveal">
        <h2>{siteConfig.copy.storyHeading}</h2>
        <p class="story-lead">{siteConfig.copy.storyLead}</p>
      </div>
      {
        hasStoryBody && (
          <div class="story-grid-right story-body reveal">
            {copy.storyBody.map((paragraph) => <p>{paragraph}</p>)}
            {copy.storyClosing && <p class="story-closing">{copy.storyClosing}</p>}
          </div>
        )
      }
    </div>
  </div>
</section>
