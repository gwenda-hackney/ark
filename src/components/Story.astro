---
import type { SiteMode, SiteFeatures } from "../types/features";
import { siteConfig } from "../config/site";
import { getCopy } from "../config/copy";

interface Props {
  mode: SiteMode;
  features: SiteFeatures;
}

const { mode, features } = Astro.props;
const copy = getCopy(mode);
---

<section class="story section" id="story">
  <div class="container">
    <div class="story-grid">
      <div class="story-intro reveal">
        <p class="section-eyebrow">Est. MMXXVI</p>
        <h2>{siteConfig.copy.storyHeading}</h2>
        <p class="story-lead">{siteConfig.copy.storyLead}</p>
      </div>
      <div class="story-body reveal">
        {copy.storyBody.map((paragraph) => <p>{paragraph}</p>)}
        {copy.storyClosing && <p class="story-closing">{copy.storyClosing}</p>}
      </div>
    </div>

    {
      features.showTeam && (
        <div class="story-team">
          <div class="story-intro reveal">
            <p class="section-eyebrow">The team</p>
            <h2>{siteConfig.copy.teamHeading}</h2>
            <p class="story-lead">{siteConfig.copy.teamLead}</p>
          </div>
          <div class="story-body reveal">
            {siteConfig.copy.teamBody.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      )
    }
  </div>
</section>
