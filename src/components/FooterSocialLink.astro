---
interface Props {
  label: string;
  url: string;
  icon?: "instagram";
}

const { label, url, icon } = Astro.props;
---

{
  url ? (
    <a href={url} target="_blank" rel="noopener noreferrer" aria-label={label}>
      {icon === "instagram" && (
        <svg class="site-footer-social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" style="color:#a85555">
          <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" ry="4.5" fill="none" stroke="currentColor" stroke-width="1.75"></rect>
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
          <circle cx="17.5" cy="6.5" r="1.2"></circle>
        </svg>
      )}
      {label}
    </a>
  ) : (
    <span class="site-footer-social site-footer-social--placeholder" aria-label={`${label} (coming soon)`}>
      {label}
    </span>
  )
}
