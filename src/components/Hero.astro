---
import { Image } from "astro:assets";
import type { SiteMode } from "../types/features";
import { siteConfig } from "../config/site";
import logo from "../assets/images/logos/logo.png";
import heroImg from "../assets/images/hero/hero.png";

interface Props {
  mode?: SiteMode;
}

const { mode = "promo" } = Astro.props;

const openingYear = new Date(siteConfig.openingDate).getFullYear();
const openingTimestamp = new Date(`${siteConfig.openingDate}T00:00:00`).getTime();
const diff = Math.max(0, openingTimestamp - Date.now());
const days = Math.floor(diff / 86400000);
const hours = Math.floor((diff % 86400000) / 3600000);
const minutes = Math.floor((diff % 3600000) / 60000);
---

<section class="hero" id="hero">
  <div class="hero-media">
    <Image
      src={heroImg}
      alt=""
      class="hero-image"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
    <div class="hero-vignette" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    <p class="hero-eyebrow hero-stagger">
      <span class="hero-eyebrow-label">
        <span class="hero-eyebrow-word">{siteConfig.heroSeasonWord}</span>
        <span class="hero-eyebrow-year">{openingYear}</span>
      </span>
    </p>
    <Image src={logo} alt="Gwenda" class="hero-logo hero-stagger" loading="eager" />

    <div
      class="hero-countdown hero-stagger"
      id="countdown"
      data-opening={openingTimestamp}
      aria-live="polite"
    >
      <div class="countdown-unit" data-unit="days">
        <span class="countdown-value" data-value={String(days)}>{days}</span>
        <span class="countdown-label">Days</span>
      </div>
      <span class="countdown-sep" aria-hidden="true">·</span>
      <div class="countdown-unit" data-unit="hours">
        <span class="countdown-value" data-value={String(hours).padStart(2, "0")}
          >{String(hours).padStart(2, "0")}</span
        >
        <span class="countdown-label">Hours</span>
      </div>
      <span class="countdown-sep" aria-hidden="true">·</span>
      <div class="countdown-unit" data-unit="minutes">
        <span class="countdown-value" data-value={String(minutes).padStart(2, "0")}
          >{String(minutes).padStart(2, "0")}</span
        >
        <span class="countdown-label">Min</span>
      </div>
    </div>

    <p class="hero-location hero-stagger">{siteConfig.tagline}</p>
    <a href="#story" class="btn btn-primary hero-stagger">{siteConfig.copy.heroCta}</a>
  </div>

  <a href="#story" class="hero-scroll-hint" aria-label="Scroll to story">
    <span class="hero-scroll-chevron"></span>
  </a>
</section>
