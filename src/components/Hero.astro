---
import { Image } from "astro:assets";
import { siteConfig } from "../config/site";
import { openingTimestamp } from "../config/opening";
import { heroBackground, heroLogo } from "../lib/hero-assets";

const openingMs = openingTimestamp();
const diff = Math.max(0, openingMs - Date.now());
const days = Math.floor(diff / 86400000);
const hours = Math.floor((diff % 86400000) / 3600000);
const minutes = Math.floor((diff % 3600000) / 60000);
---

<section class="hero" id="hero">
  <div class="hero-media">
    <div class="hero-bg" aria-hidden="true"></div>
    <Image
      {...heroBackground}
      alt=""
      class="hero-image"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
    <div class="hero-vignette" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    <h1 class="visually-hidden">{siteConfig.seoTitle}</h1>
    <Image
      {...heroLogo}
      alt="Gwenda"
      class="hero-logo hero-stagger"
      loading="eager"
      fetchpriority="high"
    />

    <div
      class="hero-countdown hero-stagger"
      id="countdown"
      data-opening={openingMs}
      aria-live="polite"
    >
      <div class="countdown-unit" data-unit="days">
        <span class="countdown-value" data-value={String(days)}>{days}</span>
        <span class="countdown-label">Days</span>
      </div>
      <span class="countdown-sep" aria-hidden="true">·</span>
      <div class="countdown-unit" data-unit="hours">
        <span
          class="countdown-value"
          data-value={String(hours).padStart(2, "0")}
          >{String(hours).padStart(2, "0")}</span
        >
        <span class="countdown-label">Hours</span>
      </div>
      <span class="countdown-sep" aria-hidden="true">·</span>
      <div class="countdown-unit" data-unit="minutes">
        <span
          class="countdown-value"
          data-value={String(minutes).padStart(2, "0")}
          >{String(minutes).padStart(2, "0")}</span
        >
        <span class="countdown-label">Min</span>
      </div>
    </div>

    <p class="hero-location hero-stagger">{siteConfig.tagline}</p>
    <a href="#story" class="btn btn-primary hero-stagger" id="hero-cta"
      >{siteConfig.copy.heroCta}</a
    >
  </div>

  <a href="#story" class="hero-scroll-hint" aria-label="Scroll to story">
    <span class="hero-scroll-chevron"></span>
  </a>
</section>

<noscript>
  <style>
    .hero-image,
    .hero-overlay,
    .hero-vignette {
      opacity: 1 !important;
    }
  </style>
</noscript>

<script>
  import { initHeroReveal } from "../scripts/hero-reveal.js";
  initHeroReveal();
</script>
