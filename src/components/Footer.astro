---
import { Image } from "astro:assets";
import type { SiteMode, SiteFeatures } from "../types/features";
import { siteConfig } from "../config/site";
import { getCopy } from "../config/copy";
import logo from "../assets/images/logos/logo.png";

interface Props {
  mode: SiteMode;
  features: SiteFeatures;
}

const { mode, features } = Astro.props;
const { social, location } = siteConfig;
const copy = getCopy(mode);

const openingFormatted = new Date(siteConfig.openingDate).toLocaleDateString(
  "en-GB",
  { day: "numeric", month: "long", year: "numeric" },
);

const address = features.useShortAddress
  ? location.addressShort
  : location.address;

const isPromoFooter = mode === "promo";
---

{
  isPromoFooter ? (
    <footer class="site-footer site-footer--promo">
      <div class="container site-footer-promo">
        <div class="site-footer-promo-block">
          <p class="site-footer-promo-primary">
            <a href="#hero" class="site-footer-logo" aria-label="Gwenda — back to top">
              <Image
                src={logo}
                alt=""
                class="site-footer-logo-img"
                widths={[160, 240, 320]}
                sizes="160px"
                height={100}
                width={160}
              />
            </a>
            <span class="site-footer-promo-sep" aria-hidden="true">·</span>
            <span class="site-footer-promo-details">
              <a
                href={location.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {location.area}
              </a>
              <span class="site-footer-promo-sep" aria-hidden="true">·</span>
              <span>{copy.footerOpening}</span>
            </span>
          </p>
          <p class="site-footer-promo-meta">
            <a href="/privacy">Privacy</a>
            <span class="site-footer-promo-sep" aria-hidden="true">·</span>
            <span>© {new Date().getFullYear()} {siteConfig.name}</span>
          </p>
        </div>
      </div>
    </footer>
  ) : (
    <footer class="site-footer">
      <div class="container site-footer-inner">
        <div class="site-footer-brand">
          <p class="site-footer-brand-head">
            <a href="#hero" class="site-footer-logo" aria-label="Gwenda — back to top">
              <Image
                src={logo}
                alt=""
                class="site-footer-logo-img"
                widths={[140, 200, 280]}
                sizes="140px"
                height={88}
                width={140}
              />
            </a>
            <span class="site-footer-location">{location.area}</span>
          </p>
          <a
            href={location.mapsUrl}
            class="site-footer-address"
            target="_blank"
            rel="noopener noreferrer"
          >
            {address}
          </a>
          {
            features.showOpeningDate ? (
              <p class="site-footer-opening">Opens {openingFormatted}</p>
            ) : (
              <p class="site-footer-opening">{copy.footerOpening}</p>
            )
          }
        </div>

        <div class="site-footer-links">
          {
            features.showSocial && (
              <>
                <a
                  href={social.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                >
                  Instagram
                </a>
                <a
                  href={social.tiktok}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="TikTok"
                >
                  TikTok
                </a>
              </>
            )
          }
          <a href="#hero">Top</a>
          <a href="/privacy">Privacy</a>
        </div>
      </div>

      <p class="site-footer-legal">
        © {new Date().getFullYear()} {siteConfig.name}
      </p>
    </footer>
  )
}
