---
import type { SiteMode } from "../types/features";
import { siteConfig } from "../config/site";
import { getCopy } from "../config/copy";

interface Props {
  mode: SiteMode;
}

const { mode } = Astro.props;
const copy = getCopy(mode);
---

<section class="signup section" id="list">
  <div class="container signup-inner">
    <header class="section-header reveal">
      <p class="section-eyebrow">{copy.signupEyebrow}</p>
      <h2>{copy.signupHeading}</h2>
      <p>{copy.signupSubheading}</p>
    </header>

    <form class="signup-form reveal" id="signup-form" novalidate>
      <div class="signup-field">
        <label for="email" class="visually-hidden">Email address</label>
        <input
          type="email"
          name="email"
          id="email"
          placeholder="your@email.com"
          required
          autocomplete="email"
          inputmode="email"
          spellcheck="false"
        />
        <button type="submit" class="btn btn-primary">
          {siteConfig.copy.signupButton}
        </button>
      </div>

      <label class="signup-consent">
        <input type="checkbox" name="consent" id="consent" required />
        <span>{siteConfig.copy.signupConsent}</span>
      </label>

      <input type="hidden" name="tag" value="prelaunch" />

      <p class="signup-error" id="signup-error" hidden></p>
      <p class="signup-message" id="signup-message" hidden>
        {siteConfig.copy.signupSuccess}
      </p>
    </form>
  </div>
</section>
