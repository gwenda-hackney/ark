---
import { siteConfig } from "../config/site";
---

<section class="story-team section" id="team">
  <div class="container">
    <p class="section-eyebrow reveal">The team</p>
    <h2 class="reveal">{siteConfig.copy.teamHeading}</h2>
    <p class="story-lead reveal">{siteConfig.copy.teamLead}</p>
    <div class="story-body reveal">
      {siteConfig.copy.teamBody.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="join-cta-footer reveal">
      <a href="#list" class="btn btn-primary">{siteConfig.copy.joinExperienceCta}</a>
    </p>
  </div>
</section>
