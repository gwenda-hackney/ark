---
import "../styles/global.css";
import { Image } from "astro:assets";
import Fonts from "../components/Fonts.astro";
import StagingRibbon from "../components/StagingRibbon.astro";
import { siteConfig } from "../config/site";
import { compactLogo } from "../lib/hero-assets";
import favicon from "../assets/images/logos/favicon-light.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>You're on the list — {siteConfig.name}</title>
    <Fonts />
    <link rel="icon" type="image/png" href={favicon.src} />
  </head>
  <body class="thanks-page">
    <StagingRibbon />
    <div class="grain" aria-hidden="true"></div>
    <main class="thanks">
      <Image {...compactLogo} alt="Gwenda" class="thanks-logo" loading="eager" />
      <p class="thanks-eyebrow">Thank you</p>
      <h1 class="thanks-title">{siteConfig.copy.signupSuccessTitle}</h1>
      <p class="thanks-lead">{siteConfig.copy.signupSuccessLead}</p>
      <a href="/#hero" class="btn btn-primary thanks-back"
        >{siteConfig.copy.signupSuccessBack}</a
      >
    </main>
  </body>
</html>
