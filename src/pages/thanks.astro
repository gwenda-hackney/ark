---
import "../styles/global.css";
import { Image } from "astro:assets";
import StagingRibbon from "../components/StagingRibbon.astro";
import { siteConfig } from "../config/site";
import logo from "../assets/images/logos/logo.png";
import favicon from "../assets/images/logos/favicon-dark.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>You're on the list — {siteConfig.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href={favicon.src} />
  </head>
  <body class="thanks-page">
    <StagingRibbon />
    <div class="grain" aria-hidden="true"></div>
    <main class="thanks">
      <Image src={logo} alt="Gwenda" class="thanks-logo" loading="eager" />
      <p class="thanks-eyebrow">Thank you</p>
      <h1 class="thanks-title">{siteConfig.copy.signupSuccessTitle}</h1>
      <p class="thanks-lead">{siteConfig.copy.signupSuccessLead}</p>
      <a href="/#hero" class="btn btn-primary thanks-back">{siteConfig.copy.signupSuccessBack}</a>
    </main>
  </body>
</html>
