{
  "name": "@gwenda/studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sanity Studio for Gwenda content",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs ../../node_modules/.bin/sanity dev --host 0.0.0.0",
    "build": "node ../../scripts/with-env.mjs ../../node_modules/.bin/sanity build",
    "deploy": "node ../../scripts/with-env.mjs ../../node_modules/.bin/sanity deploy",
    "start": "node ../../scripts/with-env.mjs ../../node_modules/.bin/sanity start"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/orderable-document-list": "^2.0.13",
    "@sanity/vision": "^6.4.0",
    "lexorank": "^1.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.4.0",
    "styled-components": "^6.3.11"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  }
}
