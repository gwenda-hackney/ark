---
import { siteConfig } from "../config/site";
import MenuTeaseCocktails from "./MenuTeaseCocktails.astro";
import DissolveReveal from "./DissolveReveal.astro";
import { fetchMenuTeaseCocktails } from "../lib/sanity/menu";
import type { MenuTeaseCocktail } from "../data/menu-tease";

interface Props {
  /** When false, keep the section but hide cocktail images (coming soon). */
  showCocktailImages?: boolean;
  /** Stand-in photos for a local look. Homepage leaves this unset and reads Sanity. */
  cocktails?: MenuTeaseCocktail[];
}

const { showCocktailImages = true, cocktails: cocktailsOverride } = Astro.props;
const cocktails =
  cocktailsOverride ??
  (showCocktailImages ? await fetchMenuTeaseCocktails() : []);
---

<section class="menu-tease section" id="menu">
  <div class="container">
    <header class="section-intro menu-tease-header reveal">
      <p class="section-eyebrow dissolve-reveal-eyebrow">
        The&nbsp;
        <DissolveReveal
          id="menu-word"
          antiquated={siteConfig.menuAntiquated}
          modern="Menu"
        />
      </p>
      <h2>{siteConfig.copy.menuTeaseHeading}</h2>
      <p class="section-lead">
        {siteConfig.copy.menuTeaseLead} The food menu launches soon. Come back
        for updates, <a href="/join-list">join the list</a>, or follow on <a
          href={siteConfig.social.instagram}
          target="_blank"
          rel="noreferrer">Instagram</a>.
      </p>
    </header>
  </div>

  {
    cocktails.length > 0 ? (
      <div class="container menu-tease-gallery-wrap">
        <MenuTeaseCocktails cocktails={cocktails} />
      </div>
    ) : (
      <div class="container menu-tease-gallery-wrap">
        <p class="menu-tease-empty reveal">{siteConfig.copy.menuTeaseComingSoon}</p>
      </div>
    )
  }

  <div class="container">
    <footer class="menu-tease-footer reveal">
      <a href="/menu" class="btn btn-ghost">View the full menu</a>
    </footer>
  </div>
</section>
