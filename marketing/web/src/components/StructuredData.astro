---
import { siteConfig } from "../config/site";
import { bookingUrl } from "../config/booking";

interface Props {
  url: string;
  title: string;
  description: string;
}

const { url, title, description } = Astro.props;
const { location, social, name, domain, contact, brand, seoTopics } = siteConfig;
const logoUrl = new URL(brand.organizationLogoPath, domain).href;
const menuUrl = new URL("/menu/", domain).href;
const eventsUrl = new URL("/whats-on/", domain).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${domain}/#organization`,
      name,
      url: domain,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
        width: brand.organizationLogoWidth,
        height: brand.organizationLogoHeight,
      },
      sameAs: [social.instagram].filter(Boolean),
    },
    {
      "@type": "WebSite",
      "@id": `${domain}/#website`,
      url: domain,
      name,
      description: siteConfig.description,
      publisher: { "@id": `${domain}/#organization` },
      inLanguage: "en-GB",
      hasPart: [
        {
          "@type": "WebPage",
          name: siteConfig.seo.whatsOn.title,
          url: eventsUrl,
          description: siteConfig.seo.whatsOn.description,
        },
        {
          "@type": "WebPage",
          name: siteConfig.seo.menu.title,
          url: menuUrl,
          description: siteConfig.seo.menu.description,
        },
      ],
    },
    {
      "@type": "ItemList",
      "@id": `${domain}/#navigation`,
      name: "Main navigation",
      itemListElement: [
        {
          "@type": "SiteNavigationElement",
          position: 1,
          name: "Behind the doors",
          url: `${domain}/#story`,
        },
        {
          "@type": "SiteNavigationElement",
          position: 2,
          name: "Menu",
          url: menuUrl,
        },
        {
          "@type": "SiteNavigationElement",
          position: 3,
          name: "What's on",
          url: eventsUrl,
        },
        {
          "@type": "SiteNavigationElement",
          position: 4,
          name: "Featured artist",
          url: new URL("/artists/current/", domain).href,
        },
        {
          "@type": "SiteNavigationElement",
          position: 5,
          name: "Contact",
          url: new URL("/contact/", domain).href,
        },
        {
          "@type": "SiteNavigationElement",
          position: 6,
          name: siteConfig.copy.signupNavCta,
          url: `${domain}/#list`,
        },
      ],
    },
    {
      "@type": "WebPage",
      "@id": `${url}#webpage`,
      url,
      name: title,
      description,
      isPartOf: { "@id": `${domain}/#website` },
      about: { "@id": `${domain}/#business` },
      inLanguage: "en-GB",
    },
    {
      "@type": "BarOrPub",
      "@id": `${domain}/#business`,
      name,
      description: siteConfig.description,
      url: domain,
      image: logoUrl,
      email: contact.email,
      parentOrganization: { "@id": `${domain}/#organization` },
      address: {
        "@type": "PostalAddress",
        streetAddress: location.streetAddress,
        addressLocality: location.addressLocality,
        addressRegion: location.addressRegion,
        postalCode: location.postalCode,
        addressCountry: "GB",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: location.geo.latitude,
        longitude: location.geo.longitude,
      },
      hasMap: location.mapsUrl,
      servesCuisine: ["Italian", "Cocktails"],
      knowsAbout: seoTopics,
      acceptsReservations: bookingUrl,
      hasMenu: menuUrl,
      potentialAction: {
        "@type": "ReserveAction",
        name: siteConfig.copy.bookingCta,
        target: {
          "@type": "EntryPoint",
          urlTemplate: bookingUrl,
          actionPlatform: [
            "http://schema.org/DesktopWebPlatform",
            "http://schema.org/MobileWebPlatform",
          ],
        },
        result: {
          "@type": "Reservation",
          name: siteConfig.copy.bookingCta,
        },
      },
      sameAs: [social.instagram].filter(Boolean),
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
