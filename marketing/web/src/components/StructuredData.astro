---
import { siteConfig } from "../config/site";
import { bookingUrl } from "../config/booking";
import { openingHoursSpecification } from "../lib/opening-hours.js";
import { siteNavigation } from "../lib/structured-data.js";
import { fetchOpeningHours } from "../lib/sanity/opening-hours";

interface Props {
  url: string;
  title: string;
  description: string;
}

const { url, title, description } = Astro.props;
const { location, social, name, domain, contact, brand, seoTopics } =
  siteConfig;
const logoUrl = new URL(brand.organizationLogoPath, domain).href;
const menuUrl = new URL("/bar/", domain).href;
const eventsUrl = new URL("/whats-on/", domain).href;
const bookingsUrl = new URL("/bookings/", domain).href;
/** From ops (Venue details); left out when there are none. */
const hours = openingHoursSpecification(await fetchOpeningHours());

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${domain}/#organization`,
      name,
      url: domain,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
        width: brand.organizationLogoWidth,
        height: brand.organizationLogoHeight,
      },
      sameAs: [social.instagram].filter(Boolean),
    },
    {
      "@type": "WebSite",
      "@id": `${domain}/#website`,
      url: domain,
      name,
      description: siteConfig.description,
      publisher: { "@id": `${domain}/#organization` },
      inLanguage: "en-GB",
      hasPart: [
        {
          "@type": "WebPage",
          name: siteConfig.seo.whatsOn.title,
          url: eventsUrl,
          description: siteConfig.seo.whatsOn.description,
        },
        {
          "@type": "WebPage",
          name: siteConfig.seo.menu.title,
          url: menuUrl,
          description: siteConfig.seo.menu.description,
        },
        {
          "@type": "WebPage",
          name: siteConfig.seo.bookings.title,
          url: bookingsUrl,
          description: siteConfig.seo.bookings.description,
        },
      ],
    },
    siteNavigation(domain),
    {
      "@type": "WebPage",
      "@id": `${url}#webpage`,
      url,
      name: title,
      description,
      isPartOf: { "@id": `${domain}/#website` },
      about: { "@id": `${domain}/#business` },
      inLanguage: "en-GB",
    },
    {
      "@type": "BarOrPub",
      "@id": `${domain}/#business`,
      name,
      description: siteConfig.description,
      url: domain,
      image: logoUrl,
      email: contact.email,
      telephone: contact.telephone,
      ...(hours.length ? { openingHoursSpecification: hours } : {}),
      parentOrganization: { "@id": `${domain}/#organization` },
      address: {
        "@type": "PostalAddress",
        streetAddress: location.streetAddress,
        addressLocality: location.addressLocality,
        addressRegion: location.addressRegion,
        postalCode: location.postalCode,
        addressCountry: "GB",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: location.geo.latitude,
        longitude: location.geo.longitude,
      },
      hasMap: location.mapsUrl,
      servesCuisine: ["Burgers", "Cocktails"],
      knowsAbout: seoTopics,
      acceptsReservations: bookingUrl,
      hasMenu: menuUrl,
      potentialAction: {
        "@type": "ReserveAction",
        name: siteConfig.copy.bookingCta,
        target: {
          "@type": "EntryPoint",
          urlTemplate: bookingUrl,
          actionPlatform: [
            "http://schema.org/DesktopWebPlatform",
            "http://schema.org/MobileWebPlatform",
          ],
        },
        result: {
          "@type": "Reservation",
          name: siteConfig.copy.bookingCta,
        },
      },
      sameAs: [social.instagram].filter(Boolean),
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
