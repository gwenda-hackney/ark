---
import type { SiteMode, SiteFeatures } from "../types/features";
import { siteConfig } from "../config/site";
import { bookingUrl } from "../config/booking";
import { fetchSiteSettings } from "../lib/sanity/site-settings";
import FooterSocialLink from "./FooterSocialLink.astro";

interface Props {
  mode: SiteMode;
  features: SiteFeatures;
}

const { features } = Astro.props;
const { social, location } = siteConfig;
const year = new Date().getFullYear();
const { bookingEnabled } = await fetchSiteSettings();

const address = features.useShortAddress
  ? location.addressShort
  : location.address;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer-grid">
      <div class="site-footer-col">
        <p class="site-footer-col-label">Explore</p>
        <ul class="site-footer-list">
          <li><a href="#hero">Arrival</a></li>
          <li><a href="#story">Story</a></li>
          <li><a href="/menu">Menu</a></li>
          <li><a href="#what-we-do">What we do</a></li>
          {
            features.showTeam && (
              <li>
                <a href="#team">Who we are</a>
              </li>
            )
          }
          {
            features.showGallery && (
              <li>
                <a href="#glimpse">Glimpse</a>
              </li>
            )
          }
          <li><a href="/whats-on">What's on</a></li>
          <li><a href="/artists/current">Featured artist</a></li>
          {
            bookingEnabled && (
              <li>
                <a
                  href={bookingUrl}
                  class="booking-cta"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {siteConfig.copy.bookingCta}
                </a>
              </li>
            )
          }
          <li><a href="#list">{siteConfig.copy.signupNavCta}</a></li>
        </ul>
      </div>

      <div class="site-footer-col">
        <p class="site-footer-col-label">Connect</p>
        <ul class="site-footer-list">
          <li>
            <a
              href={location.mapsUrl}
              class="site-footer-address"
              target="_blank"
              rel="noopener noreferrer"
            >
              {address}
            </a>
          </li>
          {
            features.showSocial && (
              <>
                <li>
                  <FooterSocialLink label="Instagram" url={social.instagram} />
                </li>
                {social.tiktok && (
                  <li>
                    <FooterSocialLink label="TikTok" url={social.tiktok} />
                  </li>
                )}
              </>
            )
          }
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer-meta">
      <p class="site-footer-copyright">
        <span>© {year}</span>
        <span>{siteConfig.name}</span>
      </p>
    </div>
  </div>
</footer>
