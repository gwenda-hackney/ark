---
/**
 * Home's Bookings (#240), IV in the navigation: the section's heading and
 * note, an occasion on sale across both halves when there is one
 * (HomeOccasions, such as Christmas parties), then the two halves, a party and playing here (BookingHalves, the
 * same as on /bookings). Home's own links to Bookings come down here; from
 * every other page Bookings goes to its page. Like every section on home it
 * links on to its page: "More →" by the heading, as Photos does, since the
 * halves have their own buttons.
 */
import { bookingsWords } from "../../lib/bookings.js";
import BookingHalves from "./BookingHalves.astro";
import HomeOccasions from "./HomeOccasions.astro";

const words = bookingsWords();
---

<section
  class="ch-home-section ch-home-bookings"
  id="bookings"
  aria-labelledby="home-bookings"
>
  <header class="ch-home-head">
    <h2 class="ch-poster" id="home-bookings">{words.heading}</h2>
    <div class="ch-home-head-end">
      <p class="ch-home-head-note">{words.note}</p>
      <a
        href="/bookings"
        class="ch-photos-more-link"
        aria-label="More on bookings"
      >
        More <span aria-hidden="true">→</span>
      </a>
    </div>
  </header>

  <BookingHalves>
    <HomeOccasions slot="first" />
  </BookingHalves>
</section>
