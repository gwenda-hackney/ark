---
/**
 * Home's Bookings (#240), IV in the navigation: the section's heading and
 * note, then the two halves, a party and playing here (BookingHalves, the
 * same as on /bookings). Home's own links to Bookings come down here; from
 * every other page Bookings goes to its page.
 */
import { siteConfig } from "../../config/site";
import BookingHalves from "./BookingHalves.astro";

const words = siteConfig.copy.bookings;
---

<section
  class="ch-home-section ch-home-bookings"
  id="bookings"
  aria-labelledby="home-bookings"
>
  <header class="ch-home-head">
    <h2 class="ch-poster" id="home-bookings">{words.heading}</h2>
    <p class="ch-home-head-note">{words.note}</p>
  </header>

  <BookingHalves />
</section>
