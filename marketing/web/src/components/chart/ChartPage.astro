---
/**
 * A section page (#240): the menu behind the corner button, a header (the
 * title, a line), the page, the footer.
 */
import "../../styles/chart.css";
import ChartNav from "./ChartNav.astro";
import ChartFooter from "./ChartFooter.astro";
import { chartSections } from "../../lib/chart-nav";

interface Props {
  title: string;
  lead?: string;
  class?: string;
}

const { title, lead, class: className } = Astro.props;
/** The ring beside the title: this page's number in the menu, when it has one. */
const numeral = chartSections(Astro.url.pathname).find(
  (item) => item.current,
)?.numeral;
---

<div class="ch-page" data-chart="closed">
  <ChartNav />
  <main class:list={["ch-main", className]}>
    <header class="ch-page-head">
      {numeral && <span class="ch-ring ch-ring--title">{numeral}</span>}
      <div>
        <h1 class="ch-title">{title}</h1>
        {lead && <p class="ch-lead ch-ital">{lead}</p>}
        <slot name="head" />
      </div>
    </header>
    <slot />
  </main>
  <ChartFooter />
</div>
