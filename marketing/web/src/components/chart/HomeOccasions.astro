---
/**
 * Occasions on home (#353), the first row of Bookings across both halves: a card for each occasion whose
 * show days include today (ops: What's on → Occasions), such as Christmas
 * parties. Its picture, a "Booking now" tag, its name, when it's for, its
 * line, what's included, and Make an enquiry, which opens the party form
 * marked with it. The page is built ahead of time, so every occasion not yet
 * over is in it, and the browser shows the ones on today
 * (scripts/occasion-cards.js); with none on, the section isn't there.
 * It also pops up the first time it's seen, a sheet on a phone and a window
 * on a wider screen (initOccasionSheet); closed, the card is still here.
 */
import "../../styles/chart-nights.css";
import {
  imageSrcset,
  sizedImageUrl,
} from "../../../functions/_lib/sanity-image-url.js";
import { londonToday } from "../../lib/london-day.js";
import { formPublicPath, PARTY_FORM_SLUG } from "../../lib/form-paths";
import {
  occasionEnquiryHref,
  occasionShowing,
  occasionsToCome,
} from "../../lib/occasions.js";
import { fetchOccasions } from "../../lib/sanity/occasions";

const today = londonToday();
const occasions = occasionsToCome(await fetchOccasions(), today);
const partyForm = formPublicPath(PARTY_FORM_SLUG);
---

{
  occasions.length > 0 && (
    <div
      class="ch-home-occasions"
      id="occasions"
      data-occasion-cards
      hidden={!occasions.some((occasion) => occasionShowing(occasion, today))}
    >
      {occasions.map((occasion) => (
        <article
          class="ch-occasion"
          data-occasion-from={occasion.showFrom}
          data-occasion-until={occasion.showUntil}
          hidden={!occasionShowing(occasion, today)}
        >
          {occasion.image && (
            <span class="ch-occasion-photo">
              <img
                src={sizedImageUrl(occasion.image.url, 720)}
                srcset={imageSrcset(occasion.image.url) || undefined}
                sizes="(max-width: 48rem) 92vw, 50vw"
                alt={occasion.image.alt}
                width={occasion.image.width || undefined}
                height={occasion.image.height || undefined}
                loading="lazy"
              />
            </span>
          )}
          <div class="ch-occasion-body">
            <span class="ch-occasion-tag">Booking now</span>
            <h3 class="ch-poster ch-occasion-name">{occasion.name}</h3>
            {occasion.covers && (
              <p class="ch-occasion-covers">{occasion.covers}</p>
            )}
            {occasion.line && <p class="ch-occasion-line">{occasion.line}</p>}
            {occasion.included.length > 0 && (
              <ul class="ch-occasion-included">
                {occasion.included.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            <a
              href={occasionEnquiryHref(occasion.name, partyForm)}
              class="ch-btn ch-btn--solid ch-occasion-cta"
            >
              Make an enquiry
            </a>
          </div>
        </article>
      ))}
    </div>
  )
}

{
  occasions.length > 0 && (
    <>
      {/* scripts/occasion-cards.js initOccasionSheet: the occasion pops up the first
          time (a sheet on a phone, a window wider); closed, it stays in the page. */}
      <dialog class="ch-occasion-sheet" data-occasion-sheet aria-label="Booking now" tabindex="-1">
        <span class="ch-occasion-sheet-grip" aria-hidden="true" />
        <button type="button" class="ch-occasion-sheet-close" data-sheet-close aria-label="Close">×</button>
        <div data-sheet-body />
      </dialog>
    </>
  )
}

<script>
  import { initOccasionCards, initOccasionSheet } from "../../scripts/occasion-cards.js";
  initOccasionCards();
  initOccasionSheet();
  document.addEventListener("astro:page-load", () => {
    initOccasionCards();
    initOccasionSheet();
  });
</script>
