---
/** The foot of every page in The Chart (#240): where we are, when we're open, the few links. */
import { siteConfig } from "../../config/site";
import { fetchOpeningHours } from "../../lib/sanity/opening-hours";
import OpeningHours from "./OpeningHours.astro";

const { social, location } = siteConfig;
const year = new Date().getFullYear();
const week = await fetchOpeningHours();
---

<footer class="ch-footer">
  <div class="ch-rule ch-rule--dash"></div>
  <div class="ch-footer-row">
    <a
      href={location.mapsUrl}
      class="ch-caps"
      target="_blank"
      rel="noopener noreferrer">{location.address}</a
    >
    <nav class="ch-footer-links" aria-label="Footer">
      <a href={social.instagram} target="_blank" rel="noopener noreferrer"
        >Instagram</a
      >
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/join-list">{siteConfig.copy.signupHeading}</a>
      <a href="/privacy">Privacy</a>
    </nav>
    <span class="ch-caps"
      >© {year} {siteConfig.name} {siteConfig.copy.social}</span
    >
  </div>
  <OpeningHours week={week} variant="line" />
</footer>
