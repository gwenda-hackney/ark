---
/**
 * The way to the bar, drawn like the chart in the brief (#240): the water
 * as a wide dark band with soundings, the station and
 * the walk down from it, a few roads lightly, Gwenda marked with an X.
 * Loosely from the street map; not to scale.
 */
import { siteConfig } from "../../config/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { location } = siteConfig;

/** The two waters, as centre lines; the band and both edges follow them. */
const LEE = "M662 -20 C682 150 702 300 744 420 S832 640 864 780 L905 940";
const UNION = "M-20 930 C180 820 400 700 560 600 S690 506 736 466";

/** Soundings in the water: [x, y, depth] */
const SOUNDINGS = [
  [650, 90, "3"],
  [690, 230, "2½"],
  [728, 360, "4"],
  [800, 520, "3"],
  [838, 680, "2"],
  [872, 830, "3"],
  [150, 850, "2"],
  [300, 760, "1½"],
  [440, 672, "2"],
  [600, 568, "3"],
];
---

<figure class:list={["ch-map", className]}>
  <svg
    viewBox="0 0 1000 920"
    role="img"
    aria-labelledby="ch-map-title"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <title id="ch-map-title">
      Map: Gwenda on the Hertford Union canal where it meets the Lee, a few
      minutes' walk south of Hackney Wick station.
    </title>
    <defs>
      <filter id="ch-map-ink" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.028"
          numOctaves="2"
          seed="4"
          result="n"></feTurbulence>
        <feDisplacementMap
          in="SourceGraphic"
          in2="n"
          scale="6"
          xChannelSelector="R"
          yChannelSelector="G"></feDisplacementMap>
      </filter>
    </defs>

    <g filter="url(#ch-map-ink)">
      <!-- The water: a wide band, an edge each side, soundings, the banks hatched -->
      <g class="ch-map-water">
        <path class="ch-map-band" d={LEE}></path>
        <path class="ch-map-band ch-map-band--union" d={UNION}></path>
        <path class="ch-map-edge" d={LEE} transform="translate(-30 0)"></path>
        <path class="ch-map-edge" d={LEE} transform="translate(30 0)"></path>
        <path class="ch-map-edge" d={UNION} transform="translate(0 -24)"></path>
        <path class="ch-map-edge" d={UNION} transform="translate(0 24)"></path>
      </g>

      <!-- The railway and the station -->
      <g class="ch-map-rail">
        <path d="M-10 160 L612 130"></path>
        {
          Array.from({ length: 24 }, (_, i) => {
            const x = 14 + i * 25;
            const y = 159 - i * 1.2;
            return <path d={`M${x} ${y - 6} l -1 12`} />;
          })
        }
      </g>

      <!-- Roads: a few, lightly -->
      <g class="ch-map-roads">
        <path
          d="M-10 268 C60 240 130 214 196 196 C260 230 330 246 420 244 S640 258 1010 274"
        ></path>
        <path
          d="M30 460 C140 420 260 384 400 352 S520 340 540 338 L546 450 C566 470 584 488 600 506"
        ></path>
        <path d="M20 612 C120 572 240 520 380 470"></path>
      </g>

      <!-- The walk from the station -->
      <path
        class="ch-map-walk"
        d="M372 150 C384 190 400 220 418 248 C450 290 500 320 540 340 L546 448 C566 470 584 488 600 506"
      ></path>

      <!-- Gwenda -->
      <path class="ch-map-here" d="M586 492 l28 28 M614 492 l-28 28"></path>
    </g>

    <!-- Words stay crisp -->
    <g class="ch-map-labels">
      {
        SOUNDINGS.map(([x, y, d]) => (
          <text class="ch-map-sound" x={x} y={y}>
            {d}
          </text>
        ))
      }
      <circle cx="372" cy="140" r="11" class="ch-map-station"></circle>
      <text x="390" y="112">Hackney Wick</text>
      <text x="390" y="130" class="ch-map-small">station</text>

      <text class="ch-map-water-label" transform="translate(770 560) rotate(68)"
        >Lee Navigation</text
      >
      <text
        class="ch-map-water-label"
        transform="translate(140 846) rotate(-33)">Hertford Union</text
      >

      <text class="ch-map-road" transform="translate(240 410) rotate(-15)"
        >Rothbury Rd</text
      >
      <text class="ch-map-road" transform="translate(120 575) rotate(-22)"
        >Trego Rd</text
      >

      <text x="628" y="542" class="ch-map-name">Gwenda</text>
      <text class="ch-map-note" transform="translate(470 470) rotate(-8)"
        >you are here</text
      >
      <path class="ch-map-note-line" d="M560 466 c 10 10 18 18 26 28"></path>

      <!-- The compass rose -->
      <g class="ch-map-rose" transform="translate(915 70)">
        <circle r="34"></circle>
        <circle r="4"></circle>
        <path d="M0 -42v8M0 34v8M-42 0h8M34 0h8"></path>
        <path d="M0 -30 l7 22 L0 30 l-7 -22 z"></path>
        <path d="M0 -30 l7 22 h-14 z" fill="currentColor"></path>
        <path d="M-30 0 l22 -7 L30 0 l-22 7 z"></path>
      </g>
    </g>
  </svg>
  <figcaption>
    <a href={location.mapsUrl} target="_blank" rel="noopener noreferrer"
      >{location.address}</a
    >
  </figcaption>
</figure>
