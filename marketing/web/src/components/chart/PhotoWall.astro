---
/**
 * A wall of photos (#240): each at its own shape, in columns; a tapped one
 * opens large with arrows, swipe and Escape. The markup is the event
 * gallery's (#30, renderGallery in lib/event-card.js), so the same
 * scripts/gallery.js lays it out and opens the photos. The photos are the
 * venue's Gallery in ops, on Sanity's CDN (lib/photo-sources.ts), sized as
 * an event gallery's are (functions/_lib/sanity-image-url.js).
 */
import "../../styles/chart-photos.css";
import {
  IMAGE_LARGEST,
  imageSrcset,
  sizedImageUrl,
} from "../../../functions/_lib/sanity-image-url.js";
import type { GalleryPhoto } from "../../lib/photo-sources";

interface Props {
  photos: GalleryPhoto[];
  /**
   * Home's few, in even rows of squares, each photo cropped to its tile:
   * laid out by the page's CSS (chart-photos.css), not in columns.
   */
  row?: boolean;
}

const { photos, row = false } = Astro.props;

/**
 * Three columns of a 72rem page (about 365px each), or two when three would
 * end uneven (about 560px each, as on home), two on a phone. "auto" sizes
 * each photo from the tile it is laid out in (they are all lazy), so a
 * two-column wall gets a sharper file than a three-column one. Browsers
 * without it read the rest: the three-column widths.
 */
const SIZES = "auto, (max-width: 600px) 50vw, (max-width: 1280px) 31vw, 380px";
/**
 * In home's rows a tile is a square about 280px a side on a desk, a third of
 * a tablet, half a phone; a landscape photo cropped to a square is wider than
 * its tile, so this is the cropped photo's width, not the tile's.
 */
const ROW_SIZES = "(max-width: 640px) 60vw, (max-width: 1024px) 40vw, 380px";
/** The first few show their blurred copy while they load; the rest their main colour. */
const BLURRED = 12;

const tiles = photos.map((photo, index) => ({
  photo,
  src: sizedImageUrl(photo.url, 640),
  srcset: imageSrcset(photo.url),
  full: sizedImageUrl(photo.url, IMAGE_LARGEST),
  style: [
    `--ratio: ${photo.ratio}`,
    photo.color && `--photo-color: ${photo.color}`,
    index < BLURRED && photo.lqip && `--lqip: url("${photo.lqip}")`,
  ]
    .filter(Boolean)
    .join("; "),
}));
---

<div class:list={["series-gallery", row && "ch-photo-row"]}>
  <ul class="series-gallery-list" data-gallery-row={row || undefined}>
    {
      tiles.map(({ photo, src, srcset, full, style }) => (
        <li class="series-gallery-item" style={style}>
          <a href={full} data-full={full} target="_blank" rel="noopener">
            <img
              src={src}
              srcset={srcset || undefined}
              sizes={srcset ? (row ? ROW_SIZES : SIZES) : undefined}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>
