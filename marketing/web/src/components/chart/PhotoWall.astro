---
/**
 * A wall of photos (#240): each at its own shape, in columns; a tapped one
 * opens large with arrows, swipe and Escape. The markup is the event
 * gallery's (#30, renderGallery in lib/event-card.js), so the same
 * scripts/gallery.js lays it out and opens the photos.
 */
import { getImage } from "astro:assets";
import "../../styles/chart-photos.css";
import type { GalleryPhoto } from "../../lib/photo-sources";

interface Props {
  photos: GalleryPhoto[];
  /**
   * Home's few, in even rows of squares, each photo cropped to its tile:
   * laid out by the page's CSS (chart-photos.css), not in columns.
   */
  row?: boolean;
}

const { photos, row = false } = Astro.props;

/**
 * Three columns of a 72rem page (about 365px each), or two when three would
 * end uneven (about 560px each, as on home), two on a phone; at up to 2x.
 * Never above the file's own size.
 */
const THUMB_WIDTHS = [240, 400, 600, 800];
const THUMB_MAX = 1000;
/**
 * "auto" sizes each photo from the tile it is laid out in (they are all
 * lazy), so a two-column wall gets a sharper file than a three-column one.
 * Browsers without it read the rest: the three-column widths.
 */
const SIZES = "auto, (max-width: 600px) 50vw, (max-width: 1280px) 31vw, 380px";
/**
 * In home's rows a tile is a square about 280px a side on a desk, a third of
 * a tablet, half a phone; a landscape photo cropped to a square is wider than
 * its tile, so this is the cropped photo's width, not the tile's.
 */
const ROW_SIZES = "(max-width: 640px) 60vw, (max-width: 1024px) 40vw, 380px";
const FULL_WIDTH = 1800;

const tiles = await Promise.all(
  photos.map(async (photo) => {
    const widths = THUMB_WIDTHS.filter((width) => width < photo.image.width);
    const thumb = await getImage({
      src: photo.image,
      widths: [...widths, Math.min(photo.image.width, THUMB_MAX)],
      format: "webp",
      quality: 72,
    });
    const full = await getImage({
      src: photo.image,
      width: Math.min(photo.image.width, FULL_WIDTH),
      format: "webp",
      quality: 80,
    });
    return { photo, thumb, full };
  }),
);
---

<div class:list={["series-gallery", row && "ch-photo-row"]}>
  <ul class="series-gallery-list" data-gallery-row={row || undefined}>
    {
      tiles.map(({ photo, thumb, full }) => (
        <li class="series-gallery-item" style={`--ratio: ${photo.ratio}`}>
          <a
            href={full.src}
            data-full={full.src}
            target="_blank"
            rel="noopener"
          >
            <img
              src={thumb.src}
              srcset={thumb.srcSet.attribute}
              sizes={row ? ROW_SIZES : SIZES}
              alt={photo.alt}
              width={photo.image.width}
              height={photo.image.height}
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>
