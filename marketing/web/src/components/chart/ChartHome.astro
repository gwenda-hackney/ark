---
/**
 * Home (#240): the logo on the leather, then the two things people come
 * for, what's on and the menu. Finding us, playing here and the list get a
 * short row at the foot; who we are lives on /about.
 */
import { Image } from "astro:assets";
import "../../styles/chart.css";
import "../../styles/chart-home.css";
import { siteConfig } from "../../config/site";
import { chartHeroLogo, homeDecksPhoto } from "../../lib/chart-assets";
import ChartNav from "./ChartNav.astro";
import ChartFooter from "./ChartFooter.astro";
import HomeMenu from "./HomeMenu.astro";
import HomeNights from "./HomeNights.astro";
import HomePhotos from "./HomePhotos.astro";

const { copy, location } = siteConfig;
const { contactPage } = copy;

const more = [
  {
    title: "Find us",
    text: `${location.addressShort}. Five minutes’ walk from Hackney Wick station, right on the canal.`,
    href: "/contact#find-us",
    link: "How to get here",
  },
  {
    title: contactPage.listHeading,
    text: contactPage.listLead,
    href: "/join-list",
    link: contactPage.listCta,
  },
];
---

<div class="ch-page ch-home" data-chart="closed">
  <ChartNav />
  <main>
    <section class="ch-hero" id="hero">
      <div class="ch-hero-content">
        <h1 class="visually-hidden">{siteConfig.seoTitle}</h1>
        <Image
          {...chartHeroLogo}
          alt="Gwenda"
          class="ch-hero-logo"
          loading="eager"
          fetchpriority="high"
        />
        <p class="ch-hero-social">{copy.social}</p>
        <p class="ch-hero-line">{copy.heroLine}</p>
        <div class="ch-hero-actions">
          <a href="#whats-on" class="ch-btn ch-btn--solid">What’s on</a>
          <a href="#menu" class="ch-btn">The menu</a>
        </div>
      </div>
    </section>

    <HomeNights />
    <HomeMenu />
    <HomePhotos />

    <section class="ch-home-section ch-home-play" aria-labelledby="home-play">
      <a href="/contact/play" class="ch-home-play-photo ch-print" tabindex="-1">
        <Image {...homeDecksPhoto} alt="" loading="lazy" />
        <span class="ch-print-note">{contactPage.playPhotoNote}</span>
      </a>
      <div class="ch-home-play-body">
        <h2 class="ch-poster" id="home-play">{contactPage.playHeading}</h2>
        <p>{contactPage.playLead}</p>
        <a href="/contact/play" class="ch-btn ch-btn--solid"
          >{contactPage.playCta}</a
        >
      </div>
    </section>

    <section class="ch-home-section ch-home-more" aria-label="More">
      {
        more.map((item) => (
          <a href={item.href} class="ch-home-more-item">
            <h2>{item.title}</h2>
            <p>{item.text}</p>
            <span class="ch-home-more-link">{item.link} →</span>
          </a>
        ))
      }
    </section>
  </main>
  <ChartFooter />
</div>
