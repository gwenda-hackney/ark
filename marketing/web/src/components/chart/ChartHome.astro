---
/**
 * Home, redesigned as The Chart (#240): the room darkened behind the torn
 * flag and the slogan, tonight beneath, the chart behind a button.
 */
import { Image } from "astro:assets";
import "../../styles/chart.css";
import { siteConfig } from "../../config/site";
import { bookingUrl } from "../../config/booking";
import { fetchSiteSettings } from "../../lib/sanity/site-settings";
import {
  chartHeroBackground,
  chartHeroLogo,
  chartTurntableLarge,
} from "../../lib/chart-assets";
import ChartBell from "./ChartBell.astro";
import ChartMap from "./ChartMap.astro";
import ChartNav from "./ChartNav.astro";
import ChartTonight from "./ChartTonight.astro";
import ChartFooter from "./ChartFooter.astro";

const { bookingEnabled } = await fetchSiteSettings();
const { contactPage } = siteConfig.copy;
---

<div class="ch-page" data-chart="closed">
  <ChartNav />
  <main>
    <section class="ch-hero" id="hero">
      <div class="ch-hero-media" aria-hidden="true">
        <Image
          {...chartHeroBackground}
          alt=""
          loading="eager"
          fetchpriority="high"
        />
        <div class="ch-hero-scrim"></div>
      </div>
      <div class="ch-hero-content">
        <h1 class="visually-hidden">{siteConfig.seoTitle}</h1>
        <Image
          {...chartHeroLogo}
          alt="Gwenda"
          class="ch-hero-logo"
          loading="eager"
          fetchpriority="high"
        />
        <p class="ch-slogan">{siteConfig.copy.heroCta}</p>
        <span class="ch-caps">{siteConfig.location.addressShort}</span>
        <div class="ch-hero-actions">
          {
            bookingEnabled && (
              <a
                href={bookingUrl}
                class="ch-btn ch-btn--solid"
                target="_blank"
                rel="noopener noreferrer"
              >
                <ChartBell />
                {siteConfig.copy.bookingCta}
              </a>
            )
          }
          <a href="/whats-on" class="ch-btn">What's on</a>
        </div>
      </div>
      <a href="#ch-tonight" class="ch-hero-more" aria-label="Tonight and more"
        ><span></span></a
      >
    </section>
    <ChartTonight />
    <section class="ch-home-paths" aria-label="Play here, or stay close">
      <a href="/find-us" class="ch-home-path">
        <span class="ch-home-path-photo ch-home-path-map">
          <ChartMap thumb />
        </span>
        <span class="ch-home-path-body">
          <span class="ch-caps">Getting here</span>
          <span class="ch-path-title">Five minutes from the station</span>
          <span class="ch-ital"
            >Down from Hackney Wick, along the lane, then the towpath by the
            water.</span
          >
          <span class="ch-link-line">The map →</span>
        </span>
      </a>
      <a href="/contact/play" class="ch-home-path ch-home-path--play">
        <span class="ch-frame ch-home-path-photo">
          <Image {...chartTurntableLarge} alt="" loading="lazy" />
        </span>
        <span class="ch-home-path-body">
          <span class="ch-caps">{contactPage.playEyebrow}</span>
          <span class="ch-path-title">{contactPage.playHeading}</span>
          <span class="ch-ital">{contactPage.playLead}</span>
          <span class="ch-link-line">{contactPage.playCta} →</span>
        </span>
      </a>
      <a href="/join-list" class="ch-home-path">
        <span class="ch-home-path-body">
          <span class="ch-caps">{contactPage.listEyebrow}</span>
          <span class="ch-path-title">{contactPage.listHeading}</span>
          <span class="ch-ital">{contactPage.listLead}</span>
          <span class="ch-link-line">{contactPage.listCta} →</span>
        </span>
      </a>
    </section>
  </main>
  <ChartFooter />
</div>
