---
/**
 * Home's what's on (#240, #352), one block: the next few days, each with its
 * event big and the deal and pop-up running that day beside it, as on the
 * What's on page (DayCards) but without the weeks; then the way to the lot.
 */
import { fetchWhatsOnCatalog } from "../../lib/sanity/events";
import { fetchMenu } from "../../lib/sanity/menu";
import { closedDays } from "../../lib/opening-hours.js";
import { fetchOpeningHours } from "../../lib/sanity/opening-hours";
import DayCards from "./DayCards.astro";

/** Tonight and the next two days with anything on. */
const HOME_DAYS = 3;

const { series, occurrences } = await fetchWhatsOnCatalog().catch(() => ({
  series: [],
  occurrences: [],
}));
const menu = await fetchMenu().catch(() => ({ sections: [] }));
/** "Shut Mondays." from the opening hours; nothing without them. */
const shut = closedDays(await fetchOpeningHours());
---

<section
  class="ch-home-section ch-home-nights"
  id="whats-on"
  aria-labelledby="home-whats-on"
>
  <header class="ch-home-head">
    <h2 class="ch-poster" id="home-whats-on">What’s on</h2>
    <p class="ch-home-head-note">
      Something on most nights. DJs, bands, chess, the odd party.{
        shut && ` Shut ${shut}.`
      }
    </p>
  </header>

  <DayCards
    series={series}
    occurrences={occurrences}
    menu={menu}
    shown={HOME_DAYS}
    weeks={false}
    leadEager={false}
    empty="Nothing on just now. The bar’s open anyway."
  />

  <div class="ch-home-actions">
    <a href="/whats-on" class="ch-menu-all">
      Everything that’s on <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
