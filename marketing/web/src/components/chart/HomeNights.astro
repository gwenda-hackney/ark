---
/**
 * Home's what's on (#240): the next few nights as cards, the same as the
 * What's on page (NightCards), and the way to the lot; then the deals and
 * the pop-up kitchen, a section each (StandingCards).
 */
import { getUpcomingEvents } from "../../data/events";
import { menuChapters } from "../../data/menu";
import { fetchWhatsOnCatalog } from "../../lib/sanity/events";
import { fetchMenu } from "../../lib/sanity/menu";
import { nightsOnly } from "../../lib/promotions.js";
import { closedDays } from "../../lib/opening-hours.js";
import { fetchOpeningHours } from "../../lib/sanity/opening-hours";
import NightCards from "./NightCards.astro";
import StandingCards from "./StandingCards.astro";

/** The big one, then a row of four. */
const HOME_NIGHTS = 5;

const { series, occurrences } = await fetchWhatsOnCatalog().catch(() => ({
  series: [],
  occurrences: [],
}));
const menu = await fetchMenu().catch(() => ({ sections: [] }));
/** NightCards shows the first few, an event over several days as one. */
const nights = getUpcomingEvents(nightsOnly(occurrences));
/** "Shut Mondays." from the opening hours; nothing without them. */
const shut = closedDays(await fetchOpeningHours());
---

<section class="ch-home-section ch-home-nights" id="whats-on">
  <header class="ch-home-head">
    <h2 class="ch-poster">What’s on</h2>
    <p class="ch-home-head-note">
      Something on most nights. DJs, bands, chess, the odd party.{
        shut && ` Shut ${shut}.`
      }
    </p>
  </header>

  <NightCards nights={nights} series={series} shown={HOME_NIGHTS} />

  <div class="ch-home-actions">
    <a href="/whats-on" class="ch-btn ch-btn--solid">Everything that’s on</a>
  </div>
</section>

<StandingCards
  series={series}
  occurrences={occurrences}
  chapters={menuChapters(menu, "kitchen")}
  home
/>
