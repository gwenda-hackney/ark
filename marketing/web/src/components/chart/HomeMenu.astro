---
/**
 * Home's menu (#240): drinks and food side by side. Each side lists a few
 * things from its first chapter with their prices, then the rest of that
 * menu, a tile per chapter, with what it starts from (lib/home-menu.js),
 * prints from the gallery taped up, and a plain line to the whole menu at
 * its foot, in the same order on both. Every one of
 * those is a link to its own section of that menu's page; where that is
 * comes from the menu itself (lib/menu-anchors.js), never from a list here.
 * A side with nothing on it yet keeps its line. While a pop-up kitchen is
 * booked or on, the Food side opens with who's cooking: its logo and name
 * from ops, and the way to its page (#296).
 */
import { menuChapters } from "../../data/menu";
import { sizedImageUrl } from "../../../functions/_lib/sanity-image-url.js";
import { menuTaste } from "../../lib/home-menu.js";
import { londonToday } from "../../lib/london-day.js";
import { menuPage } from "../../lib/menu-anchors.js";
import { eventPhotos, galleryPhotos } from "../../lib/photo-sources";
import { homePhotoPlan } from "../../lib/photos.js";
import {
  foodBoardLine,
  kitchenChaptersOn,
  kitchenHeader,
  kitchenNow,
} from "../../lib/popup-kitchen.js";
import { fetchWhatsOnCatalog } from "../../lib/sanity/events";
import { fetchMenu } from "../../lib/sanity/menu";
import type { MenuKind } from "../../types/menu";
import KitchenLine from "./KitchenLine.astro";

const today = londonToday();
const menu = await fetchMenu().catch(() => ({ sections: [] }));
const { series, occurrences } = await fetchWhatsOnCatalog().catch(() => ({
  series: [],
  occurrences: [],
}));
/**
 * Who's in the kitchen: the pop-up booked or on. Its chapter of the menu
 * shows from when it's booked through its last night (kitchenChaptersOn).
 */
const { popup } = kitchenNow(series, occurrences, today);
const kitchenChapters = kitchenChaptersOn(
  menuChapters(menu, "kitchen"),
  occurrences,
  today,
);
/**
 * The top of the Food side while the pop-up is booked or on: its logo, who
 * and when, the way to its page; null otherwise (lib/popup-kitchen.js).
 */
const kitchenTop = kitchenHeader(popup);
/** In place of the Food side's menu, when it has none (lib/popup-kitchen.js). */
const foodLine = foodBoardLine(popup, kitchenChapters);
/** The pop-up's logo at the top of the Food side: 4.5rem (72px), sharp at 2x. */
const LOGO_WIDTH = 72;

/**
 * The prints taped up on each board: the first of the venue's photos marked
 * for it (its menu board in ops' Gallery); from when a pop-up is booked
 * through its last night, the Food board's are from its own gallery in ops.
 * Which photo goes where on home is lib/photos.js homePhotoPlan, for the
 * boards and the photo row alike.
 */
const { kitchen: kitchenPhotos } = await eventPhotos(today);
const photoPlan = homePhotoPlan(await galleryPhotos(), {
  kitchen: kitchenPhotos?.photos || [],
});
/** A print's photo, 12rem across at most (192px), sharp at 2x. */
const PHOTO_WIDTH = 192;

/** A side's menu, by its `kind` in the data: its page, and a taste of it. */
function menuOf(kind: MenuKind) {
  return {
    href: menuPage(kind),
    taste: menuTaste(
      kind === "kitchen" ? kitchenChapters : menuChapters(menu, kind),
    ),
  };
}

const sides = [
  {
    key: "drinks",
    title: "Drinks",
    link: "All the drinks",
    line: "Our own cocktails, the classics, cold beer, and a few with no booze in.",
    photos: photoPlan.drinks,
    ...menuOf("bar"),
  },
  {
    key: "food",
    title: "Food",
    link: "All the food",
    /** What the food is; who's cooking goes at the top, while a pop-up's on. */
    line: "Proper food to go with a drink.",
    photos: photoPlan.food,
    ...menuOf("kitchen"),
  },
];
---

<section class="ch-home-section ch-home-menu" id="menu">
  <header class="ch-home-head">
    <h2 class="ch-poster">On the menu</h2>
    <p class="ch-home-head-note">What we’re pouring and what’s cooking.</p>
  </header>

  <div class="ch-menu-sides">
    {
      sides.map((side) => (
        <article
          class:list={["ch-menu-side", `ch-menu-side--${side.key}`]}
          id={side.key}
        >
          <header class="ch-menu-side-head">
            <h3>
              <a href={side.href}>{side.title}</a>
            </h3>
            <p>{side.line}</p>
          </header>

          {side.key === "food" && kitchenTop && (
            <a href={kitchenTop.href} class="ch-menu-kitchen">
              {kitchenTop.logo && (
                <img
                  class="ch-menu-kitchen-logo"
                  src={sizedImageUrl(kitchenTop.logo.url, LOGO_WIDTH)}
                  srcset={`${sizedImageUrl(kitchenTop.logo.url, LOGO_WIDTH)} 1x, ${sizedImageUrl(kitchenTop.logo.url, LOGO_WIDTH * 2)} 2x`}
                  alt=""
                  width={LOGO_WIDTH}
                  height={LOGO_WIDTH}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="ch-menu-kitchen-line">{kitchenTop.line}</span>
            </a>
          )}

          {side.taste ? (
            <>
              <h4 class="ch-menu-chapter">{side.taste.lead.title}</h4>
              <ul class="ch-menu-items">
                {side.taste.lead.items.map((item) => (
                  <li>
                    <span class="ch-menu-item-line">
                      <span class="ch-menu-item-name">{item.name}</span>
                      {item.price && (
                        <span class="ch-menu-item-price">{item.price}</span>
                      )}
                    </span>
                    {item.description && (
                      <span class="ch-menu-item-desc">{item.description}</span>
                    )}
                  </li>
                ))}
              </ul>
              {side.taste.lead.total > side.taste.lead.items.length && (
                <a href={side.taste.lead.href} class="ch-menu-rest">
                  and {side.taste.lead.total - side.taste.lead.items.length}{" "}
                  more →
                </a>
              )}
              {side.taste.more.length > 0 && (
                <ul class="ch-menu-more">
                  {side.taste.more.map((part) => (
                    <li>
                      <a href={part.href}>
                        <span>{part.title}</span>
                        {part.from && <span>from {part.from}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </>
          ) : side.key === "food" ? (
            <KitchenLine
              line={foodLine}
              popup={popup}
              soon="The list’s on its way."
              class="ch-menu-soon"
            />
          ) : (
            <p class="ch-menu-soon">The list’s on its way.</p>
          )}

          {side.photos.length > 0 && (
            <div class="ch-menu-photos">
              {/* The newest goes up last, on top */}
              {[...side.photos].reverse().map((photo) => (
                <figure class="ch-menu-photo ch-print">
                  <img
                    src={sizedImageUrl(photo.url, PHOTO_WIDTH)}
                    srcset={`${sizedImageUrl(photo.url, PHOTO_WIDTH)} 1x, ${sizedImageUrl(photo.url, PHOTO_WIDTH * 2)} 2x`}
                    alt={
                      photo.alt ||
                      (kitchenPhotos ? `Food from ${kitchenPhotos.title}` : "")
                    }
                    width={PHOTO_WIDTH}
                    height={Math.round(
                      (PHOTO_WIDTH * photo.height) / photo.width,
                    )}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))}
            </div>
          )}

          <a href={side.href} class="ch-menu-all">
            {side.link} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
