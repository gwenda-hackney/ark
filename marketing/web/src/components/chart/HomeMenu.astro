---
/**
 * Home's menu (#240): drinks and food side by side. Each side lists a few
 * things from its first chapter with their prices, then the rest of that
 * menu, a tile per chapter, with what it starts from (lib/home-menu.js),
 * prints from the gallery taped up, and a plain line to the whole menu at
 * its foot, in the same order on both. Every one of
 * those is a link to its own section of that menu's page; where that is
 * comes from the menu itself (lib/menu-anchors.js), never from a list here.
 * A side with nothing on it yet keeps its line. While a pop-up kitchen is
 * booked or on, the Food side opens with who's cooking: its logo and name
 * from ops, and the way to its page (#296).
 */
import { menuTaste } from "../../lib/home-menu.js";
import { londonToday } from "../../lib/london-day.js";
import { menuPage } from "../../lib/menu-anchors.js";
import { boardCards, boardPick, menuShelf } from "../../lib/menus.js";
import { eventPhotos, galleryPhotos } from "../../lib/photo-sources";
import { homePhotoPlan } from "../../lib/photos.js";
import { fetchWhatsOnCatalog } from "../../lib/sanity/events";
import { fetchMenu } from "../../lib/sanity/menu";
import MenuBoard from "./MenuBoard.astro";

const today = londonToday();
const menu = await fetchMenu().catch(() => ({ sections: [] }));
const catalog = await fetchWhatsOnCatalog().catch(() => ({
  series: [],
  occurrences: [],
}));
/**
 * Each board's lead (lib/menus.js boardPick, #306): the menu running today,
 * on the Food board the kitchen cooking today, else the next one, labelled
 * with its day; the rest under "Also".
 */
const shelves = {
  bar: menuShelf("bar", menu, catalog, today),
  kitchen: menuShelf("kitchen", menu, catalog, today),
};
const boards = {
  bar: boardPick(shelves.bar, today),
  kitchen: boardPick(shelves.kitchen, today),
};

/** Who's cooking, at the top of a kitchen's card: its logo, who and when, in its own colour (#319). */
function topOf(card: ReturnType<typeof boardCards>[number]) {
  return card.popup
    ? {
        title: card.popup.title,
        logo: card.popup.logo,
        line: card.line,
        href: card.popup.href,
        style: card.popup.colourStyle || undefined,
      }
    : null;
}

/**
 * The prints taped up on each board: the first of the venue's photos marked
 * for it (its menu board in ops' Gallery); a pop-up kitchen's Food board
 * takes its own gallery's from ops. Which photo goes where on home is
 * lib/photos.js homePhotoPlan, for the boards and the photo row alike.
 */
const gallery = await galleryPhotos();
const { kitchen: kitchenPhotos } = await eventPhotos(today);
const photoPlan = homePhotoPlan(gallery, {
  kitchen: kitchenPhotos?.photos || [],
});
const drinks = {
  side: "drinks" as const,
  id: "drinks",
  title: "Drinks",
  href: menuPage("bar"),
  link: "All the drinks",
  line: "Our own cocktails, the classics, cold beer, and a few with no booze in.",
  top: null,
  taste: boards.bar?.menu
    ? menuTaste(boards.bar.menu.chapters, { where: shelves.bar.where })
    : null,
  menuLabel: boards.bar?.menuLabel || "",
  empty: "The list’s on its way.",
  also: boards.bar?.also || [],
  photos: photoPlan.drinks,
  photoAlt: "",
};

/** What every Food board says, whoever is cooking. */
const foodFrame = {
  side: "food" as const,
  title: "Food",
  href: menuPage("kitchen"),
  link: "All the food",
  line: "Proper food to go with a drink.",
};

/**
 * The Food board: the kitchen cooking next (lib/menus.js boardCards),
 * its logo and "Day: Name", and the others under "Also".
 */
const lead = boardCards(shelves.kitchen, today)[0];
const food = {
  ...foodFrame,
  id: "food",
  top: lead ? topOf(lead) : null,
  taste: boards.kitchen?.menu
    ? menuTaste(boards.kitchen.menu.chapters, { where: shelves.kitchen.where })
    : null,
  menuLabel: boards.kitchen?.menuLabel || "",
  empty: boards.kitchen
    ? "The list’s on its way."
    : "No kitchen in right now, back soon.",
  also: boards.kitchen?.also || [],
  photos: photoPlan.food,
  photoAlt: kitchenPhotos ? `Food from ${kitchenPhotos.title}` : "",
};
---

<section class="ch-home-section ch-home-menu" id="menu">
  <header class="ch-home-head">
    <h2 class="ch-poster">On the menu</h2>
    <p class="ch-home-head-note">What we’re pouring and what’s cooking.</p>
  </header>

  <div class="ch-menu-sides">
    <MenuBoard {...drinks} />
    <MenuBoard {...food} />
  </div>
</section>
