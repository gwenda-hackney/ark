---
/**
 * Home's menu (#240): drinks and food side by side. Each side lists a few
 * things from its first chapter with their prices, then the rest of that
 * menu, a tile per chapter, with what it starts from (lib/home-menu.js),
 * prints from the gallery taped up, and a plain line to the whole menu at
 * its foot, in the same order on both. Every one of
 * those is a link to its own section of that menu's page; where that is
 * comes from the menu itself (lib/menu-anchors.js), never from a list here.
 * A side with nothing on it yet keeps its line. While a pop-up kitchen is
 * booked or on, the Food side opens with who's cooking: its logo and name
 * from ops, and the way to its page (#296).
 */
import { sizedImageUrl } from "../../../functions/_lib/sanity-image-url.js";
import { menuTaste } from "../../lib/home-menu.js";
import { londonToday } from "../../lib/london-day.js";
import { menuPage } from "../../lib/menu-anchors.js";
import { boardCards, boardPick, menuShelf } from "../../lib/menus.js";
import { eventPhotos, galleryPhotos } from "../../lib/photo-sources";
import { homePhotoPlan } from "../../lib/photos.js";
import { fetchWhatsOnCatalog } from "../../lib/sanity/events";
import { fetchMenu } from "../../lib/sanity/menu";
import type { MenuKind } from "../../types/menu";
import FoodStack from "./FoodStack.astro";
import KitchenCard from "./KitchenCard.astro";

const today = londonToday();
const menu = await fetchMenu().catch(() => ({ sections: [] }));
const catalog = await fetchWhatsOnCatalog().catch(() => ({
  series: [],
  occurrences: [],
}));
/**
 * Each board's lead (lib/menus.js boardPick, #306): the menu running today,
 * on the Food board the kitchen cooking today, else the next one, labelled
 * with its day; the rest under "Also".
 */
const shelves = {
  bar: menuShelf("bar", menu, catalog, today),
  kitchen: menuShelf("kitchen", menu, catalog, today),
};
const boards = {
  bar: boardPick(shelves.bar, today),
  kitchen: boardPick(shelves.kitchen, today),
};

/** Who's cooking, at the top of a kitchen's card: its logo, who and when, in its own colour (#319). */
function topOf(card: ReturnType<typeof boardCards>[number]) {
  return card.popup
    ? {
        title: card.popup.title,
        logo: card.popup.logo,
        line: card.line,
        href: card.popup.href,
        style: card.popup.colourStyle || undefined,
      }
    : null;
}

/**
 * Two or more pop-up kitchens: the Food board is a stack of their cards,
 * the one cooking next on top (FoodStack.astro). One: the board as it was.
 */
const foodCards = boardCards(shelves.kitchen, today)
  .filter((card) => card.popup)
  .map((card) => ({
    id: card.id,
    when: card.when,
    top: topOf(card)!,
    taste: card.menu
      ? menuTaste(card.menu.chapters, { where: shelves.kitchen.where })
      : null,
    menuLabel: card.menuLabel,
    empty: "The list’s on its way.",
  }));
const stacked = foodCards.length > 1;
const kitchenTop = boards.kitchen?.popup
  ? topOf(boardCards(shelves.kitchen, today)[0])
  : null;

/**
 * The prints taped up on each board: the first of the venue's photos marked
 * for it (its menu board in ops' Gallery); while a pop-up kitchen leads the
 * Food board, its prints are from that kitchen's own gallery in ops.
 * Which photo goes where on home is lib/photos.js homePhotoPlan, for the
 * boards and the photo row alike.
 */
const { kitchen: kitchenPhotos } = await eventPhotos(today);
const photoPlan = homePhotoPlan(await galleryPhotos(), {
  kitchen: kitchenPhotos?.photos || [],
});
/** A print's photo, 12rem across at most (192px), sharp at 2x. */
const PHOTO_WIDTH = 192;

/**
 * A side's menu, by its `kind` in the data: its page, a taste of the menu
 * it leads with, that menu's day when it isn't today's ("Saturday's menu"),
 * and the others ("Also"). With nothing to lead with, what it says instead.
 */
function menuOf(kind: MenuKind) {
  const pick = boards[kind];
  const shelf = shelves[kind];
  return {
    href: menuPage(kind),
    taste: pick?.menu
      ? menuTaste(pick.menu.chapters, { where: shelf.where })
      : null,
    menuLabel: pick?.menuLabel || "",
    // The stack shows the other kitchens: no "Also" under it
    also: kind === "kitchen" && stacked ? [] : pick?.also || [],
    empty:
      kind === "kitchen" && !pick
        ? "No kitchen in right now, back soon."
        : "The list’s on its way.",
  };
}

const sides = [
  {
    key: "drinks",
    title: "Drinks",
    link: "All the drinks",
    line: "Our own cocktails, the classics, cold beer, and a few with no booze in.",
    photos: photoPlan.drinks,
    ...menuOf("bar"),
  },
  {
    key: "food",
    title: "Food",
    link: "All the food",
    /** What the food is; who's cooking goes at the top, while a pop-up's on. */
    line: "Proper food to go with a drink.",
    photos: photoPlan.food,
    ...menuOf("kitchen"),
  },
];
---

<section class="ch-home-section ch-home-menu" id="menu">
  <header class="ch-home-head">
    <h2 class="ch-poster">On the menu</h2>
    <p class="ch-home-head-note">What we’re pouring and what’s cooking.</p>
  </header>

  <div class="ch-menu-sides">
    {
      sides.map((side) => (
        <article
          class:list={["ch-menu-side", `ch-menu-side--${side.key}`]}
          id={side.key}
        >
          <header class="ch-menu-side-head">
            <h3>
              <a href={side.href}>{side.title}</a>
            </h3>
            <p>{side.line}</p>
          </header>

          {side.key === "food" && stacked ? (
            <FoodStack cards={foodCards} />
          ) : (
            <KitchenCard
              top={side.key === "food" ? kitchenTop : null}
              taste={side.taste}
              menuLabel={side.menuLabel}
              empty={side.empty}
            />
          )}

          {side.also.length > 0 && (
            <p class="ch-menu-also">
              Also:{" "}
              {side.also.map((other, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={other.href}>
                    {other.text} <span aria-hidden="true">→</span>
                  </a>
                </>
              ))}
            </p>
          )}

          {side.photos.length > 0 && (
            <div class="ch-menu-photos">
              {/* The newest goes up last, on top */}
              {[...side.photos].reverse().map((photo) => (
                <figure class="ch-menu-photo ch-print">
                  <img
                    src={sizedImageUrl(photo.url, PHOTO_WIDTH)}
                    srcset={`${sizedImageUrl(photo.url, PHOTO_WIDTH)} 1x, ${sizedImageUrl(photo.url, PHOTO_WIDTH * 2)} 2x`}
                    alt={
                      photo.alt ||
                      (kitchenPhotos ? `Food from ${kitchenPhotos.title}` : "")
                    }
                    width={PHOTO_WIDTH}
                    height={Math.round(
                      (PHOTO_WIDTH * photo.height) / photo.width,
                    )}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))}
            </div>
          )}

          <a href={side.href} class="ch-menu-all">
            {side.link} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
