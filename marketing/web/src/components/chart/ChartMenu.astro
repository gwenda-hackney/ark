---
/**
 * The menu in The Chart (#240): chapters in the order ops sets them, the
 * items on dotted leaders, descriptions in italic.
 */
import type { MenuSection } from "../../types/menu";
import { formatMenuPrice, menuPrices } from "../../types/menu";
import { getAvailableItems } from "../../data/menu";

interface Props {
  sections: MenuSection[];
  /** Shown when the menu has no chapters yet. */
  empty: string;
}

const { sections, empty } = Astro.props;

function hasContent(section: MenuSection): boolean {
  if (getAvailableItems(section).length > 0) return true;
  return (section.subsections ?? []).some(hasContent);
}

const chapters = sections.filter(hasContent);
---

{chapters.length === 0 && <p class="ch-ital">{empty}</p>}
{
  chapters.length > 1 && (
    <nav class="ch-jump" aria-label="Menu chapters">
      {chapters.map((chapter) => (
        <a href={`#${chapter.id}`}>{chapter.title}</a>
      ))}
    </nav>
  )
}

<div class="ch-sheet">
  {
    chapters.map((chapter) => (
      <section class="ch-chapter" id={chapter.id}>
        <h2 class="ch-sheet-head">{chapter.title}</h2>
        {[chapter, ...(chapter.subsections ?? [])]
          .filter(hasContent)
          .map((group) => (
            <div class="ch-group">
              {group !== chapter && <h3>{group.title}</h3>}
              <ul class="ch-list">
                {getAvailableItems(group).map((item) => {
                  const price = formatMenuPrice(item);
                  const rows = price ? [] : menuPrices(item);
                  return (
                    <li>
                      <span class="ch-item-line">
                        <span class="ch-item-name">{item.name}</span>
                        {price && <span class="ch-price">{price}</span>}
                      </span>
                      {item.description && (
                        <span class="ch-item-desc">{item.description}</span>
                      )}
                      {rows.length > 0 && (
                        <span class="ch-item-sizes">
                          {rows.map((row) => (
                            <span>
                              {row.name || row.size}{" "}
                              <span class="ch-price">{row.price}</span>
                            </span>
                          ))}
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
      </section>
    ))
  }
</div>
