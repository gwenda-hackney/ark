---
/**
 * The menu (#240): chapters in the order ops sets them. They go two
 * abreast, so the first two start level at the top; a chapter of nothing
 * but beer runs the full width as its own band (lib/menu-layout.js). Each
 * chapter and group carries the id its links land on (lib/menu-anchors.js).
 */
import "../../styles/chart-menu.css";
import type { MenuSection } from "../../types/menu";
import { menuSheet } from "../../lib/menu-layout.js";
import ChartMenuChapter from "./ChartMenuChapter.astro";

interface Props {
  /** One menu's chapters as they were fetched: all of them, in order. */
  sections: MenuSection[];
  /** Shown when the menu has no chapters yet (or the `empty` slot). */
  empty?: string;
}

const { sections, empty = "" } = Astro.props;
const { chapters, rows } = menuSheet(sections);
---

{
  chapters.length === 0 &&
    (Astro.slots.has("empty") ? (
      <slot name="empty" />
    ) : (
      <p class="ch-ital">{empty}</p>
    ))
}
{
  chapters.length > 1 && (
    <nav class="ch-jump" aria-label="Menu chapters">
      {chapters.map(({ chapter, id }) => (
        <a href={`#${id}`}>{chapter.title}</a>
      ))}
    </nav>
  )
}

<div class="ch-sheet">
  {
    rows.map((row) =>
      row.layout === "columns" ? (
        <div class="ch-sheet-row ch-sheet-row--columns">
          {row.columns.map((column) => (
            <div class="ch-sheet-col">
              {column.map((entry) => (
                <ChartMenuChapter {...entry} />
              ))}
            </div>
          ))}
        </div>
      ) : (
        <div class:list={["ch-sheet-row", `ch-sheet-row--${row.layout}`]}>
          {row.chapters.map((entry) => (
            <ChartMenuChapter {...entry} />
          ))}
        </div>
      ),
    )
  }
</div>
