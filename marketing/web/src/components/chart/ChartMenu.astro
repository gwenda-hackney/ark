---
/**
 * The menu (#240): chapters in the order ops sets them. They go two
 * abreast, so the first two start level at the top; a chapter of nothing
 * but beer runs the full width as its own band (lib/menu-layout.js).
 */
import type { MenuSection } from "../../types/menu";
import { getAvailableItems } from "../../data/menu";
import { menuRows } from "../../lib/menu-layout.js";
import ChartMenuChapter from "./ChartMenuChapter.astro";

interface Props {
  sections: MenuSection[];
  /** Shown when the menu has no chapters yet. */
  empty: string;
}

const { sections, empty } = Astro.props;

function hasContent(section: MenuSection): boolean {
  if (getAvailableItems(section).length > 0) return true;
  return (section.subsections ?? []).some(hasContent);
}

const chapters = sections.filter(hasContent);
const rows = menuRows(chapters);
---

{chapters.length === 0 && <p class="ch-ital">{empty}</p>}
{
  chapters.length > 1 && (
    <nav class="ch-jump" aria-label="Menu chapters">
      {chapters.map((chapter) => (
        <a href={`#${chapter.id}`}>{chapter.title}</a>
      ))}
    </nav>
  )
}

<div class="ch-sheet">
  {
    rows.map((row) =>
      row.layout === "columns" ? (
        <div class="ch-sheet-row ch-sheet-row--columns">
          {row.columns.map((column) => (
            <div class="ch-sheet-col">
              {column.map(({ chapter, order }) => (
                <ChartMenuChapter chapter={chapter} order={order} />
              ))}
            </div>
          ))}
        </div>
      ) : (
        <div class:list={["ch-sheet-row", `ch-sheet-row--${row.layout}`]}>
          {row.chapters.map(({ chapter, order }) => (
            <ChartMenuChapter chapter={chapter} order={order} />
          ))}
        </div>
      ),
    )
  }
</div>
