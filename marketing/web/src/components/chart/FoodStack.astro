---
/**
 * Home's Food board with two or more pop-up kitchens (#306): a stack of
 * menu cards, one per kitchen (KitchenCard.astro), the one cooking next on
 * top (lib/menus.js boardCards). Under the top card, a strip for each
 * kitchen with its day and its name in its own colour, always in the same
 * order and place: pick one (or swipe the card on a phone, or use the arrow
 * keys) and its card slides up over the top; the other tucks back in.
 *
 * Without JavaScript the cards stand one under another, each whole, and the
 * strips aren't there. scripts/food-stack.js does the switching.
 */
import type { menuTaste } from "../../lib/home-menu.js";
import KitchenCard from "./KitchenCard.astro";

interface Props {
  cards: Array<{
    id: string;
    /** Its day in a word, for its strip: "Today", "Thursday". */
    when: string;
    top: {
      title: string;
      logo: null | { url: string };
      line: string;
      href: string;
      style?: string;
    };
    taste: ReturnType<typeof menuTaste>;
    menuLabel: string;
    empty: string;
  }>;
}

const { cards } = Astro.props;
const tabId = (id: string) => `food-tab-${id}`;
const cardId = (id: string) => `food-card-${id}`;
---

<div class="ch-food-stack" data-food-stack>
  <div class="ch-food-cards" data-food-cards>
    {
      cards.map((card, index) => (
        <div
          class="ch-food-card"
          id={cardId(card.id)}
          role="tabpanel"
          aria-labelledby={tabId(card.id)}
          data-food-card
          data-current={index === 0 ? "" : undefined}
          style={card.top.style}
        >
          <KitchenCard
            top={card.top}
            taste={card.taste}
            menuLabel={card.menuLabel}
            empty={card.empty}
          />
        </div>
      ))
    }
  </div>
  <div class="ch-food-strips" role="tablist" aria-label="Kitchens" hidden>
    {
      cards.map((card, index) => (
        <button
          type="button"
          class="ch-food-strip"
          role="tab"
          id={tabId(card.id)}
          aria-controls={cardId(card.id)}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          style={card.top.style}
          data-food-strip
        >
          <span class="ch-food-strip-day">{card.when}</span>
          <span class="ch-food-strip-name">{card.top.title}</span>
        </button>
      ))
    }
  </div>
</div>

<script>
  import { initFoodStacks } from "../../scripts/food-stack.js";

  initFoodStacks();
  document.addEventListener("astro:page-load", () => initFoodStacks());
</script>
