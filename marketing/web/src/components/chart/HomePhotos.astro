---
/**
 * Home's photos (#240): the newest few in two rows, at the foot of home; the
 * rest are on /photos. Which ones is lib/photos.js (homePhotoPlan): the
 * venue's in its Gallery's order, with the newest from a couple of recent
 * events spread through them (#291); never one a menu board already has
 * pinned up, so it gets the pop-up kitchen's photos as HomeMenu does.
 */
import { homePhotoPlan } from "../../lib/photos.js";
import { eventPhotos, galleryPhotos } from "../../lib/photo-sources";
import PhotoWall from "./PhotoWall.astro";

const { events, kitchen } = await eventPhotos();
const { row: photos, more } = homePhotoPlan(await galleryPhotos(), {
  kitchen: kitchen?.photos || [],
  events,
});
---

{
  photos.length > 0 && (
    <section
      class="ch-home-section ch-photos ch-home-photos"
      id="photos"
      aria-labelledby="home-photos"
    >
      <header class="ch-home-head">
        <h2 class="ch-poster" id="home-photos">
          Photos
        </h2>
        {more > 0 && (
          <a
            href="/photos"
            class="ch-photos-more-link"
            aria-label="More photos"
          >
            More <span aria-hidden="true">→</span>
          </a>
        )}
      </header>
      <PhotoWall photos={photos} row />
    </section>
  )
}
