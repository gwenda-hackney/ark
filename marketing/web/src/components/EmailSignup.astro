---
import { Image } from "astro:assets";
import type { SiteMode } from "../types/features";
import { siteConfig } from "../config/site";
import { getCopy } from "../config/copy";
import { bookingUrl } from "../config/booking";
import { formPublicPath, PLAY_FORM_SLUG } from "../lib/form-paths";
import { headerLogo } from "../lib/hero-assets";

interface Props {
  mode: SiteMode;
  /** Compact layout for embedding on /join-list (no home #list anchor). */
  embedded?: boolean;
  /**
   * The form alone, for the foot of every page (ChartFooter): no heading
   * (the foot's column has one), the yes-box said short (same meaning), a
   * short thanks, and ids of its own so it can
   * share a page with the page's own sign-up. Same form, same script.
   */
  compact?: boolean;
}

const { mode, compact = false } = Astro.props;
const embedded = compact || Astro.props.embedded === true;
const copy = getCopy(mode);
const { contactPage } = siteConfig.copy;
const playHref = formPublicPath(PLAY_FORM_SLUG);
/** Ids are page-wide: the foot's get a prefix. */
const id = (name: string) => (compact ? `footer-${name}` : name);
const sectionClass = compact
  ? "signup signup--embedded signup--compact"
  : embedded
    ? "signup section signup--embedded"
    : "signup section";
const reveal = !compact;
const Wrapper = compact ? "div" : "section";
---

<Wrapper class={sectionClass} id={embedded ? undefined : "list"}>
  <div
    class:list={[
      !compact && "container",
      embedded ? "signup-inner" : "contact-hub-inner",
    ]}
  >
    {
      embedded ? (
        <div class="signup-stage">
          <div class="signup-panel" id={id("signup-panel")}>
            {!compact && (
              <header class="section-header reveal">
                <p class="section-eyebrow">{copy.signupEyebrow}</p>
                <h2>{copy.signupHeading}</h2>
                <p>{copy.signupSubheading}</p>
              </header>
            )}

            <form
              class:list={["signup-form", reveal && "reveal reveal-stagger"]}
              id={id("signup-form")}
              style={reveal ? "--reveal-delay: 0.14s" : undefined}
              novalidate
            >
              <div class="signup-field">
                <label for={id("email")} class="visually-hidden">
                  Email address
                </label>
                <input
                  type="email"
                  name="email"
                  id={id("email")}
                  placeholder="your@email.com"
                  required
                  autocomplete="email"
                  inputmode="email"
                  spellcheck="false"
                />
                <button type="submit" class="btn btn-primary">
                  {siteConfig.copy.signupButton}
                </button>
              </div>

              <label class="signup-consent">
                <input
                  type="checkbox"
                  name="consent"
                  id={id("consent")}
                  required
                />
                <span>
                  {compact
                    ? siteConfig.copy.signupConsentShort
                    : siteConfig.copy.signupConsent}
                </span>
              </label>

              <input type="hidden" name="tag" value="prelaunch" />

              <div class="visually-hidden" aria-hidden="true">
                <label for={id("website")}>Website</label>
                <input
                  type="text"
                  name="website"
                  id={id("website")}
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>

              <p
                class="signup-error"
                id={id("signup-error")}
                role="alert"
                aria-live="polite"
              />
            </form>
          </div>

          <div
            class="signup-confirm"
            id={id("signup-confirm")}
            aria-hidden="true"
          >
            {!compact && (
              <Image
                {...headerLogo}
                alt="Gwenda"
                class="signup-confirm-logo"
                loading="lazy"
              />
            )}
            {!compact && <p class="signup-confirm-eyebrow">Cheers</p>}
            {compact ? (
              <p class="signup-confirm-title">
                {siteConfig.copy.signupSuccessTitle}
              </p>
            ) : (
              <h2 class="signup-confirm-title">
                {siteConfig.copy.signupSuccessTitle}
              </h2>
            )}
            <p class="signup-confirm-lead">
              {siteConfig.copy.signupSuccessLead}
            </p>
            {!compact && (
              <a href="/#hero" class="btn btn-primary signup-confirm-back">
                {siteConfig.copy.signupSuccessBack}
              </a>
            )}
          </div>
        </div>
      ) : (
        <div class="contact-hub-paths">
          <article
            class="contact-hub-path reveal reveal-stagger"
            style="--reveal-delay: 0.08s"
          >
            <p class="contact-hub-path-eyebrow">
              {siteConfig.copy.bookTableEyebrow}
            </p>
            <h2>{siteConfig.copy.bookTableHeading}</h2>
            <p>{siteConfig.copy.bookTableLead}</p>
            <a
              href={bookingUrl}
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              {siteConfig.copy.bookingCta}
            </a>
          </article>

          <div class="contact-hub-rule" aria-hidden="true" />

          <article
            class="contact-hub-path reveal reveal-stagger"
            style="--reveal-delay: 0.16s"
          >
            <p class="contact-hub-path-eyebrow">{contactPage.playEyebrow}</p>
            <h2>{contactPage.playHeading}</h2>
            <p>{contactPage.playLead}</p>
            <a href={playHref} class="btn btn-ghost">
              {contactPage.playCta}
            </a>
          </article>
        </div>
      )
    }
  </div>
</Wrapper>
