---
import { Image } from "astro:assets";
import type { SiteFeatures } from "../types/features";
import { siteConfig } from "../config/site";
import { headerLogo } from "../lib/hero-assets";
import {
  homeAnchorItems,
  isCurrentNavPage,
  navPathname,
  shouldReloadNavLink,
  sitePageLinks,
} from "../lib/site-nav.js";

export interface NavItem {
  href: string;
  label: string;
  /** Gold join link, same as the home menu. */
  cta?: boolean;
}

interface Props {
  /** Home sections. Omitted when `items` supplies this page's menu. */
  features?: SiteFeatures;
  showMenuTease?: boolean;
  /** This page: Home, then anchors and child pages. */
  items?: NavItem[];
  /**
   * Subpage: wordmark waits for scroll. The hamburger stays either way.
   */
  collapsed?: boolean;
  /**
   * Home: the hero already shows the wordmark. Mark this in the first HTML
   * so the bar logo is hidden before paint. Adding the class from script
   * after paint runs the slide-away transition.
   */
  awaitsHero?: boolean;
  logoHref?: string;
  /** Used to drop the current route from the other pages. */
  pathname?: string;
}

const {
  features,
  showMenuTease = false,
  items,
  collapsed = false,
  awaitsHero = false,
  logoHref = collapsed ? "/" : "#hero",
  pathname = Astro.url.pathname,
} = Astro.props;

const showMenuLink = items
  ? true
  : Boolean(showMenuTease || features?.showMenu);
const pageLinks =
  items ??
  homeAnchorItems({
    showMenu: Boolean(showMenuTease),
    showTeam: Boolean(features?.showTeam),
    showGallery: Boolean(features?.showGallery),
    signupLabel: siteConfig.copy.signupNavCta,
  });
const homeLink = pageLinks.find((item) => navPathname(item.href) === "/");
const thisPageLinks = pageLinks.filter((item) => item !== homeLink);
const siteLinks = sitePageLinks(pathname, { showMenu: showMenuLink });
/** A long chapter list never fits beside the wordmark. Keep the hamburger. */
const overlayOnly = pageLinks.length > 6;
---

<header
  class:list={[
    "site-header",
    collapsed && "site-header--collapsed",
    awaitsHero && "awaits-hero",
  ]}
  id="site-header"
>
  <a
    href={logoHref}
    class="site-header-logo"
    aria-label={collapsed ? "Gwenda home" : "Gwenda"}
  >
    <Image {...headerLogo} alt="" class="site-header-logo-img" />
  </a>

  <button
    type="button"
    class="site-header-menu-btn"
    id="site-header-menu-btn"
    aria-expanded="false"
    aria-controls="site-header-nav"
    aria-label="Open menu"
  >
    <span class="site-header-menu-icon" aria-hidden="true"></span>
  </button>
</header>

<nav
  class:list={["site-header-nav", overlayOnly && "site-header-nav--overlay-only"]}
  id="site-header-nav"
  aria-label="Menu"
>
  {
    homeLink && (
      <a
        href={homeLink.href}
        class="site-nav-home"
        data-astro-reload={shouldReloadNavLink(homeLink.href) || undefined}
        aria-current={isCurrentNavPage(homeLink.href, pathname) ? "page" : undefined}
      >
        {homeLink.label}
      </a>
    )
  }
  <div
    class="site-nav-group site-nav-group--page"
    role="group"
    aria-labelledby="site-nav-page-label"
  >
    <p class="site-nav-label is-current" id="site-nav-page-label">This page</p>
    {
      thisPageLinks.map((item) => (
        <a
          href={item.href}
          class:list={[item.cta && "site-header-cta"]}
          data-astro-reload={shouldReloadNavLink(item.href) || undefined}
          aria-current={isCurrentNavPage(item.href, pathname) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>
  {
    siteLinks.length > 0 && (
      <div
        class="site-nav-group site-nav-group--site"
        role="group"
        aria-labelledby="site-nav-elsewhere-label"
      >
        <p class="site-nav-label" id="site-nav-elsewhere-label">Elsewhere</p>
        {
          siteLinks.map((item) => (
            <a
              href={item.href}
              data-astro-reload={shouldReloadNavLink(item.href) || undefined}
              aria-current={
                isCurrentNavPage(item.href, pathname) ? "page" : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </div>
    )
  }
</nav>
