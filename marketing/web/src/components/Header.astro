---
import { Image } from "astro:assets";
import type { SiteFeatures } from "../types/features";
import { siteConfig } from "../config/site";
import { headerLogo } from "../lib/hero-assets";

export interface NavItem {
  href: string;
  label: string;
}

interface Props {
  /** Home menu. Omitted when `items` supplies a page menu. */
  features?: SiteFeatures;
  showMenuTease?: boolean;
  /** Page menu. When set, replaces the home links. */
  items?: NavItem[];
  /**
   * Same as home: hamburger only until scroll, then the bar, wordmark,
   * and desktop quick links slide in.
   */
  collapsed?: boolean;
  logoHref?: string;
}

const {
  features,
  showMenuTease = false,
  items,
  collapsed = false,
  logoHref = collapsed ? "/" : "#hero",
} = Astro.props;
---

<header
  class:list={["site-header", collapsed && "site-header--collapsed"]}
  id="site-header"
>
  <a
    href={logoHref}
    class="site-header-logo"
    aria-label={collapsed ? "Gwenda home" : "Gwenda"}
  >
    <Image {...headerLogo} alt="" class="site-header-logo-img" />
  </a>

  <button
    type="button"
    class="site-header-menu-btn"
    id="site-header-menu-btn"
    aria-expanded="false"
    aria-controls="site-header-nav"
    aria-label="Open menu"
  >
    <span class="site-header-menu-icon" aria-hidden="true"></span>
  </button>
</header>

<nav class="site-header-nav" id="site-header-nav">
  {
    items ? (
      items.map((item) => <a href={item.href}>{item.label}</a>)
    ) : (
      <>
        <a href="#story">Story</a>
        {/* Dedicated /menu and /whats-on URLs help Google form organic sitelinks. */}
        {(showMenuTease || features?.showMenu) && <a href="/menu">Menu</a>}
        {features?.showTeam && <a href="#team">Who we are</a>}
        <a href="/whats-on">What's on</a>
        <a href="/contact">Contact</a>
        <a href="#list" class="site-header-cta">
          {siteConfig.copy.signupNavCta}
        </a>
      </>
    )
  }
</nav>
