---
import { Image } from "astro:assets";
import type { SiteFeatures } from "../types/features";
import { siteConfig } from "../config/site";
import { headerLogo } from "../lib/hero-assets";
import SiteMenu from "./SiteMenu.astro";
import {
  homeAnchorItems,
  isCurrentNavPage,
  navPathname,
  shouldReloadNavLink,
  sitePageLinks,
} from "../lib/site-nav.js";

export interface NavItem {
  href: string;
  label: string;
  /** Gold join link, same as the home menu. */
  cta?: boolean;
}

interface Props {
  /** Home sections. Omitted when `items` supplies this page's menu. */
  features?: SiteFeatures;
  showMenuTease?: boolean;
  /** This page's anchors and child pages. Home is the wordmark. */
  items?: NavItem[];
  /**
   * Subpage: wordmark waits for scroll. The hamburger stays either way.
   */
  collapsed?: boolean;
  /**
   * Home: the hero already shows the wordmark. Mark this in the first HTML
   * so the bar logo is hidden before paint. Adding the class from script
   * after paint runs the slide-away transition.
   */
  awaitsHero?: boolean;
  logoHref?: string;
  /** Used to drop the current route from the other pages. */
  pathname?: string;
}

const {
  features,
  showMenuTease = false,
  items,
  collapsed = false,
  awaitsHero = false,
  logoHref = collapsed ? "/" : "#hero",
  pathname = Astro.url.pathname,
} = Astro.props;

const showMenuLink = items
  ? true
  : Boolean(showMenuTease || features?.showMenu);
const pageLinks =
  items ??
  homeAnchorItems({
    showMenu: Boolean(showMenuTease),
    showGallery: Boolean(features?.showGallery),
    signupLabel: siteConfig.copy.signupNavCta,
  });
const homeLink = pageLinks.find((item) => navPathname(item.href) === "/");
const thisPageLinks = pageLinks.filter((item) => item !== homeLink);
const pagePaths = new Set(
  pageLinks.map((item) => navPathname(item.href)).filter(Boolean),
);
const siteLinks = sitePageLinks(pathname, { showMenu: showMenuLink }).filter(
  (item) => !pagePaths.has(navPathname(item.href)),
);
/** A long chapter list never fits beside the wordmark. Keep the hamburger. */
const overlayOnly = pageLinks.length > 6;
---

<header
  class:list={[
    "site-header",
    collapsed && "site-header--collapsed",
    awaitsHero && "awaits-hero",
    !overlayOnly && siteLinks.length === 0 && "site-header--bar-only",
  ]}
  id="site-header"
>
  <a
    href={logoHref}
    class="site-header-logo"
    aria-label={collapsed ? "Gwenda home" : "Gwenda"}
  >
    <Image {...headerLogo} alt="" class="site-header-logo-img" />
  </a>

  <button
    type="button"
    class="site-header-menu-btn"
    id="site-header-menu-btn"
    aria-expanded="false"
    aria-controls="site-header-nav"
    aria-label="Open menu"
  >
    <span class="site-header-menu-icon" aria-hidden="true"></span>
  </button>
  {
    !overlayOnly && thisPageLinks.length > 0 && (
      <nav class="site-header-bar" aria-label="This page">
        {
          thisPageLinks.map((item) => (
            <a
              href={item.href}
              class:list={[item.cta && "site-header-cta"]}
              data-astro-reload={shouldReloadNavLink(item.href) || undefined}
              aria-current={isCurrentNavPage(item.href, pathname) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    )
  }
</header>

<SiteMenu
  homeLink={{ href: "/", label: "Home" }}
  pageLinks={thisPageLinks}
  siteLinks={siteLinks}
  pathname={pathname}
  pageLinksInHeader={!overlayOnly}
/>
