---
import { Image } from "astro:assets";
import type { SiteFeatures } from "../types/features";
import { siteConfig } from "../config/site";
import { headerLogo } from "../lib/hero-assets";

interface Props {
  features: SiteFeatures;
  showMenuTease?: boolean;
}

const { features, showMenuTease = false } = Astro.props;
---

<header class="site-header" id="site-header">
  <a href="#hero" class="site-header-logo" aria-label="Gwenda">
    <Image {...headerLogo} alt="" class="site-header-logo-img" />
  </a>

  <button
    type="button"
    class="site-header-menu-btn"
    id="site-header-menu-btn"
    aria-expanded="false"
    aria-controls="site-header-nav"
    aria-label="Open menu"
  >
    <span class="site-header-menu-icon" aria-hidden="true"></span>
  </button>
</header>

<nav class="site-header-nav" id="site-header-nav">
  <a href="#story">Story</a>
  {/* Dedicated /menu and /whats-on URLs help Google form organic sitelinks. */}
  {(showMenuTease || features.showMenu) && <a href="/menu">Menu</a>}
  {features.showTeam && <a href="#team">Who we are</a>}
  <a href="/whats-on">What's on</a>
  <a href="/contact">Contact</a>
  <a href="#list" class="site-header-cta">{siteConfig.copy.signupNavCta}</a>
</nav>
