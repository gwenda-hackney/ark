---
/**
 * What a form says once it's sent (/contact/<slug>/submitted): "Got it", or
 * "Check your email" while a confirm link is out. One block for every form;
 * the script fills in the words from this visit's submission.
 */
import type { FormPage } from "../lib/sanity/forms";

interface Props {
  form: FormPage;
  /** Initial title before client hydrates from session. */
  title?: string;
  /** Initial message before client hydrates from session. */
  message?: string;
}

const {
  form,
  title = "One moment…",
  message = "Loading your confirmation.",
} = Astro.props;
---

<div
  class="ch-sent"
  id="contact-success"
  data-form-slug={form.slug}
  data-success-title={form.successTitle}
  data-success-message={form.successMessage}
  data-verify-pending-title={form.verifyPendingTitle ?? "Check your email"}
  data-verify-pending-message={form.verifyPendingMessage ??
    "We sent a link to {email}. Open it to finish (valid for 48 hours)."}
>
  <header class="ch-page-head">
    <div>
      <p class="ch-caps ch-sent-form">{form.eyebrow?.trim() || form.heading}</p>
      <h1 class="ch-title" id="contact-success-title">{title}</h1>
    </div>
  </header>
  <p class="ch-sent-message" id="contact-success-message">{message}</p>
  <div class="ch-sent-verify" id="contact-verify-actions" hidden>
    <button type="button" class="ch-btn" id="contact-wrong-email">
      Wrong address?
    </button>
    <div class="ch-sent-resend ch-form" id="contact-resend" hidden>
      <div class="gw-field">
        <label for="contact-resend-email">Email</label>
        <input
          type="email"
          id="contact-resend-email"
          name="resendEmail"
          autocomplete="email"
        />
      </div>
      <button
        type="button"
        class="ch-btn ch-btn--solid"
        id="contact-resend-submit"
      >
        Resend link
      </button>
      <p
        class="contact-error"
        id="contact-resend-error"
        role="alert"
        aria-live="polite"
        hidden
      >
      </p>
    </div>
  </div>
  <div class="ch-sent-actions" id="contact-success-actions" hidden>
    <a href="/" class="ch-btn ch-btn--solid" id="contact-success-home">
      Back to Gwenda
    </a>
    <a href={`/contact/${form.slug}`} class="ch-btn" id="contact-success-retry">
      Back to the form
    </a>
  </div>
</div>
