---
interface Props {
  label?: string;
  name?: string;
}

const { label = "", name = "" } = Astro.props;
const who = String(name || "").trim();
const kicker = String(label || "").trim() || "Next at Gwenda";
---

{
  who ? (
    <figcaption class="event-media-caption">
      <span class="event-media-caption-kicker">{kicker}</span>
      <span class="event-media-caption-name">{who}</span>
    </figcaption>
  ) : null
}
