---
import { Image } from "astro:assets";
import { siteConfig } from "../config/site";
import { heroBackground, heroLogo } from "../lib/hero-assets";
---

<section class="hero" id="hero">
  <div class="hero-media">
    <div class="hero-bg" aria-hidden="true"></div>
    <Image
      {...heroBackground}
      alt=""
      class="hero-image"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
    <div class="hero-vignette" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    <h1 class="visually-hidden">{siteConfig.seoTitle}</h1>
    <Image
      {...heroLogo}
      alt="Gwenda"
      class="hero-logo enter-stagger enter-stagger--auto"
      loading="eager"
      fetchpriority="high"
    />

    <p class="hero-location enter-stagger enter-stagger--auto">{siteConfig.tagline}</p>
    <a href="#story" class="btn btn-primary enter-stagger enter-stagger--auto" id="hero-cta"
      >{siteConfig.copy.heroCta}</a
    >
  </div>

  <a href="#story" class="hero-scroll-hint" aria-label="Scroll to story">
    <span class="hero-scroll-chevron" aria-hidden="true"></span>
  </a>
</section>

<noscript>
  <style>
    .hero-image,
    .hero-overlay,
    .hero-vignette {
      opacity: 1 !important;
    }
  </style>
</noscript>
