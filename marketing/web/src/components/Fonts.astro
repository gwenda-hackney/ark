---
/**
 * Fonts load from their @font-face rules (styles/fonts.css for the old look,
 * styles/chart.css for the Chart), all `font-display: swap`: text shows at
 * once in a fallback and takes its face when it arrives. None is preloaded:
 * a preloaded font is fetched ahead of everything else, and on home that
 * held up the logo (home-first-paint.test.js keeps it so).
 */
---

<script>
  import { initFontsReady } from "../scripts/fonts-ready.js";
  initFontsReady();
</script>
