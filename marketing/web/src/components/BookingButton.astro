---
import { siteConfig } from "../config/site";
import { bookingUrl } from "../config/booking";
import { fetchSiteSettings } from "../lib/sanity/site-settings";

interface Props {
  variant?: "primary" | "ghost" | "float";
  class?: string;
}

const { variant = "primary", class: className } = Astro.props;
const { bookingEnabled } = await fetchSiteSettings();
---

{
  bookingEnabled && (
    <a
      href={bookingUrl}
      class:list={[
        "booking-cta",
        variant === "float" ? "booking-float" : "btn",
        variant === "primary" && "btn-primary",
        variant === "ghost" && "btn-ghost",
        className,
      ]}
      target="_blank"
      rel="noopener noreferrer"
    >
      {siteConfig.copy.bookingCta}
    </a>
  )
}
