---
import type { SiteMode } from "../types/features";
import { siteConfig } from "../config/site";
import { getCopy } from "../config/copy";
import { openingDate } from "../config/opening";
import DissolveReveal from "./DissolveReveal.astro";
import Team from "./Team.astro";

interface Props {
  mode: SiteMode;
  showTeam?: boolean;
}

const { mode, showTeam = false } = Astro.props;
const copy = getCopy(mode);
const hasStoryBody =
  copy.storyBody.length > 0 || copy.storyClosing || copy.storyOpening;
const openingYear = new Date(openingDate).getFullYear();
const closingRevealDelay = `${copy.storyBody.length * 0.1}s`;
const openingRevealDelay = `${(copy.storyBody.length + (copy.storyClosing ? 1 : 0)) * 0.1}s`;
---

<section class="story section" id="story">
  <div class="container">
    <a href="#hero" class="story-scroll-hint" aria-label="Back to the top">
      <span class="story-scroll-chevron" aria-hidden="true"></span>
    </a>
    <div class="story-grid story-grid--split">
      <p
        class="section-eyebrow story-grid-eyebrow dissolve-reveal-eyebrow reveal"
      >
        Est.&nbsp;
        <DissolveReveal
          id="story-year"
          antiquated={siteConfig.openingRoman}
          modern={String(openingYear)}
          emphasis
        />
      </p>
      <div class="story-grid-left section-intro reveal">
        <h2>{siteConfig.copy.storyHeading}</h2>
        <p class="section-lead">{siteConfig.copy.storyLead}</p>
        {showTeam && <Team heading="Where we started" />}
      </div>
      {
        hasStoryBody && (
          <div class="story-grid-right story-body">
            {copy.storyBody.map((paragraph, index) => (
              <p
                class="reveal reveal-stagger"
                style={`--reveal-delay: ${index * 0.1}s`}
              >
                {paragraph}
              </p>
            ))}
            {copy.storyClosing && (
              <p
                class="story-closing reveal reveal-stagger"
                style={`--reveal-delay: ${closingRevealDelay}`}
              >
                {copy.storyClosing}
              </p>
            )}
            {copy.storyOpening && (
              <p
                class="story-opening reveal reveal-stagger"
                style={`--reveal-delay: ${openingRevealDelay}`}
              >
                {copy.storyOpening}
              </p>
            )}
            {showTeam && <Team heading="What comes next" />}
          </div>
        )
      }
    </div>
  </div>
</section>
