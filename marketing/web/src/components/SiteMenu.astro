---
import { isCurrentNavPage, shouldReloadNavLink } from "../lib/site-nav.js";

interface Link {
  href: string;
  label: string;
  cta?: boolean;
}

interface Props {
  homeLink?: Link | null;
  pageLinks: Link[];
  siteLinks: Link[];
  pathname: string;
  /** These links are already in the header bar, so the overlay skips them on wide screens. */
  pageLinksInHeader?: boolean;
}

const {
  homeLink = null,
  pageLinks,
  siteLinks,
  pathname,
  pageLinksInHeader = false,
} = Astro.props;
const pageAnchorsOnly = pageLinks.every((item) => item.href.startsWith("#"));
---

<nav
  class:list={[
    "site-menu",
    "site-header-nav",
    pageLinksInHeader && "site-header-nav--bar",
  ]}
  id="site-header-nav"
  aria-label="Menu"
>
  {
    homeLink && (
      <a
        href={homeLink.href}
        class="site-nav-home"
        data-astro-reload={shouldReloadNavLink(homeLink.href) || undefined}
        aria-current={
          isCurrentNavPage(homeLink.href, pathname) ? "page" : undefined
        }
      >
        {homeLink.label}
      </a>
    )
  }
  {
    pageLinks.length > 0 && (
      <div
        class:list={[
          "site-nav-group",
          "site-nav-group--page",
          pageAnchorsOnly && "site-nav-group--anchors",
        ]}
        role="group"
        aria-labelledby="site-nav-page-label"
      >
        <p class="site-nav-label is-current" id="site-nav-page-label">
          This page
        </p>
        {pageLinks.map((item) => (
          <a
            href={item.href}
            class:list={[
              item.cta && "site-header-cta",
              item.href.startsWith("#") && "site-nav-anchor",
            ]}
            data-astro-reload={shouldReloadNavLink(item.href) || undefined}
            aria-current={
              isCurrentNavPage(item.href, pathname) ? "page" : undefined
            }
          >
            {item.label}
          </a>
        ))}
      </div>
    )
  }
  {
    siteLinks.length > 0 && (
      <div class="site-nav-group site-nav-group--site">
        {siteLinks.map((item) => (
          <a
            href={item.href}
            data-astro-reload={shouldReloadNavLink(item.href) || undefined}
            aria-current={
              isCurrentNavPage(item.href, pathname) ? "page" : undefined
            }
          >
            {item.label}
          </a>
        ))}
      </div>
    )
  }
</nav>
