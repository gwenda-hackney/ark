---
import Header, { type NavItem } from "./Header.astro";
import SubpageChrome from "./SubpageChrome.astro";

interface Props {
  /** Extra classes on `<main>` for page-specific layout hooks. */
  class?: string;
  /** Extra classes on the inner `.container`. */
  innerClass?: string;
  /** Back chip destination. */
  href?: string;
  label?: string;
  /** Wordmark home link. */
  homeHref?: string;
  /**
   * `stack` — padded single column (default).
   * `split` — full-bleed aside + content column (Play).
   */
  layout?: "stack" | "split";
  /**
   * @deprecated Prefer `layout="split"`.
   */
  flush?: boolean;
  /** Hide logo + back (rare). */
  showChrome?: boolean;
  /**
   * Collapsed hamburger menu. When set, replaces the back chip with the
   * home header chrome and these page links.
   */
  navItems?: NavItem[];
}

const {
  class: className,
  innerClass,
  href = "/",
  label = "← Back",
  homeHref = "/",
  layout,
  flush = false,
  showChrome = true,
  navItems,
} = Astro.props;

const isSplit = layout === "split" || flush;
---

<main class:list={["subpage", isSplit && "subpage--split", className]}>
  {
    showChrome && navItems ? (
      <Header items={navItems} collapsed logoHref={homeHref} />
    ) : showChrome ? (
      <SubpageChrome href={href} label={label} homeHref={homeHref} />
    ) : null
  }
  <slot name="aside" />
  <div class:list={["container", "subpage-inner", innerClass]}>
    <slot />
  </div>
</main>
