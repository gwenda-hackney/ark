---
import Header, { type NavItem } from "./Header.astro";
import { withHome } from "../lib/site-nav.js";

interface Props {
  /** Extra classes on `<main>` for page-specific layout hooks. */
  class?: string;
  /** Extra classes on the inner `.container`. */
  innerClass?: string;
  /**
   * @deprecated The wordmark goes home. Pass `navItems` for a page menu.
   */
  href?: string;
  /** @deprecated */
  label?: string;
  /** Wordmark home link. */
  homeHref?: string;
  /**
   * `stack` — padded single column (default).
   * `split` — full-bleed aside + content column (Play).
   */
  layout?: "stack" | "split";
  /**
   * @deprecated Prefer `layout="split"`.
   */
  flush?: boolean;
  /** Hide logo + back (rare). */
  showChrome?: boolean;
  /**
   * This page's menu: Home, then anchors and subpages.
   * Do not pass the home page links.
   */
  navItems?: NavItem[];
}

const {
  class: className,
  innerClass,
  homeHref = "/",
  layout,
  flush = false,
  showChrome = true,
  navItems = withHome(),
} = Astro.props;

const isSplit = layout === "split" || flush;
---

<main class:list={["subpage", isSplit && "subpage--split", className]}>
  {
    showChrome ? (
      <Header
        items={navItems}
        collapsed
        logoHref={homeHref}
        pathname={Astro.url.pathname}
      />
    ) : null
  }
  <slot name="aside" />
  <div class:list={["container", "subpage-inner", innerClass]}>
    <slot />
  </div>
</main>
