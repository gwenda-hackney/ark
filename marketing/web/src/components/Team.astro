---
import { siteConfig } from "../config/site";
import { formPublicPath, PLAY_FORM_SLUG } from "../lib/form-paths";

interface Props {
  heading: string;
}

const { heading } = Astro.props;
const sections = siteConfig.copy.teamSections.filter(
  (section) => !section.aside && section.heading === heading,
);
---

<div class="story-team">
  <div class="story-team-blocks">
    {
      sections.map((section) => (
        <article class="story-team-block reveal">
          <h3>{section.heading}</h3>
          {section.paragraphs.map((paragraph, index) => (
            <p>
              {paragraph}
              {section.showLinks && index === section.paragraphs.length - 1 && (
                <>
                  {" "}
                  See <a href="/whats-on">What's on</a>, and the{" "}
                  <a href="/artists/current">featured artist</a>. If that is
                  you, <a href={formPublicPath(PLAY_FORM_SLUG)}>write to us</a>.
                </>
              )}
            </p>
          ))}
        </article>
      ))
    }
  </div>
</div>
