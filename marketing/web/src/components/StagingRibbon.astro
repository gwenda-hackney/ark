---
import { isStaging } from "../config/env";
import { buildLabel } from "../config/build";

interface Props {
  /** Passwordless share is only for people already inside the site. */
  share?: boolean;
}

const { share = true } = Astro.props;

/**
 * Which environment this is. Hosted builds set PUBLIC_ENV_LABEL (the dev
 * website says "Dev" / "Dev · preview"); gwenda-staging is prod's preview
 * (docs/sanity.md). A local dev server shows the Gwenda Dev copy, its live
 * dataset under `npm run web:dev:live`.
 */
const envLabel =
  import.meta.env.PUBLIC_ENV_LABEL ||
  (import.meta.env.DEV
    ? process.env.SANITY_DATASET === "production"
      ? "Dev · live"
      : "Dev"
    : "Preview");
---

{
  isStaging && (
    <div
      class="staging-ribbon"
      role="status"
      aria-label={`${envLabel} environment. Build ${buildLabel()}.`}
      title={`Build ${buildLabel()}`}
    >
      {share ? (
        <button
          type="button"
          class="staging-ribbon-share"
          id="staging-share"
          data-env-label={envLabel}
          title="Copy a link that unlocks this site for the recipient"
        >
          <span data-staging-share-label>{envLabel}</span>
        </button>
      ) : (
        <span>{envLabel}</span>
      )}
    </div>
  )
}

<script>
  // Keep this script a direct child of the component. Astro does not bundle
  // a <script> nested in {isStaging && ...}; the import is then sent raw
  // and the share click never runs.
  import { initStagingShare } from "../scripts/staging-share.js";

  if (import.meta.env.PUBLIC_IS_STAGING === "true") {
    initStagingShare();
    document.addEventListener("astro:page-load", initStagingShare);
  }
</script>
