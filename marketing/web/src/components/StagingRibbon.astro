---
import { isStaging } from "../config/env";
import { buildLabel } from "../config/build";

interface Props {
  /** Passwordless share is only for people already inside the site. */
  share?: boolean;
}

const { share = true } = Astro.props;
---

{
  isStaging && (
    <div
      class="staging-ribbon"
      role="status"
      aria-label={`Staging environment. Build ${buildLabel()}.`}
      title={`Build ${buildLabel()}`}
    >
      {share ? (
        <button
          type="button"
          class="staging-ribbon-share"
          id="staging-share"
          title="Copy a link that unlocks staging for the recipient"
        >
          <span data-staging-share-label>Staging</span>
        </button>
      ) : (
        <span>Staging</span>
      )}
    </div>
  )
}

{
  isStaging && (
    <script>
      import { initStagingShare } from "../scripts/staging-share.js";

      initStagingShare();
      document.addEventListener("astro:page-load", initStagingShare);
    </script>
  )
}
