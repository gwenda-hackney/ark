---
import { eventPageLink } from "../data/events";

type Props = {
  url?: string | null;
};

const link = eventPageLink(Astro.props.url);
---

{
  link ? (
    <p class="event-page-link">
      <a href={link.href} rel="noopener noreferrer" target="_blank">
        {link.label}
      </a>
    </p>
  ) : null
}
