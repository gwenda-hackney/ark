---
import EventImageCaption from "./EventImageCaption.astro";
import EventNightSchedule from "./EventNightSchedule.astro";
import EventPageLink from "./EventPageLink.astro";
import FollowUpdatesLink from "./FollowUpdatesLink.astro";
import {
  eventDescriptionParagraphs,
  eventPageLink,
  formatEventDiaryDate,
  formatEventRecurrence,
  formatEventSpan,
} from "../data/events";
import {
  formatShortEventDate,
  seriesCardNextLine,
} from "../../functions/_lib/event-series.js";

type DiaryEvent = {
  title?: string;
  href?: string;
  pageUrl?: string;
  regular?: boolean;
  schedule?: string;
  scheduleLabel?: string;
  datesPending?: boolean;
  recurrence?: string;
  date?: string;
  startTime?: string;
  endTime?: string;
  time?: string;
  hostName?: string;
  hostDate?: string;
  hostThisWeek?: boolean;
  hostHref?: string;
  thisWeekName?: string;
  thisWeekDate?: string;
  upcomingName?: string;
  upcomingDate?: string;
  nightCount?: number;
  offer?: string;
  description?: string;
  nightSchedule?: Array<{
    label?: string;
    startTime?: string;
    endTime?: string;
  }>;
  imageCaption?: string;
  imageCaptionName?: string;
  heroImage?: { alt?: string; objectPosition?: string };
  heroImageAlt?: string;
};

type Props = {
  event: DiaryEvent;
  image?: string | null;
  eager?: boolean;
};

const { event, image = null, eager = false } = Astro.props as Props;
const regular = Boolean(event.regular);
const href = String(event.href || "").trim() || "/whats-on";
const external = eventPageLink(event.pageUrl);
const datesPending = Boolean(event.datesPending);
// A link inside the card: the card becomes a div with a hit area behind it.
const linked = Boolean(external) || datesPending;
const Card = linked ? "div" : "a";
const cardClass = `event-card event-card--series${linked ? " event-card--linked" : ""}${regular ? " event-card--regular" : ""}`;
const cardLabel = [
  event.title,
  event.imageCaptionName ? `Hosting ${event.imageCaptionName}` : "",
  event.hostDate
    ? `${event.hostThisWeek ? "This week, " : ""}${formatShortEventDate(event.hostDate)}`
    : "",
  event.thisWeekName ? `This week, ${event.thisWeekName}` : "",
  event.upcomingName ? `Next, ${event.upcomingName}` : "",
]
  .filter(Boolean)
  .join(". ");
const whenLabel = regular
  ? formatEventRecurrence(
      String(event.scheduleLabel || event.recurrence || "").trim(),
    )
  : String(event.scheduleLabel || "").trim();
const nextLine = seriesCardNextLine(
  event,
  formatEventSpan(event.startTime, event.endTime, event.time),
);
---

<Card
  class={cardClass}
  href={linked ? undefined : href}
  aria-label={linked ? undefined : cardLabel}
>
  {
    linked ? (
      <a class="event-card-hit" href={href} aria-label={cardLabel} />
    ) : null
  }
  {
    image ? (
      <figure class="event-media">
        <img
          class="event-hero"
          src={image}
          alt={
            event.heroImage?.alt ||
            event.heroImageAlt ||
            event.imageCaptionName ||
            event.title
          }
          loading={eager ? "eager" : "lazy"}
          style={
            event.heroImage?.objectPosition
              ? `object-position: ${event.heroImage.objectPosition}`
              : undefined
          }
        />
        <EventImageCaption
          label={event.imageCaption}
          name={event.imageCaptionName}
        />
      </figure>
    ) : (
      <div class="event-media event-media--empty" aria-hidden="true">
        <span>Gwenda</span>
      </div>
    )
  }
  <article class="event-copy">
    <p class="event-date">
      {
        whenLabel ? (
          <span>{whenLabel}</span>
        ) : (
          <time datetime={event.date}>{formatEventDiaryDate(event.date || "")}</time>
        )
      }
      {nextLine ? <span class="event-time">{nextLine}</span> : null}
    </p>
    <h2 class="event-title">{event.title}</h2>
    {
      event.hostName && !event.hostThisWeek ? (
        <p
          class="event-next"
          data-href={event.hostHref || undefined}
          role={event.hostHref ? "link" : undefined}
          tabindex={event.hostHref ? 0 : undefined}
        >
          <span class="event-next-label">Coming up</span>
          {event.hostDate ? (
            <>
              <span class="event-next-sep" aria-hidden="true">
                ·
              </span>
              <time datetime={event.hostDate}>
                {formatShortEventDate(event.hostDate)}
              </time>
            </>
          ) : null}
          <span class="event-next-sep" aria-hidden="true">
            ·
          </span>
          <span class="event-next-name">{event.hostName}</span>
        </p>
      ) : null
    }
    {
      event.hostThisWeek && event.hostName ? (
        <p class="event-next">
          <span class="event-next-label">This week</span>
          {event.hostDate ? (
            <>
              <span class="event-next-sep" aria-hidden="true">
                ·
              </span>
              <time datetime={event.hostDate}>
                {formatShortEventDate(event.hostDate)}
              </time>
            </>
          ) : null}
          <span class="event-next-sep" aria-hidden="true">
            ·
          </span>
          <span class="event-next-name">{event.hostName}</span>
        </p>
      ) : null
    }
    {event.offer ? <p class="event-offer">{event.offer}</p> : null}
    <EventNightSchedule slots={event.nightSchedule} />
    {
      event.description ? (
        <div class="event-description">
          {eventDescriptionParagraphs(event.description).map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      ) : null
    }
    <EventPageLink url={event.pageUrl} />
    {datesPending ? <FollowUpdatesLink /> : null}
    {
      event.thisWeekName || event.upcomingName || (event.nightCount || 0) > 1 ? (
        <div class="event-follow">
          {event.thisWeekName ? (
            <p class="event-next">
              <span class="event-next-label">This week</span>
              {event.thisWeekDate ? (
                <>
                  <span class="event-next-sep" aria-hidden="true">
                    ·
                  </span>
                  <time datetime={event.thisWeekDate}>
                    {formatShortEventDate(event.thisWeekDate)}
                  </time>
                </>
              ) : null}
              <span class="event-next-sep" aria-hidden="true">
                ·
              </span>
              <span class="event-next-name">{event.thisWeekName}</span>
            </p>
          ) : null}
          {event.upcomingName ? (
            <p class="event-next">
              <span class="event-next-label">Next</span>
              {event.upcomingDate ? (
                <>
                  <span class="event-next-sep" aria-hidden="true">
                    ·
                  </span>
                  <time datetime={event.upcomingDate}>
                    {formatShortEventDate(event.upcomingDate)}
                  </time>
                </>
              ) : null}
              <span class="event-next-sep" aria-hidden="true">
                ·
              </span>
              <span class="event-next-name">{event.upcomingName}</span>
            </p>
          ) : null}
          {(event.nightCount || 0) > 1 ? (
            <p class="event-more-dates">More dates and info</p>
          ) : null}
        </div>
      ) : null
    }
  </article>
</Card>
