---
import { Image } from "astro:assets";
import { siteConfig } from "../config/site";
import { headerLogo } from "../lib/hero-assets";
---

<header class="site-header site-header--invite visible" id="site-header">
  <a href={siteConfig.domain} class="site-header-logo" aria-label="Gwenda">
    <Image
      {...headerLogo}
      alt=""
      class="site-header-logo-img"
      loading="eager"
    />
  </a>
</header>
