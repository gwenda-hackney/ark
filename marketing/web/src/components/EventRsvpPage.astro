---
import "../styles/global.css";
import SocialMeta from "./SocialMeta.astro";
import Fonts from "./Fonts.astro";
import PreviewRibbon from "./PreviewRibbon.astro";
import InviteFlipCardShell from "./InviteFlipCardShell.astro";
import RsvpPersonalForm from "./RsvpPersonalForm.astro";
import { siteConfig } from "../config/site";

export interface EventRsvpMeta {
  title: string;
  description: string;
  url: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  imageAlt?: string;
}

interface Props {
  meta: EventRsvpMeta;
  occurrenceSlug?: string;
}

const { meta, occurrenceSlug = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={meta.description} />
    <title>{meta.title}</title>
    <SocialMeta
      title={meta.title}
      description={meta.description}
      url={meta.url}
      image={meta.image}
      imageWidth={meta.imageWidth}
      imageHeight={meta.imageHeight}
      imageType={meta.imageType}
      imageAlt={meta.imageAlt}
    />
    <Fonts />
    <link rel="icon" href={siteConfig.brand.faviconPath} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes={`${siteConfig.brand.faviconSize}x${siteConfig.brand.faviconSize}`}
      href={siteConfig.brand.faviconPngPath}
    />
  </head>
  <body data-occurrence-slug={occurrenceSlug}>
    <PreviewRibbon />
    <div class="grain" aria-hidden="true"></div>
    <main>
      <section class="event-rsvp event-rsvp--viewport section">
        <div class="event-rsvp-inner">
          <div id="rsvp-loading" class="rsvp-state">
            <div class="invite-loader" role="status" aria-live="polite">
              <span class="invite-loader-mark" aria-hidden="true"></span>
              <p class="event-rsvp-loading">Opening your invitation</p>
            </div>
          </div>

          <div id="rsvp-error" class="rsvp-state rsvp-blocked reveal" hidden>
            <header class="section-intro">
              <p class="rsvp-blocked-eyebrow">Gwenda</p>
              <h1>This invitation isn't open</h1>
              <p class="section-lead" id="rsvp-error-text">
                This invitation link isn't valid or has expired.
              </p>
              <p class="section-lead">
                If someone invited you, ask them for their personal link and open it in full.
              </p>
            </header>
          </div>

          <InviteFlipCardShell>
            <div id="rsvp-form-wrap" class="rsvp-state" hidden>
              <header class="event-rsvp-intro" id="rsvp-event-header">
                <div class="event-rsvp-hero-wrap" id="rsvp-hero-personal-wrap" hidden>
                  <img
                    id="rsvp-hero-personal"
                    src=""
                    alt=""
                    class="event-rsvp-hero"
                    width="960"
                    height="360"
                    loading="eager"
                  />
                </div>
                <p class="invite-card-badge" id="rsvp-event-eyebrow-personal" hidden>
                  Exclusive invitation
                </p>
                <h1 class="invite-card-headline" id="rsvp-event-title-personal"></h1>
                <p class="invite-card-meta" id="rsvp-event-date-personal" hidden></p>
                <p class="event-offer" id="rsvp-event-offer-personal" hidden></p>
                <p class="event-rsvp-venue" id="rsvp-event-venue-wrap" hidden>
                  <a
                    id="rsvp-event-maps-link"
                    href={siteConfig.location.mapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {siteConfig.location.addressShort}
                  </a>
                </p>
                <p class="invite-card-body" id="rsvp-event-description-personal" hidden></p>
              </header>

              <RsvpPersonalForm />
            </div>
          </InviteFlipCardShell>
        </div>
      </section>
    </main>
    <script>
      import { initEventRsvp } from "../scripts/event-rsvp.js";
      initEventRsvp();
    </script>
  </body>
</html>
