---
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";
import { siteConfig } from "../config/site";
import { isPreview, previewOrigin } from "../config/env";
import SocialMeta from "../components/SocialMeta.astro";
import StructuredData from "../components/StructuredData.astro";
import Fonts from "../components/Fonts.astro";
import PreviewRibbon from "../components/PreviewRibbon.astro";
import BookingButton from "../components/BookingButton.astro";
import { colors } from "../config/colors";

const themeColor = colors.bg;

interface Props {
  title?: string;
  description?: string;
  socialTitle?: string;
  socialDescription?: string;
  /** Floating Book a table CTA. Off on form pages. */
  showBooking?: boolean;
  /** Keep draft look-pages out of search results. */
  noindex?: boolean;
}

const {
  title = siteConfig.seo.home.title,
  description = siteConfig.seo.home.description,
  socialTitle,
  socialDescription,
  showBooking = true,
  noindex = false,
} = Astro.props;

const siteOrigin = isPreview
  ? previewOrigin
  : siteConfig.domain;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
---

<!doctype html>
<html
  lang="en"
  data-site-env={import.meta.env.DEV ? "local" : isPreview ? "preview" : "production"}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="geo.region" content="GB-LND" />
    <meta name="geo.placename" content="Hackney Wick, London" />
    <meta
      name="geo.position"
      content={`${siteConfig.location.geo.latitude};${siteConfig.location.geo.longitude}`}
    />
    <meta
      name="ICBM"
      content={`${siteConfig.location.geo.latitude}, ${siteConfig.location.geo.longitude}`}
    />
    {
      isPreview || noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }
    <SocialMeta
      title={socialTitle ?? title}
      description={socialDescription ?? description}
      url={canonicalUrl}
    />
    <StructuredData
      url={canonicalUrl}
      title={title}
      description={description}
    />

    <script is:inline>
      // Runs before first paint: on back/forward, render in final state so the
      // browser's native scroll restoration lands without a jump.
      try {
        const nav = performance.getEntriesByType("navigation")[0];
        if (nav && nav.type === "back_forward") {
          document.documentElement.classList.add(
            "navigation-restore",
            "fonts-ready",
          );
        }
      } catch {
        // Older browsers without navigation timing: nothing to restore.
      }
    </script>

    <Fonts />
    <ViewTransitions />
    <link rel="icon" href={siteConfig.brand.faviconPath} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes={`${siteConfig.brand.faviconSize}x${siteConfig.brand.faviconSize}`}
      href={siteConfig.brand.faviconPngPath}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={siteConfig.brand.appleTouchIconPath}
    />

    <slot name="head" />
  </head>
  <body>
    <PreviewRibbon />
    <div class="grain" aria-hidden="true"></div>
    <slot />
    {showBooking ? <BookingButton variant="float" /> : null}
    <script src="../scripts/main.js"></script>
  </body>
</html>
