---
/**
 * Every gallery photo (#240). Home shows the newest few and links here.
 * One wall: the venue's own and the events' (each event's gallery in ops,
 * its newest few) mixed together (lib/photos.js photosPageWall), a photo
 * from an event or a pop-up kitchen wearing its name on a tag.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import PhotoWall from "../components/chart/PhotoWall.astro";
import { eventPhotos, galleryPhotos } from "../lib/photo-sources";
import { photosPageWall } from "../lib/photos.js";

const { events } = await eventPhotos();
/** A picture already on the venue's wall isn't shown twice. */
const photos = photosPageWall(await galleryPhotos(), events);
---

<BaseLayout
  title="Photos · Gwenda"
  description="Photos from Gwenda in Hackney Wick: the food, the room, the terrace, the decks and our nights."
  showBooking={false}
>
  <ChartPage
    class="ch-photos-page ch-photos"
    title="Seen at Gwenda"
    lead="The food, the room, the terrace, the decks and our nights."
  >
    <PhotoWall photos={photos} tags />
  </ChartPage>
</BaseLayout>
