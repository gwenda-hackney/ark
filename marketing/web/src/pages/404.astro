---
/**
 * A wrong address (#240): "Nothing here", the record with the logo's skull,
 * and the five places as the way on. Built as 404.html, which Cloudflare
 * Pages serves, with a 404, for any address it has no page for (and so does a
 * What's on address that was never an event, functions/_lib/event-pages.js);
 * the dev server does the same.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import "../styles/chart-gone.css";
import { siteConfig } from "../config/site";
import ChartRecord from "../components/chart/ChartRecord.astro";
import { CHART_SECTIONS } from "../lib/chart-nav";

const { notFound } = siteConfig.copy;
---

<BaseLayout
  title={notFound.pageTitle}
  description={notFound.description}
  noindex
  showBooking={false}
>
  <ChartPage class="ch-gone" title={notFound.title} pathname="/404">
    <div class="ch-gone-art" slot="art">
      <ChartRecord size="large" class="ch-gone-record" />
    </div>
    <Fragment slot="head">
      <p class="ch-lead">{notFound.line}</p>
      <nav class="ch-gone-places" aria-label={notFound.placesLabel}>
        <ul>
          {
            CHART_SECTIONS.map((item) => (
              <li>
                <a href={item.href}>
                  <span class="ch-ring" aria-hidden="true">
                    {item.numeral}
                  </span>
                  <span class="ch-caps">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </Fragment>
  </ChartPage>
</BaseLayout>
