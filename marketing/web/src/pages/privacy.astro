---
import BaseLayout from "../layouts/BaseLayout.astro";
import Subpage from "../components/Subpage.astro";
import { siteConfig } from "../config/site";
---

<BaseLayout
  title={siteConfig.seo.privacy.title}
  description={siteConfig.seo.privacy.description}
>
  <Subpage class="legal-page">
    <h1>Privacy Policy</h1>
    <p class="legal-updated">Last updated: June 2026</p>

    <section>
      <h2>Who we are</h2>
      <p>
        {siteConfig.name} is a canalside {
          siteConfig.publicLabel.toLowerCase()
        } at {siteConfig.location.address}. This website
        is operated at{" "}
        {siteConfig.domain}.
      </p>
    </section>

    <section>
      <h2>What we collect</h2>
      <ul>
        <li>
          <strong>Email address</strong> when you join our list, we
          store your email to send updates about events and nights at Gwenda.
        </li>
        <li>
          <strong>Contact form details</strong> when you apply to play or
          write via a form on this site (name, contact details, and whatever
          you choose to tell us). We use that to reply and plan nights.
        </li>
        <li>
          <strong>Analytics data</strong> we use Cloudflare Web Analytics to understand
          how visitors use this site. It does not use cookies.
        </li>
      </ul>
    </section>

    <section>
      <h2>How we use your data</h2>
      <p>
        We use your email to send you information about our events,
        nights, and offers. You can unsubscribe at any time via the link in any email
        we send.
      </p>
      <p>
        We process your data on the basis of your consent (email sign-up) and
        legitimate interest (anonymous site analytics).
      </p>
    </section>

    <section>
      <h2>Third parties</h2>
      <ul>
        <li>
          <strong>Baserow</strong> stores email list sign-ups and contact form
          submissions (including pending email confirmation) (<a
            href="https://baserow.io/privacy-policy"
            target="_blank"
            rel="noopener">privacy policy</a
          >)
        </li>
        <li>
          <strong>Cloudflare</strong> — website hosting and cookieless Web Analytics
          (<a
            href="https://www.cloudflare.com/privacypolicy/"
            target="_blank"
            rel="noopener">privacy policy</a
          >)
        </li>
      </ul>
      <p>
        Our website is served through Cloudflare, a US company. Page requests
        and anonymous analytics data may be processed outside the UK, in line
        with their privacy policy.
      </p>
    </section>

    <section>
      <h2>Your rights</h2>
      <p>
        Under UK GDPR you have the right to access, correct, or delete your
        personal data, and to withdraw consent at any time. Contact us at
        hello@gwenda.co.uk to make a request.
      </p>
    </section>

    <section>
      <h2>Cookies</h2>
      <p>
        This site does not use analytics cookies. Cloudflare may set essential
        cookies for security and performance when serving the site.
      </p>
    </section>
  </Subpage>
</BaseLayout>
