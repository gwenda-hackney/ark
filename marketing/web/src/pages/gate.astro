---
import "../styles/global.css";
import { Image } from "astro:assets";
import SocialMeta from "../components/SocialMeta.astro";
import Fonts from "../components/Fonts.astro";
import PreviewRibbon from "../components/PreviewRibbon.astro";
import { siteConfig } from "../config/site";
import { isPreview, previewOrigin } from "../config/env";
import { compactLogo } from "../lib/hero-assets";

const next = Astro.url.searchParams.get("next") ?? "/";
const siteOrigin = isPreview ? previewOrigin : siteConfig.domain;
const canonicalUrl = new URL(next === "/" ? "/" : next, siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={siteConfig.copy.descriptionPromo} />
    <title>{siteConfig.seoTitle}</title>
    <SocialMeta
      title={siteConfig.social.shareTitle}
      description={siteConfig.social.shareDescription}
      url={canonicalUrl}
    />
    <Fonts />
    <link rel="icon" href={siteConfig.brand.faviconPath} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes={`${siteConfig.brand.faviconSize}x${siteConfig.brand.faviconSize}`}
      href={siteConfig.brand.faviconPngPath}
    />
  </head>
  <body class="gate-page">
    <PreviewRibbon share={false} />
    <div class="grain" aria-hidden="true"></div>
    <main class="gate">
      <Image {...compactLogo} alt="Gwenda" class="gate-logo" loading="eager" />
      <p class="gate-eyebrow">By invitation</p>
      <h1 class="gate-title">Enter the door</h1>
      <p class="gate-lead">A password is required to view the site.</p>

      <form class="gate-form" id="gate-form" novalidate>
        <label class="visually-hidden" for="gate-password">Password</label>
        <div class="gate-field">
          <input
            type="password"
            id="gate-password"
            name="password"
            autocomplete="current-password"
            placeholder="Password"
            required
          />
          <button type="button" class="btn btn-primary" id="gate-submit"
            >Enter</button
          >
        </div>
        <p class="gate-error" id="gate-error" hidden></p>
      </form>
    </main>
    <script>
      import { initGate } from "../scripts/gate.js";
      initGate();
    </script>
  </body>
</html>
