---
/**
 * The menu is two pages now (#240). Old links to /menu land on the bar.
 * A page rather than an Astro redirect: that one bakes in the production
 * domain, which would send a preview's visitors to the live site.
 */
import { siteConfig } from "../config/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/bar" />
    <link rel="canonical" href={new URL("/bar/", siteConfig.domain).href} />
    <meta name="robots" content="noindex" />
    <title>Bar · {siteConfig.name}</title>
  </head>
  <body>
    <a href="/bar">The bar</a>
  </body>
</html>
