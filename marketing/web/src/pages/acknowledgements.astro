---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import CreditList from "../components/CreditList.astro";
import "../styles/chart-text.css";
import { siteConfig } from "../config/site";
import { acknowledgements } from "../data/acknowledgements.js";

const { title, description } = siteConfig.seo.acknowledgements;
---

<BaseLayout title={title} description={description} showBooking={false}>
  <ChartPage
    class="ch-text"
    title="Acknowledgements"
    lead="People from the Wick we work with. Named here so you can go and find them."
  >
    <CreditList items={acknowledgements} />
  </ChartPage>
</BaseLayout>
