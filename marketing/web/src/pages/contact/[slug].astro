---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChartPage from "../../components/chart/ChartPage.astro";
import ContactForm from "../../components/ContactForm.astro";
import { siteConfig } from "../../config/site";
import { PLAY_FORM_SLUG, isReservedFormSlug } from "../../lib/form-paths";
import { fetchFormBySlug, fetchFormSlugs } from "../../lib/sanity/forms";
import { chartTurntableLarge } from "../../lib/chart-assets";

export async function getStaticPaths() {
  try {
    const slugs = await fetchFormSlugs();
    return slugs
      .filter((slug) => !isReservedFormSlug(slug))
      .map((slug) => ({ params: { slug } }));
  } catch (error) {
    console.warn(
      "Form static paths skipped — could not fetch forms from Sanity:",
      error,
    );
    return [];
  }
}

const { slug } = Astro.params;
const form = slug ? await fetchFormBySlug(slug) : null;

if (!form) {
  return Astro.redirect("/contact");
}

const pageTitle = `${form.heading} · ${siteConfig.name}`;
const pageDescription =
  form.seoDescription?.trim() ||
  form.intro?.trim() ||
  siteConfig.seo.home.description;

const showTurntable = form.slug === PLAY_FORM_SLUG;
const eyebrow = form.eyebrow?.trim() || "";
const heading = form.heading?.trim() || "";
const showEyebrow =
  Boolean(eyebrow) && eyebrow.toLowerCase() !== heading.toLowerCase();
---

<BaseLayout title={pageTitle} description={pageDescription} showBooking={false}>
  <ChartPage
    class:list={["ch-form-page", showTurntable && "ch-form-page--play"]}
    title={heading}
    numeral={showTurntable ? "IV" : undefined}
    lead={form.intro?.trim() || undefined}
  >
    {
      showEyebrow && (
        <span slot="head" class="ch-caps">
          {eyebrow}
        </span>
      )
    }
    <div class="ch-form-split">
      <div id="contact-panel" class="ch-form">
        <ContactForm form={form} />
      </div>
      {
        showTurntable && (
          <aside class="ch-form-aside">
            <span class="ch-frame" aria-hidden="true">
              <Image {...chartTurntableLarge} alt="" loading="eager" />
            </span>
            <div class="ch-call">
              <h2 class="ch-find-head">We’re calling for artists</h2>
              <p>
                A room like this is made by the people who play it, and we want
                that to be the people round here: selectors and bands, crews and
                collectives, the ones who’ve played everywhere and the ones
                who’ve never played out.
              </p>
              <p>
                Vinyl nights, live sets, listening sessions, something we
                haven’t thought of yet. Pitch us and we’ll get back to you. We’d
                love to have you.
              </p>
            </div>
          </aside>
        )
      }
    </div>
  </ChartPage>
</BaseLayout>
