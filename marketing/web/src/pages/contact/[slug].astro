---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChartPage from "../../components/chart/ChartPage.astro";
import ContactForm from "../../components/ContactForm.astro";
import { siteConfig } from "../../config/site";
import {
  PARTY_FORM_SLUG,
  PLAY_FORM_SLUG,
  isReservedFormSlug,
} from "../../lib/form-paths";
import { fetchFormBySlug, fetchFormSlugs } from "../../lib/sanity/forms";
import { partyDrinksPhoto, playDecksPhoto } from "../../lib/chart-assets";
import "../../styles/chart-forms.css";

export async function getStaticPaths() {
  try {
    const slugs = await fetchFormSlugs();
    return slugs
      .filter((slug) => !isReservedFormSlug(slug))
      .map((slug) => ({ params: { slug } }));
  } catch (error) {
    console.warn(
      "Form static paths skipped — could not fetch forms from Sanity:",
      error,
    );
    return [];
  }
}

const { slug } = Astro.params;
const form = slug ? await fetchFormBySlug(slug) : null;

if (!form) {
  return Astro.redirect("/contact");
}

const pageTitle = `${form.heading} · ${siteConfig.name}`;
const pageDescription =
  form.seoDescription?.trim() ||
  form.intro?.trim() ||
  siteConfig.seo.home.description;

/**
 * The play and party forms open on a photo taped up and our own words, in
 * place of the form's intro line. A form with no entry here shows its intro.
 */
const { playIntro, playPhotoNote, partyIntro, partyPhotoNote, partyPhotoAlt } =
  siteConfig.copy.contactPage;
const intro = {
  [PLAY_FORM_SLUG]: {
    ...playIntro,
    photo: playDecksPhoto,
    photoNote: playPhotoNote,
    photoAlt: "",
  },
  [PARTY_FORM_SLUG]: {
    ...partyIntro,
    photo: partyDrinksPhoto,
    photoNote: partyPhotoNote,
    photoAlt: partyPhotoAlt,
  },
}[form.slug];
const eyebrow = form.eyebrow?.trim() || "";
const heading = form.heading?.trim() || "";
const showEyebrow =
  Boolean(eyebrow) && eyebrow.toLowerCase() !== heading.toLowerCase();
---

<BaseLayout title={pageTitle} description={pageDescription} showBooking={false}>
  <ChartPage
    class="ch-form-page ch-sheet-form-page"
    title={heading}
    lead={intro ? undefined : form.intro?.trim() || undefined}
  >
    {
      showEyebrow && (
        <span slot="head" class="ch-caps">
          {eyebrow}
        </span>
      )
    }
    {
      intro && (
        <div class="ch-form-intro">
          <div class="ch-form-intro-text">
            <p class="ch-form-intro-lead">{intro.lead}</p>
            <p>{intro.body}</p>
            <p class="ch-form-intro-cue">
              {intro.cue}
              <svg viewBox="0 0 28 40" aria-hidden="true">
                <path d="M15 2c-5 9-6 20-2 33M4 25c3 4 6 8 9 11 2-4 6-9 11-12" />
              </svg>
            </p>
          </div>
          <figure class="ch-print">
            <Image {...intro.photo} alt={intro.photoAlt} loading="eager" />
            <figcaption class="ch-print-note">{intro.photoNote}</figcaption>
          </figure>
        </div>
      )
    }
    <div id="contact-panel" class="ch-form">
      <ContactForm form={form} />
    </div>
  </ChartPage>
</BaseLayout>
