---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Subpage from "../../../components/Subpage.astro";
import ContactFormStatus from "../../../components/ContactFormStatus.astro";
import { siteConfig } from "../../../config/site";
import { PLAY_FORM_SLUG, isReservedFormSlug } from "../../../lib/form-paths";
import { fetchFormBySlug, fetchFormSlugs } from "../../../lib/sanity/forms";
import turnTable from "../../../assets/images/play/turn-table.jpg";

export async function getStaticPaths() {
  try {
    const slugs = await fetchFormSlugs();
    return slugs
      .filter((slug) => !isReservedFormSlug(slug))
      .map((slug) => ({ params: { slug } }));
  } catch (error) {
    console.warn(
      "Form submitted paths skipped — could not fetch forms from Sanity:",
      error,
    );
    return [];
  }
}

const { slug } = Astro.params;
const form = slug ? await fetchFormBySlug(slug) : null;

if (!form) {
  return Astro.redirect("/contact");
}

const pageTitle = `Submitted · ${form.heading} · ${siteConfig.name}`;
const showTurntable = form.slug === PLAY_FORM_SLUG;
---

<BaseLayout
  title={pageTitle}
  description="Your form submission."
  showBooking={false}
>
  <Subpage
    class:list={[
      "contact-page",
      "contact-page--submitted",
      showTurntable && "contact-page--play",
    ]}
    innerClass="contact-inner"
    href="/contact"
    layout={showTurntable ? "split" : "stack"}
  >
    {
      showTurntable ? (
        <aside slot="aside" class="contact-visual">
          <div class="contact-visual-bg" aria-hidden="true" />
          <div class="contact-visual-stage" aria-hidden="true">
            <Image
              src={turnTable}
              alt=""
              widths={[720, 1080, 1440]}
              sizes="(min-width: 900px) 33vw, 100vw"
              class="contact-visual-image"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="contact-visual-overlay" aria-hidden="true" />
          <div class="contact-visual-vignette" aria-hidden="true" />
        </aside>
      ) : null
    }

    <div id="contact-panel" class="contact-panel">
      <ContactFormStatus form={form} />
    </div>
  </Subpage>
</BaseLayout>
