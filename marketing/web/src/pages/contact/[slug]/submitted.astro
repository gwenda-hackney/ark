---
/**
 * After a form is sent (#240): the same page for every form, in the Chart's
 * look like the form itself. What it says comes from ContactFormStatus.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ChartFooter from "../../../components/chart/ChartFooter.astro";
import ChartNav from "../../../components/chart/ChartNav.astro";
import ContactFormStatus from "../../../components/ContactFormStatus.astro";
import { siteConfig } from "../../../config/site";
import { isReservedFormSlug } from "../../../lib/form-paths";
import { fetchFormBySlug, fetchFormSlugs } from "../../../lib/sanity/forms";
import "../../../styles/chart.css";
import "../../../styles/chart-forms.css";

export async function getStaticPaths() {
  try {
    const slugs = await fetchFormSlugs();
    return slugs
      .filter((slug) => !isReservedFormSlug(slug))
      .map((slug) => ({ params: { slug } }));
  } catch (error) {
    console.warn(
      "Form submitted paths skipped — could not fetch forms from Sanity:",
      error,
    );
    return [];
  }
}

const { slug } = Astro.params;
const form = slug ? await fetchFormBySlug(slug) : null;

if (!form) {
  return Astro.redirect("/contact");
}

const pageTitle = `Sent · ${form.heading} · ${siteConfig.name}`;
---

<BaseLayout
  title={pageTitle}
  description="Your form submission."
  showBooking={false}
>
  <div class="ch-page" data-chart="closed">
    <ChartNav />
    <main class="ch-main ch-sheet-form-page ch-sent-page" id="main">
      <ContactFormStatus form={form} />
    </main>
    <ChartFooter />
  </div>
</BaseLayout>
