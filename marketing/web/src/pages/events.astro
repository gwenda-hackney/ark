---
import BaseLayout from "../layouts/BaseLayout.astro";
import Subpage from "../components/Subpage.astro";
import { siteConfig } from "../config/site";
import { formatEventDate, getUpcomingEvents } from "../data/events";
import { fetchEvents } from "../lib/sanity/events";

/** Build-time fallback for schema.org; list body loads live from /api/events. */
const events = await fetchEvents().catch(() => []);
const upcomingEvents = getUpcomingEvents(events);
const { title: pageTitle, description: pageDescription } = siteConfig.seo.events;

const eventSchema = upcomingEvents.map((event) => ({
  "@type": "Event",
  name: event.title,
  startDate: event.date,
  description: event.description,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: siteConfig.name,
    address: {
      "@type": "PostalAddress",
      streetAddress: siteConfig.location.streetAddress,
      addressLocality: siteConfig.location.addressLocality,
      postalCode: siteConfig.location.postalCode,
      addressCountry: "GB",
    },
  },
  organizer: {
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.domain,
  },
}));
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": eventSchema,
    })}
  />

  <Subpage class="events-page" innerClass="events-inner">
    <header class="section-header reveal">
      <p class="section-eyebrow">What's on</p>
      <h1>Events</h1>
      <p>Canalside evenings in {siteConfig.location.area}.</p>
    </header>

    <p id="events-loading" class="events-empty reveal">Loading events…</p>
    <p id="events-empty" class="events-empty reveal" hidden>
      Nothing scheduled yet. Check back soon.
    </p>
    <ul class="events-list" id="events-list"></ul>
  </Subpage>
  <script>
    import { initEventsPage } from "../scripts/events.js";
    initEventsPage();
  </script>
</BaseLayout>
