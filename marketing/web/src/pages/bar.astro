---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import MenuShelf from "../components/chart/MenuShelf.astro";
import { siteConfig } from "../config/site";
import { londonToday } from "../lib/london-day.js";
import { menuShelf } from "../lib/menus.js";
import { fetchMenu } from "../lib/sanity/menu";

const menu = await fetchMenu();
/** The drinks menus running today, then the ones coming up (#306). */
const shelf = menuShelf("bar", menu, {}, londonToday());
const { title: pageTitle, description: pageDescription } = siteConfig.seo.menu;
---

<BaseLayout title={pageTitle} description={pageDescription} showBooking={false}>
  <ChartPage class="ch-menu-page" title="Drinks">
    <MenuShelf
      shelf={shelf}
      empty="The bar list’s on its way."
      soon="The bar list’s on its way."
    />
  </ChartPage>
</BaseLayout>
