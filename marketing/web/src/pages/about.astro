---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import { siteConfig } from "../config/site";

const NUMERALS = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII"];
const articles = siteConfig.copy.teamSections.filter(
  (section) => section.aside,
);
const { title, description } = siteConfig.seo.about;
---

<BaseLayout title={title} description={description} noindex showBooking={false}>
  <ChartPage
    class="ch-articles-page"
    title="About"
    numeral="V"
    lead="Where it came from and where it is going."
  >
    <ol class="ch-articles">
      {
        articles.map((article, index) => (
          <li class="ch-article">
            <span class="ch-ring">{NUMERALS[index]}</span>
            <div>
              <h2>{article.heading}</h2>
              {article.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </ChartPage>
</BaseLayout>
