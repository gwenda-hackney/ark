---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import MenuShelf from "../components/chart/MenuShelf.astro";
import { siteConfig } from "../config/site";
import { londonToday } from "../lib/london-day.js";
import { menuShelf } from "../lib/menus.js";
import { fetchWhatsOnCatalog } from "../lib/sanity/events";
import { fetchMenu } from "../lib/sanity/menu";

const menu = await fetchMenu();
/** Who's in the kitchen, and when: the pop-ups, from What's on's catalog. */
const catalog = await fetchWhatsOnCatalog().catch(() => ({
  series: [],
  occurrences: [],
}));
/**
 * The food menus running today, by who cooks them: each pop-up kitchen
 * from when it's booked through its last night, in week order (#306).
 */
const shelf = menuShelf("kitchen", menu, catalog, londonToday());
---

<BaseLayout
  title={`Food · ${siteConfig.name}`}
  description="Food at Gwenda, by the canal in Hackney Wick: what the kitchen’s cooking right now."
  showBooking={false}
>
  <ChartPage class="ch-menu-page" title="Food">
    <MenuShelf
      shelf={shelf}
      empty="No kitchen in right now, back soon."
      soon="The kitchen menu’s on its way."
    />
  </ChartPage>
</BaseLayout>
