---
import BaseLayout from "../layouts/BaseLayout.astro";
import Subpage from "../components/Subpage.astro";
import EmailSignup from "../components/EmailSignup.astro";
import { siteConfig } from "../config/site";

const { contactPage } = siteConfig.copy;
---

<BaseLayout
  title={`Stay close · ${siteConfig.name}`}
  description="Join the Gwenda list for nights ahead in Hackney Wick."
  showBooking={false}
>
  <Subpage
    class="contact-list-page"
    innerClass="contact-list-inner"
    href="/contact"
    eyebrow={contactPage.listEyebrow}
    title={contactPage.listHeading}
  >
    <p slot="lead">{contactPage.listLead}</p>

    <div class="contact-list-form reveal reveal-stagger" style="--reveal-delay: 0.1s">
      <EmailSignup mode="promo" embedded />
    </div>
  </Subpage>
</BaseLayout>
