---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import EmailSignup from "../components/EmailSignup.astro";
import { siteConfig } from "../config/site";

const { contactPage } = siteConfig.copy;
---

<BaseLayout
  title={`Stay close · ${siteConfig.name}`}
  description="Join the Gwenda list for nights ahead in Hackney Wick."
  showBooking={false}
>
  <ChartPage
    class="ch-form-page"
    title={contactPage.listHeading}
    lead={contactPage.listLead}
  >
    <div class="ch-form">
      <EmailSignup mode="promo" embedded />
    </div>
  </ChartPage>
</BaseLayout>
