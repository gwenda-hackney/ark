---
import { fetchRsvpEventPages } from "../../lib/sanity/rsvp-events";
import {
  occurrencePathParams,
  parseOccurrenceSlug,
} from "../../../functions/_lib/event-series.js";

export async function getStaticPaths() {
  try {
    const events = await fetchRsvpEventPages();
    return events.map((event) => {
      const parsed = parseOccurrenceSlug(event.slug);
      const target = parsed
        ? `/whats-on/${occurrencePathParams(event).series}/${parsed.date}/`
        : `/whats-on/${event.seriesId || event.slug}/`;
      return {
        params: { slug: event.slug },
        props: { target },
      };
    });
  } catch (error) {
    console.warn("Legacy event redirects skipped:", error);
    return [];
  }
}

const { target } = Astro.props;
const search = Astro.url.search || "";
return Astro.redirect(`${target}${search}`, 301);
---
