---
import EventRsvpPage from "../../../components/EventRsvpPage.astro";
import { isPreview, previewOrigin } from "../../../config/env";
import { siteConfig } from "../../../config/site";
import {
  fetchRsvpEventPages,
  socialDescription,
  type RsvpEventPage,
} from "../../../lib/sanity/rsvp-events";
import { fetchSeries } from "../../../lib/sanity/events";
import { nightPagePaths } from "../../../../functions/_lib/event-series.js";

export async function getStaticPaths() {
  try {
    const [events, series] = await Promise.all([
      fetchRsvpEventPages(),
      fetchSeries().catch(() => []),
    ]);
    const { pages, redirects } = nightPagePaths(events, series);
    return [
      ...pages.map(({ event, series, date }) => ({
        params: { series, date },
        props: { event, occurrenceSlug: event.slug, redirectTo: "" },
      })),
      // The series' web address changed in ops: old night links still work.
      ...redirects.map(({ series, date, to }) => ({
        params: { series, date },
        props: { event: null, occurrenceSlug: "", redirectTo: to },
      })),
    ];
  } catch (error) {
    console.warn("What's on invite paths skipped:", error);
    return [];
  }
}

interface Props {
  event: RsvpEventPage;
  occurrenceSlug: string;
  redirectTo: string;
}

const { event, occurrenceSlug, redirectTo } = Astro.props;
if (redirectTo) {
  return Astro.redirect(redirectTo, 301);
}
const series = Astro.params.series || "";
const date = Astro.params.date || "";
const siteOrigin = isPreview
  ? previewOrigin
  : siteConfig.domain;
const pageUrl = `${siteOrigin}/whats-on/${series}/${date}`;
const pageTitle = `${event.title} · Gwenda`;
const pageDescription = socialDescription(event.description);
---

<EventRsvpPage
  meta={{
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    image: event.socialImage
      ? `${siteOrigin}${event.socialImage.publicPath}`
      : undefined,
    imageWidth: event.socialImage?.width,
    imageHeight: event.socialImage?.height,
    imageType: event.socialImage?.type,
    imageAlt: event.socialImage?.alt,
  }}
  occurrenceSlug={occurrenceSlug}
/>
