---
import EventRsvpPage from "../../../components/EventRsvpPage.astro";
import { isPreview, previewOrigin } from "../../../config/env";
import { siteConfig } from "../../../config/site";
import {
  fetchRsvpEventPages,
  socialDescription,
  type RsvpEventPage,
} from "../../../lib/sanity/rsvp-events";
import { parseOccurrenceSlug } from "../../../../functions/_lib/event-series.js";

export async function getStaticPaths() {
  try {
    const events = await fetchRsvpEventPages();
    return events.map((event) => {
      const parsed = parseOccurrenceSlug(event.slug);
      const series = parsed?.seriesId || event.seriesId || event.slug;
      const date = parsed?.date || event.date;
      return {
        params: { series, date },
        props: { event, occurrenceSlug: event.slug },
      };
    });
  } catch (error) {
    console.warn("What's on invite paths skipped:", error);
    return [];
  }
}

interface Props {
  event: RsvpEventPage;
  occurrenceSlug: string;
}

const { event, occurrenceSlug } = Astro.props;
const series = Astro.params.series || "";
const date = Astro.params.date || "";
const siteOrigin = isPreview
  ? previewOrigin
  : siteConfig.domain;
const pageUrl = `${siteOrigin}/whats-on/${series}/${date}`;
const pageTitle = `${event.title} · Gwenda`;
const pageDescription = socialDescription(event.description);
---

<EventRsvpPage
  meta={{
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    image: event.socialImage
      ? `${siteOrigin}${event.socialImage.publicPath}`
      : undefined,
    imageWidth: event.socialImage?.width,
    imageHeight: event.socialImage?.height,
    imageType: event.socialImage?.type,
    imageAlt: event.socialImage?.alt,
  }}
  occurrenceSlug={occurrenceSlug}
/>
