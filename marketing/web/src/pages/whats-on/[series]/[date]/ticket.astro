---
import EventTicketPage from "../../../../components/EventTicketPage.astro";
import { isPreview, previewOrigin } from "../../../../config/env";
import { siteConfig } from "../../../../config/site";
import { fetchRsvpEventPages } from "../../../../lib/sanity/rsvp-events";
import { parseOccurrenceSlug } from "../../../../../functions/_lib/event-series.js";

export async function getStaticPaths() {
  try {
    const events = await fetchRsvpEventPages();
    return events.map((event) => {
      const parsed = parseOccurrenceSlug(event.slug);
      const series = parsed?.seriesId || event.seriesId || event.slug;
      const date = parsed?.date || event.date;
      return {
        params: { series, date },
        props: { event, occurrenceSlug: event.slug },
      };
    });
  } catch (error) {
    console.warn("What's on ticket paths skipped:", error);
    return [];
  }
}

interface Props {
  event: { slug: string; title: string };
  occurrenceSlug: string;
}

const { event, occurrenceSlug } = Astro.props;
const series = Astro.params.series || "";
const date = Astro.params.date || "";
const siteOrigin = isPreview
  ? previewOrigin
  : siteConfig.domain;
const pageUrl = `${siteOrigin}/whats-on/${series}/${date}/ticket`;
const pageTitle = `Your ticket · ${event.title} · Gwenda`;
---

<EventTicketPage
  meta={{ title: pageTitle, url: pageUrl }}
  occurrenceSlug={occurrenceSlug}
/>
