---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import NightCards from "../components/chart/NightCards.astro";
import StandingCards from "../components/chart/StandingCards.astro";
import { siteConfig } from "../config/site";
import { getUpcomingEvents } from "../data/events";
import { menuChapters } from "../data/menu";
import { nightsOnly } from "../lib/promotions.js";
import { fetchWhatsOnCatalog } from "../lib/sanity/events";
import { fetchMenu } from "../lib/sanity/menu";
import { closedDays } from "../lib/opening-hours.js";
import { fetchOpeningHours } from "../lib/sanity/opening-hours";

const { series, occurrences } = await fetchWhatsOnCatalog().catch(() => ({
  series: [],
  occurrences: [],
}));
const menu = await fetchMenu().catch(() => ({ sections: [] }));
/** The next few weeks of nights; the deal and the pop-up kitchen go once, on their own cards. */
const nights = getUpcomingEvents(nightsOnly(occurrences)).slice(0, 24);
const { title: pageTitle, description: pageDescription } =
  siteConfig.seo.whatsOn;
/** "We're shut on Mondays." from the opening hours; nothing without them. */
const shut = closedDays(await fetchOpeningHours());
const lead = `What’s coming up.${shut ? ` We’re shut on ${shut}.` : ""}`;
---

<BaseLayout title={pageTitle} description={pageDescription} showBooking={false}>
  <ChartPage title="What's on" lead={lead}>
    <StandingCards
      series={series}
      occurrences={occurrences}
      chapters={menuChapters(menu, "kitchen")}
      top
    />
    <NightCards nights={nights} series={series} weeks leadEager={false} />
  </ChartPage>
</BaseLayout>
