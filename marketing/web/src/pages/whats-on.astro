---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import ChartLog from "../components/chart/ChartLog.astro";
import { siteConfig } from "../config/site";
import { getUpcomingEvents } from "../data/events";
import { fetchWhatsOnCatalog } from "../lib/sanity/events";

const { occurrences } = await fetchWhatsOnCatalog().catch(() => ({
  series: [],
  occurrences: [],
}));
/** The next few weeks; the rest goes in as the dates come round. */
const nights = getUpcomingEvents(occurrences).slice(0, 24);
const { title: pageTitle, description: pageDescription } =
  siteConfig.seo.whatsOn;
---

<BaseLayout title={pageTitle} description={pageDescription} showBooking={false}>
  <ChartPage
    title="What's on"
    numeral="III"
    lead="Every night ahead, in order. Mondays we rest."
  >
    <ChartLog nights={nights} />
  </ChartPage>
</BaseLayout>
