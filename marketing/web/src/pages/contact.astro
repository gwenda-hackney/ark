---
/**
 * Contact (#240): the one page for reaching us. How to find us (the map
 * and the walk from the station), having a party here, playing here, and
 * getting on the list.
 */
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import ChartMap from "../components/chart/ChartMap.astro";
import EmailSignup from "../components/EmailSignup.astro";
import OpeningHours from "../components/chart/OpeningHours.astro";
import { siteConfig } from "../config/site";
import { directions } from "../data/directions";
import { contactDrinksPhoto, homeDecksPhoto } from "../lib/chart-assets";
import { fetchOpeningHours } from "../lib/sanity/opening-hours";
import {
  formPublicPath,
  PARTY_FORM_SLUG,
  PLAY_FORM_SLUG,
} from "../lib/form-paths";

const { contactPage } = siteConfig.copy;
const { social } = siteConfig;
const week = await fetchOpeningHours();
---

<BaseLayout
  title={siteConfig.seo.contact.title}
  description={siteConfig.seo.contact.description}
  showBooking={false}
>
  <ChartPage
    class="ch-find-page ch-contact-page"
    title="Contact"
    lead="Where we are, having a party, playing here, and how to hear what’s on."
  >
    <nav class="ch-jump" aria-label="On this page">
      <a href="#find-us">Find us</a>
      <a href="#party">Have a party</a>
      <a href="#play">Play here</a>
      <a href="#list">Get on the list</a>
    </nav>

    <section class="ch-contact-part" id="find-us">
      <h2 class="ch-sheet-head">Find us</h2>
      <div class="ch-find-top">
        <p class="ch-find-intro">{directions.intro}</p>
        <OpeningHours week={week} today />
      </div>
      <ChartMap />
      <div class="ch-find-ways">
        <section>
          <h3 class="ch-find-head">{directions.fromStation.heading}</h3>
          <ol class="ch-find-steps">
            {directions.fromStation.steps.map((step) => <li>{step}</li>)}
          </ol>
          <p class="ch-find-note">{directions.fromStation.note}</p>
        </section>
        <section>
          <h3 class="ch-find-head">{directions.fromTowpath.heading}</h3>
          <p>{directions.fromTowpath.text}</p>
        </section>
      </div>
    </section>

    <section class="ch-contact-part ch-contact-play" id="party">
      <div>
        <h2 class="ch-sheet-head">{contactPage.partyHeading}</h2>
        <p>{contactPage.partyLead}</p>
        <a href={formPublicPath(PARTY_FORM_SLUG)} class="ch-btn ch-btn--solid"
          >{contactPage.partyCta}</a
        >
      </div>
      <a
        href={formPublicPath(PARTY_FORM_SLUG)}
        class="ch-contact-photo ch-print"
        tabindex="-1"
        aria-hidden="true"
      >
        <Image {...contactDrinksPhoto} alt="" loading="lazy" />
        <span class="ch-print-note">{contactPage.partyPhotoNote}</span>
      </a>
    </section>

    <section class="ch-contact-part ch-contact-play" id="play">
      <div>
        <h2 class="ch-sheet-head">{contactPage.playHeading}</h2>
        <p>{contactPage.playLead}</p>
        <a href={formPublicPath(PLAY_FORM_SLUG)} class="ch-btn ch-btn--solid"
          >{contactPage.playCta}</a
        >
      </div>
      <a
        href={formPublicPath(PLAY_FORM_SLUG)}
        class="ch-contact-photo ch-print"
        tabindex="-1"
        aria-hidden="true"
      >
        <Image {...homeDecksPhoto} alt="" loading="lazy" />
        <span class="ch-print-note">{contactPage.playPhotoNote}</span>
      </a>
    </section>

    <section class="ch-contact-part" id="list">
      <h2 class="ch-sheet-head">{contactPage.listHeading}</h2>
      <p>{contactPage.listLead}</p>
      <div class="ch-form">
        <EmailSignup mode="promo" embedded />
      </div>
      <p class="ch-contact-also">
        Or follow <a
          href={social.instagram}
          class="ch-link"
          target="_blank"
          rel="noopener noreferrer">@gwendahackney</a
        > on Instagram, or write to <a
          href={`mailto:${siteConfig.contact.email}`}
          class="ch-link">{siteConfig.contact.email}</a
        >.
      </p>
    </section>
  </ChartPage>
</BaseLayout>
