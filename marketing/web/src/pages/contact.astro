---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChartPage from "../components/chart/ChartPage.astro";
import { siteConfig } from "../config/site";
import { formPublicPath, PLAY_FORM_SLUG } from "../lib/form-paths";
import ChartMap from "../components/chart/ChartMap.astro";

const { contactPage } = siteConfig.copy;
const { social } = siteConfig;
---

<BaseLayout
  title={siteConfig.seo.contact.title}
  description={siteConfig.seo.contact.description}
  showBooking={false}
>
  <ChartPage class="ch-find-page" title="Contact" numeral="VI">
    <section class="ch-find">
      <div class="ch-head"><h2>Find us</h2></div>
      <p class="ch-ital">
        On the canal behind Hackney Wick station, where the Hertford Union meets
        the Lee.
      </p>
      <ChartMap />
    </section>

    <section class="ch-find">
      <div class="ch-head"><h2>{contactPage.heading}</h2></div>
      <p class="ch-ital">{contactPage.lead}</p>
      <ul class="ch-paths">
        <li>
          <a href="/join-list" class="ch-path">
            <span class="ch-caps">{contactPage.listEyebrow}</span>
            <span class="ch-path-title">{contactPage.listHeading}</span>
            <span class="ch-ital">{contactPage.listLead}</span>
          </a>
        </li>
        <li>
          <a href={formPublicPath(PLAY_FORM_SLUG)} class="ch-path">
            <span class="ch-caps">{contactPage.playEyebrow}</span>
            <span class="ch-path-title">{contactPage.playHeading}</span>
            <span class="ch-ital">{contactPage.playLead}</span>
          </a>
        </li>
        <li>
          <a
            href={social.instagram}
            class="ch-path"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="ch-caps">Instagram</span>
            <span class="ch-path-title">@gwendahackney</span>
            <span class="ch-ital"
              >Photos from the room and what's on next.</span
            >
          </a>
        </li>
      </ul>
    </section>
  </ChartPage>
</BaseLayout>
