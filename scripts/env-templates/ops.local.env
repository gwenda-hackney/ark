# Ops runtime secrets only (copy to repo-root .env.ops via env:ops:pull).
# Bootstrap: ARK_LOCAL_BW_TOKEN in shared .env
#
# BASEROW_API_KEY = local/dev workspace token (Gwenda Dev)
# Production Pages uses BASEROW_API_KEY_PRODUCTION from SM (ops-secrets workflow)
#
# After clone:baserow-ops-dev, also set:
#   BASEROW_OPS_DATABASE_ID=<dev database id>
#   BASEROW_OPS_DEV_WORKSPACE_ID=<dev workspace id>

BASEROW_API_KEY=
GOOGLE_OAUTH_CLIENT_SECRET=
# Minified service-account JSON for Shared Drive event images (Pages + local).
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
OPS_SESSION_SECRET=
OPS_LOCAL_ADMIN_PW=
OPS_BYPASS_KEY=
# Lightspeed Back Office export bot (GitHub Action / nest). Not a Pages secret.
# Dedicated non-owner user. Leave empty until SM has the values.
LIGHTSPEED_BO_EMAIL=
LIGHTSPEED_BO_PASSWORD=
LIGHTSPEED_BO_TOTP=
LIGHTSPEED_OPS_EMAIL=
# SANITY_API_TOKEN and DEPLOY_WEBHOOK_SECRET are owned by Ark/Web; ops pull reads them.
SANITY_API_TOKEN=
DEPLOY_WEBHOOK_SECRET=
BASEROW_OPS_DATABASE_ID=
