# ark/.env.local — marketing / shared local secrets (Bitwarden Password Manager note).
# Pulled by: npm run env:pull
#
# Ops runtime secrets: Bitwarden Secrets Manager → `.env.ops`
#   npm run env:ops:pull
# Bootstrap token for that pull lives here (not in .env.ops):
# Ops non-secret settings live in Baserow App Config (docs/config.md).
# Fill via: npm run env:set -- KEY value

# ── Secrets Manager (ops + marketing credentials) ──
# Machine-account access token for ark-local. Only bootstrap secret for SM sync.
ARK_LOCAL_BW_TOKEN=

# ── Baserow (dev + staging share database 465058) ──
# Marketing API key: prefer `npm run env:web:pull` → `.env.web` (SM key
# BASEROW_API_KEY_MARKETING). Table ids are resolved by name (Subscribers /
# Event Invites / Form Submissions); set BASEROW_DATABASE_ID only to disambiguate.
BASEROW_API_KEY=
BASEROW_DATABASE_ID=465058
BASEROW_RSVP_GRID_URL=

# ── Subscribe ──
SUBSCRIBE_SECRET=

# ── Site gate (local mirrors staging) ──
PUBLIC_IS_STAGING=true
PUBLIC_OPENING_DATE=2026-08-01
SITE_PASSWORD=
GATE_BYPASS_KEY=
PREVIEW_PASSWORD=

# ── Cloudflare ──
# DEV token: local Pages, Wrangler, and Access setup. GitHub CI uses CLOUDFLARE_API_TOKEN.
CLOUDFLARE_DEV_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=1c23e160e39a187ce33fe192595c4a7f

# ── Sanity (Editor robot for local Studio / seeds — never commit) ──
SANITY_PROJECT_ID=pn5yjro6
SANITY_DATASET=development
SANITY_API_TOKEN=

# ── Event admin / invites ──
EVENT_ADMIN_SECRET=
EVENT_ADMIN_URL=http://localhost:4321
INVITE_BASE_URL=http://localhost:4321
INVITE_IMAGE_URL=
INVITE_EVENT_SLUG=private-launch-party
CLICKUP_INVITE_LIST_ID=
TICKET_SECRET=

# ── SMTP ──
# Password only is a secret (SM → .env.web). Host/user match wrangler [vars] for local dev.
# Form From / Reply-To / notify live in Sanity. RSVP From is wrangler SMTP_FROM_EVENTS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@gwenda.co.uk
SMTP_PASSWORD=

# ── Mailchimp ──
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
SUBSCRIBE_MAILCHIMP_SYNC_SECRET=

# ── Meta / Instagram ──
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Ops Pages ──
# Prefer `.env.ops` for ops secrets (GOOGLE_*, OPS_*, BASEROW_API_KEY).
# These keys remain here only while env:pull still merges a monolithic note.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OPS_SESSION_SECRET=
OPS_LOCAL_ADMIN_PW=
OPS_BYPASS_KEY=
# Who may use ops lives in Baserow Users, not env.
BASEROW_OPS_DATABASE_ID=
BASEROW_WORKSPACE_ID=208709


# ── Wi-Fi portal ──
UNIFI_SITE_MANAGER_API_KEY=
UNIFI_CONSOLE_ID=A89C6C0EB1810000000009A42CB9000000000A2C1924000000006920A430:1883747293
WIFI_CAPTIVE_PORTAL_URL=

# ── Studio → site rebuild (often filled by setup:site-deploy) ──
DEPLOY_WEBHOOK_SECRET=
SANITY_STUDIO_SITE_DEPLOY_URL=
SITE_DEPLOY_WEBHOOK_URL=
DISPATCH_TOKEN=
