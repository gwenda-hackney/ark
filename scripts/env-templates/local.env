# ark/.env.local: shared local bootstrap + plain local settings (Bitwarden Password Manager note).
# Pulled by: npm run env:pull
#
# Credentials do not live here. They come from Bitwarden Secrets Manager:
#   npm run env:ark:pull   → .env.ark  (Cloudflare)
#   npm run env:web:pull   → .env.web  (Baserow, Sanity, SMTP, site gate, subscribe, UniFi)
#   npm run env:ops:pull   → .env.ops  (ops site)
# Non-secret app settings live in the Baserow Gwenda Config database (docs/config.md).
# Fill via: npm run env:set -- KEY value

# ── Secrets Manager bootstrap ──
# Machine-account access token for ark-local. The only secret SM pulls need.
ARK_LOCAL_BW_TOKEN=

# ── Sanity ──
SANITY_PROJECT_ID=pn5yjro6
SANITY_DATASET=staging
# npm run dev overlays drafts (previewDrafts). Staging/production builds stay published.

# ── Site gate (local mirrors staging) ──
PUBLIC_IS_STAGING=true
PUBLIC_OPENING_DATE=2026-08-01

# ── Public origin for RSVP / ticket links ──
INVITE_BASE_URL=http://localhost:4321

# ── SMTP ──
# Password is a secret (SM → .env.web). Host/user match wrangler [vars] for local dev.
# Form From / Reply-To / notify live in Sanity. RSVP From is wrangler SMTP_FROM_EVENTS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@gwenda.co.uk

# ── Baserow workspace (npm run setup:baserow-ops when creating a new database) ──
BASEROW_WORKSPACE_ID=208709

# ── Wi-Fi portal (UNIFI_SITE_MANAGER_API_KEY is in SM → .env.web) ──
UNIFI_CONSOLE_ID=A89C6C0EB1810000000009A42CB9000000000A2C1924000000006920A430:1883747293

# ── Studio → site rebuild (written by npm run setup:site-deploy) ──
# The webhook secret is DEPLOY_WEBHOOK_SECRET in SM (.env.web).
SANITY_STUDIO_SITE_DEPLOY_URL=

# ── Optional: Mailchimp (npm run setup:subscribe-mailchimp-sync) ──
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
