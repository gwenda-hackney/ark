# `.env.web` — marketing runtime secrets from Bitwarden Secrets Manager.
# Pulled by: npm run env:web:pull
# Seeded by: npm run env:web:push  (from filled keys in shared .env)
#
# Bootstrap token stays in shared .env: ARK_LOCAL_BW_TOKEN
# Table ids are not configured — resolve Subscribers / Event Invites / Form Submissions by name.

BASEROW_API_KEY=
SUBSCRIBE_SECRET=
EVENT_ADMIN_SECRET=
SANITY_API_TOKEN=
SMTP_PASSWORD=
SITE_PASSWORD=
GATE_BYPASS_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
