---
import EventTicketPage from "../../../components/EventTicketPage.astro";
import { isStaging } from "../../../config/env";
import { siteConfig } from "../../../config/site";
import { fetchRsvpEventPages } from "../../../lib/sanity/rsvp-events";

export async function getStaticPaths() {
  try {
    const events = await fetchRsvpEventPages();
    return events.map((event) => ({
      params: { slug: event.slug },
      props: { event },
    }));
  } catch (error) {
    console.warn("Ticket static paths skipped — could not fetch events from Sanity:", error);
    return [];
  }
}

interface Props {
  event: { slug: string; title: string };
}

const { event } = Astro.props;
const siteOrigin = isStaging
  ? "https://gwenda-staging.pages.dev"
  : siteConfig.domain;
const pageUrl = `${siteOrigin}/events/${event.slug}/ticket`;
const pageTitle = `Your ticket · ${event.title} · Gwenda`;
---

<EventTicketPage meta={{ title: pageTitle, url: pageUrl }} />
