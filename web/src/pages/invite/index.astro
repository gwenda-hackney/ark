---
import "../../styles/global.css";
import { Image } from "astro:assets";
import SocialMeta from "../../components/SocialMeta.astro";
import Fonts from "../../components/Fonts.astro";
import StagingRibbon from "../../components/StagingRibbon.astro";
import { siteConfig } from "../../config/site";
import { isStaging } from "../../config/env";
import { compactLogo } from "../../lib/hero-assets";

const siteOrigin = isStaging
  ? "https://gwenda-staging.pages.dev"
  : siteConfig.domain;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Private invitation — Gwenda" />
    <title>You're invited — Gwenda</title>
    <SocialMeta
      title="You're invited — Gwenda"
      description="A private evening at Gwenda, Hackney Wick."
      url={`${siteOrigin}/invite/`}
    />
    <Fonts />
    <link rel="icon" href={siteConfig.brand.faviconPath} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes={`${siteConfig.brand.faviconSize}x${siteConfig.brand.faviconSize}`}
      href={siteConfig.brand.faviconPngPath}
    />
  </head>
  <body class="gate-page invite-page">
    <StagingRibbon />
    <div class="grain" aria-hidden="true"></div>
    <main class="gate invite">
      <Image {...compactLogo} alt="Gwenda" class="gate-logo" loading="eager" />
      <p class="gate-eyebrow">By invitation</p>

      <div id="invite-loading" class="invite-state">
        <p class="gate-lead">Opening your invitation…</p>
      </div>

      <div id="invite-error" class="invite-state" hidden>
        <h1 class="gate-title">Invitation not found</h1>
        <p class="gate-lead" id="invite-error-text">
          This link may have expired or been entered incorrectly.
        </p>
      </div>

      <div id="invite-form-wrap" class="invite-state" hidden>
        <img
          id="invite-hero"
          src=""
          alt=""
          class="invite-hero"
          width="640"
          height="360"
          loading="eager"
          hidden
        />
        <h1 class="gate-title" id="invite-event-title"></h1>
        <p class="gate-lead invite-guest-line" id="invite-greeting"></p>
        <p class="invite-event-description" id="invite-event-description" hidden></p>

        <form class="invite-form" id="rsvp-form" novalidate>
          <label class="invite-label" for="rsvp-guests">Number attending (including you)</label>
          <div class="gate-field invite-field">
            <input
              type="number"
              id="rsvp-guests"
              name="guests"
              min="0"
              max="20"
              step="1"
              inputmode="numeric"
              required
            />
            <button type="submit" class="btn btn-primary" id="rsvp-submit">Confirm</button>
          </div>
          <p class="gate-error" id="rsvp-error" hidden></p>
          <p class="invite-note" id="rsvp-success" hidden></p>
        </form>
      </div>
    </main>
    <script>
      import { initInviteRsvp } from "../../scripts/rsvp.js";
      initInviteRsvp();
    </script>
  </body>
</html>
