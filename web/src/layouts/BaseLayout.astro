---
import "../styles/global.css";
import { siteConfig } from "../config/site";
import { isStaging } from "../config/env";
import SocialMeta from "../components/SocialMeta.astro";
import StructuredData from "../components/StructuredData.astro";
import Fonts from "../components/Fonts.astro";
import StagingRibbon from "../components/StagingRibbon.astro";
import BookingButton from "../components/BookingButton.astro";
import { colors } from "../config/colors";

const themeColor = colors.bg;

interface Props {
  title?: string;
  description?: string;
  socialTitle?: string;
  socialDescription?: string;
}

const {
  title = siteConfig.seoTitle,
  description = siteConfig.description,
  socialTitle,
  socialDescription,
} = Astro.props;

const siteOrigin = isStaging
  ? "https://gwenda-staging.pages.dev"
  : siteConfig.domain;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="geo.region" content="GB-LND" />
    <meta name="geo.placename" content="Hackney Wick, London" />
    <meta
      name="geo.position"
      content={`${siteConfig.location.geo.latitude};${siteConfig.location.geo.longitude}`}
    />
    <meta
      name="ICBM"
      content={`${siteConfig.location.geo.latitude}, ${siteConfig.location.geo.longitude}`}
    />
    {
      isStaging ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }
    <SocialMeta
      title={socialTitle ?? title}
      description={socialDescription ?? siteConfig.social.shareDescription}
      url={canonicalUrl}
    />
    <StructuredData
      url={canonicalUrl}
      title={title}
      description={description}
    />

    <script is:inline>
      // Runs before first paint: on back/forward, render in final state so the
      // browser's native scroll restoration lands without a jump.
      try {
        var nav = performance.getEntriesByType("navigation")[0];
        if (nav && nav.type === "back_forward") {
          document.documentElement.classList.add(
            "navigation-restore",
            "fonts-ready",
          );
        }
      } catch (_) {}
    </script>

    <Fonts />
    <link rel="icon" href={siteConfig.brand.faviconPath} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes={`${siteConfig.brand.faviconSize}x${siteConfig.brand.faviconSize}`}
      href={siteConfig.brand.faviconPngPath}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={siteConfig.brand.appleTouchIconPath}
    />

    <slot name="head" />
  </head>
  <body>
    <StagingRibbon />
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <BookingButton variant="float" />
    <script src="../scripts/main.js"></script>
  </body>
</html>
