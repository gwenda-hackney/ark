---
import { siteConfig } from "../config/site";
import sharePreviewImage from "../assets/images/social/logo-board.png";

interface Props {
  title?: string;
  description?: string;
  url?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  imageAlt?: string;
}

const { social } = siteConfig;
const title = Astro.props.title ?? social.shareTitle;
const description = Astro.props.description ?? social.shareDescription;
const url = Astro.props.url ?? siteConfig.domain;
const useCustomImage = Boolean(Astro.props.image);
const image = useCustomImage
  ? Astro.props.image!
  : new URL(sharePreviewImage.src, url).href;
const imageWidth = Astro.props.imageWidth ?? sharePreviewImage.width;
const imageHeight = Astro.props.imageHeight ?? sharePreviewImage.height;
const imageType = Astro.props.imageType ?? (useCustomImage ? undefined : "image/png");
const imageAlt = Astro.props.imageAlt ?? social.imageAlt;
---

<link rel="canonical" href={url} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
{imageType && <meta property="og:image:type" content={imageType} />}
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
