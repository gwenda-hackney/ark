---
import type { Menu } from "../types/menu";
import MenuSection from "./MenuSection.astro";

interface Props {
  menu: Menu;
  showPrices?: boolean;
}

const { menu, showPrices = true } = Astro.props;
const sections = menu.sections.filter((section) => section.items.length > 0);
---

{
  sections.length > 0 ? (
    <div class="menu-display">
      {sections.map((section) => (
        <MenuSection section={section} showPrices={showPrices} />
      ))}
    </div>
  ) : (
    <p class="menu-empty reveal">The menu is being prepared. Check back soon.</p>
  )
}
