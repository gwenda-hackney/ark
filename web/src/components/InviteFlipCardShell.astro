---
import { Image } from "astro:assets";
import { inviteCardLogo } from "../lib/hero-assets";
---

<div id="invite-card-scene" class="invite-card-scene" hidden>
  <div class="invite-card" id="invite-card">
    <div class="invite-card-inner">
      <button
        type="button"
        class="invite-card-face invite-card-front"
        id="invite-card-open"
        aria-controls="invite-card-back"
        aria-expanded="false"
      >
        <div class="invite-card-front-idle" id="invite-card-front-idle">
          <Image {...inviteCardLogo} alt="Gwenda" class="invite-card-logo" loading="eager" />
          <p class="invite-card-badge" id="invite-card-eyebrow" hidden>Private event</p>
          <p class="invite-card-intro">Your invitation awaits</p>
          <h1 class="invite-card-headline" id="invite-card-subtitle" hidden></h1>
          <p class="invite-card-meta" id="invite-card-lead" hidden></p>
          <span class="invite-card-hint">Tap to open</span>
        </div>
        <div class="invite-card-front-sending" id="invite-card-front-sending" hidden>
          <span class="invite-loader-mark" aria-hidden="true"></span>
          <p class="invite-card-sending-text">Sending your reply</p>
        </div>
      </button>

      <div class="invite-card-face invite-card-back" id="invite-card-back">
        <div class="invite-card-back-inner">
          <slot />
        </div>
      </div>
    </div>
  </div>
</div>
