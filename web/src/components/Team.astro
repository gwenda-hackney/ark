---
import { siteConfig } from "../config/site";
---

<section class="story-team section" id="team">
  <div class="container">
    <div class="story-team-grid">
      <div class="story-team-inner reveal">
        <p class="section-eyebrow">The team</p>
        <h2>{siteConfig.copy.teamHeading}</h2>
        <div class="story-body">
          {siteConfig.copy.teamBody.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <p class="join-cta-footer">
          <a href="#list" class="btn btn-primary"
            >{siteConfig.copy.joinExperienceCta}</a
          >
        </p>
      </div>
    </div>
  </div>
</section>
