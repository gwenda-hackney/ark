---
import { Image } from "astro:assets";
import { siteConfig } from "../config/site";
import type { SiteFeatures } from "../types/features";
import { getSignatureCocktails } from "../data/menu";
import { fetchMenu } from "../lib/sanity/menu";

interface Props {
  features: SiteFeatures;
}

const { features } = Astro.props;
const menu = await fetchMenu();
const cocktails = getSignatureCocktails(menu);
const { revealDrinkNames } = features;
const roman = ["I", "II", "III", "IV", "V", "VI"];
---

<section class="glimpse section" id="glimpse">
  <div class="container">
    <header class="section-header reveal">
      <p class="section-eyebrow">Shhh</p>
      <h2>{siteConfig.copy.galleryHeading}</h2>
      <p>{siteConfig.copy.gallerySubheading}</p>
    </header>
  </div>

  <div class="glimpse-grid">
    {
      cocktails.map((cocktail, i) => (
        <figure class="glimpse-item reveal">
          <Image
            src={cocktail.image.url}
            alt={
              revealDrinkNames
                ? (cocktail.image.alt ?? `${cocktail.name} cocktail`)
                : "Cocktail teaser"
            }
            width={cocktail.image.width}
            height={cocktail.image.height}
            class="glimpse-photo"
          />
          <figcaption class="glimpse-caption">
            {revealDrinkNames ? cocktail.name : (roman[i] ?? "—")}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
