---
import { getSignatureCocktails } from "../data/menu";
import { fetchMenu } from "../lib/sanity/menu";

const menu = await fetchMenu();
const cocktails = getSignatureCocktails(menu);
---

<section class="gallery" id="gallery">
  <div class="gallery-header">
    <h2>Our Signature Creations</h2>
    <p>Handcrafted cocktails with premium spirits and fresh ingredients</p>
  </div>

  <div class="gallery-container">
    {
      cocktails.map((cocktail) => (
        <div class="gallery-item">
          <img
            src={cocktail.image.url}
            width={cocktail.image.width}
            height={cocktail.image.height}
            alt={cocktail.image.alt ?? `${cocktail.name} cocktail`}
            class="gallery-photo"
            loading="lazy"
            decoding="async"
          />
          <div class="gallery-overlay">
            <h3>{cocktail.name}</h3>
          </div>
        </div>
      ))
    }
  </div>
</section>
