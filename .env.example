# ── Baserow (dev + staging share database 465058; production is separate) ──
BASEROW_API_KEY=
# Subscribe list — dev/staging table (production uses GitHub var BASEROW_TABLE_ID=1017358)
BASEROW_TABLE_ID=1024006
# Event RSVP table name (default: Event Invites) — resolved at runtime, no table id needed
# BASEROW_RSVP_TABLE_NAME=Event Invites
# setup:baserow-rsvp prompts for Baserow login interactively (not stored in .env)
# npm run setup:event-admin — shared by Studio Event invites tool + /api/event-admin
# EVENT_ADMIN_SECRET=
# EVENT_ADMIN_URL=http://localhost:4321
# BASEROW_RSVP_GRID_URL=https://baserow.io/database/465058/table/...
# INVITE_EVENT_SLUG=private-launch-party
# Required — shared secret + CSRF for POST /api/subscribe (GitHub secret + wrangler pages secret)
SUBSCRIBE_SECRET=

# GitHub secrets (not .env) — Gwenda account API token + account ID for CI:
#   CLOUDFLARE_API_TOKEN — custom token (https://dash.cloudflare.com/profile/api-tokens):
#     Account | Cloudflare Pages | Edit          (all accounts)
#     Zone    | DNS              | Edit          (gwenda.co.uk)
#     App Security | Bot Management | Edit          (zone: gwenda.co.uk)
#   Without Bot Management Edit, ensure-zone-ai-access.mjs fails with "Authentication error".
#   Manual alternative (no API): gwenda.co.uk → Security → Settings → Bot traffic →
#     Block AI bots = Do not block (off); Instruct AI bot traffic with robots.txt = OFF
#   CLOUDFLARE_ACCOUNT_ID=1c23e160e39a187ce33fe192595c4a7f
#   BASEROW_API_KEY
# GitHub variables:
#   BASEROW_STAGING_TABLE_ID (staging subscribe, default 1024006)
#   BASEROW_TABLE_ID (production subscribe, default 1017358)
#   SUBSCRIBE_SECRET
# Zone gwenda.co.uk must live on that account for production DNS automation (one-time move).

# Hero countdown target — YYYY-MM-DD (not shown in UI; drives counter only)
PUBLIC_OPENING_DATE=2026-08-01

# OpenTable booking CTA — YYYY-MM-DD from which "Book a table" appears (unset = hidden)
# PUBLIC_BOOKING_ENABLED_FROM=2026-07-18

# Private event invite page hero (email + /invite/{token})
# PUBLIC_INVITE_IMAGE_URL=https://gwenda.co.uk/images/event-invite.jpg

# Local dev — mirrors staging (ribbon + password gate; CI uses the same vars)
PUBLIC_IS_STAGING=true
SITE_PASSWORD=
GATE_BYPASS_KEY=        # optional shareable link key — ?access=<key> sets the gate cookie
PREVIEW_PASSWORD=       # /preview only (optional extra lock, browser basic auth)

# Deploy workflow (GitLab Flow):
#   main push    → verify → deploy to gwenda-staging → gwenda-staging.pages.dev
#   release push → verify → deploy to gwenda → gwenda.co.uk (+ CalVer tag)
#
# Release: merge main into release, then push release (no separate CI on the PR).
# CI: Node 24, npm via Corepack (see packageManager in package.json).
# Build metadata injected at build time:
#   PUBLIC_BUILD_SHA / PUBLIC_BUILD_REF / PUBLIC_BUILD_TIME / PUBLIC_BUILD_VERSION
# Version format: YYYY.MM.DD+shortsha (CalVer). Verify a deploy:
#   curl -sI https://gwenda.co.uk | grep -i x-gwenda
#   curl -sI https://gwenda-staging.pages.dev | grep -i x-gwenda

# ── Sanity CMS (see docs/sanity.md) ──
SANITY_PROJECT_ID=pn5yjro6
SANITY_DATASET=development
SANITY_API_TOKEN=          # Developer token — local dev only
# CI secrets: npm run setup:ci-secrets  (Viewer + Deploy Studio → GitHub)

# ── Utils (see ark/utils/README.md) ──
# CLICKUP_API_KEY and field IDs live in workspace root `.env` (GwendaDrive/.env)
# Event invites: utils/event-invites/README.md — all vars in repo-root `.env`
# Recipe cost worker: ark/utils/recipe-cost-webhook — wrangler secrets on deploy
#
# CLICKUP_NOTES_FIELD_ID=5bd43b45-a557-4a68-9785-3fe1d4b98c10
# RECIPE_COST_FIELD_ID=47a5d814-88c1-4ba7-bf3a-4d5d2fa0a9e3
# …see wrangler.toml [vars] for full list

# Content deploy (Sanity Studio → site rebuild) — see docs/sanity.md
# DEPLOY_WEBHOOK_SECRET=                 # generated by npm run setup:site-deploy
# SANITY_STUDIO_SITE_DEPLOY_URL=         # also accepted; maps from SITE_DEPLOY_WEBHOOK_URL
# DISPATCH_TOKEN=                 # set automatically from `gh auth token` in setup script
