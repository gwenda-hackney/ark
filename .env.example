# Newsletter — /api/subscribe forwards to Buttondown when set (Cloudflare Pages env)
PUBLIC_BUTTONDOWN_USERNAME=

# Cloudflare Web Analytics beacon token — from dashboard or npm run setup:analytics
# CI resolves automatically on deploy; set as GitHub var as fallback
PUBLIC_CF_BEACON_TOKEN=

# GitHub secrets (not .env) — Gwenda account API token + account ID for CI:
#   CLOUDFLARE_API_TOKEN
#   CLOUDFLARE_ACCOUNT_ID=1c23e160e39a187ce33fe192595c4a7f
# Zone gwenda.co.uk must live on that account for DNS automation (one-time move).

# Cloudflare Pages — site gate (production secrets, not committed)
SITE_PASSWORD=          # whole site while pre-launch — themed /gate page + cookie
PREVIEW_PASSWORD=       # /preview only (optional extra lock, browser basic auth)
