# Repo-root .env is optional: personal overrides only. See docs/env.md.
# Secrets load from the Bitwarden vault after bw-unlock; local settings
# default to the dev copies (scripts/lib/load-env.mjs LOCAL_DEFAULTS).

# Where form emails from your local site go. Defaults to your git email
# (git config user.email); set this only to send them somewhere else.
# FORMS_NOTIFY_EMAIL=
