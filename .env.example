# Repo-root .env: shared local bootstrap + plain local settings. See docs/env.md.
# Fresh clone: npm run env:pull  (Bitwarden note `ark/.env.local` → .env)
#
# Credentials are not kept here. They come from Bitwarden Secrets Manager:
#   npm run env:secrets:pull   → .env.secrets (every app's secrets under SM names;
#                                 with-env / with-ops-env map them per app)
# Non-secret app settings live in the Baserow Gwenda Config database (docs/config.md).
# Do not mint new API tokens unless rotating.

# Secrets Manager machine-account token (ark-local). The only secret in .env.
ARK_LOCAL_BW_TOKEN=

# ── Sanity (docs/sanity.md) ──
SANITY_PROJECT_ID=pn5yjro6
SANITY_DATASET=staging
# Editor token (ark-local-editor) is SANITY_API_TOKEN in SM → .env.secrets.

# ── Site (local mirrors staging: ribbon + password gate) ──
PUBLIC_IS_STAGING=true
# Opening date (YYYY-MM-DD). Used for Story year; not shown as a countdown.
PUBLIC_OPENING_DATE=2026-08-01
# Public origin for RSVP / ticket links.
INVITE_BASE_URL=http://localhost:4321

# ── SMTP (password is SMTP_PASSWORD in SM → .env.secrets) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@gwenda.co.uk

# ── Baserow ──
# Tables are resolved by name. setup:* scripts use a JWT cached in .baserow-jwt.json.
# Workspace for npm run setup:baserow-ops when creating a new database.
BASEROW_WORKSPACE_ID=208709
# Local Ops dev database (written by npm run clone:baserow-ops-dev).
BASEROW_OPS_DATABASE_ID=
BASEROW_OPS_DEV_WORKSPACE_ID=

# ── Wi-Fi captive portal (marketing/wifi-captive-portal, npm run setup:wifi-portal) ──
# UNIFI_SITE_MANAGER_API_KEY is in SM → .env.secrets (unifi.ui.com → Settings → API Keys).
UNIFI_CONSOLE_ID=A89C6C0EB1810000000009A42CB9000000000A2C1924000000006920A430:1883747293

# ── Content deploy (Sanity Studio → site rebuild, docs/sanity.md) ──
# Written by npm run setup:site-deploy. The secret is DEPLOY_WEBHOOK_SECRET in SM.
SANITY_STUDIO_SITE_DEPLOY_URL=

# ── Optional: Mailchimp (npm run setup:subscribe-mailchimp-sync) ──
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=

# ── CI (GitHub, not .env) ──
# BWS_ACCESS_TOKEN plus Cloudflare deploy copies CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID.
# CLOUDFLARE_API_TOKEN scopes (https://dash.cloudflare.com/profile/api-tokens):
#   Account | Cloudflare Pages | Edit          (all accounts)
#   Zone    | DNS              | Edit          (gwenda.co.uk)
#   App Security | Bot Management | Edit      (zone: gwenda.co.uk)
# Without Bot Management Edit, ensure-zone-ai-access.mjs fails with "Authentication error".
#
# Deploy workflow (GitLab Flow):
#   main push    → verify → deploy to gwenda-staging → gwenda-staging.pages.dev
#   release push → verify → deploy to gwenda → gwenda.co.uk (+ CalVer tag)
# Version format: YYYY.MM.DD+shortsha. Verify a deploy:
#   curl -sI https://gwenda.co.uk | grep -i x-gwenda

# ── Utils (utils/README.md) ──
# CLICKUP_API_KEY and field ids live in the nest `.env`, not here.
