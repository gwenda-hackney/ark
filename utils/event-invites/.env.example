# Event invites — copy to workspace .env or export before running

# ClickUp guest list (Marketing or Events space)
CLICKUP_INVITE_LIST_ID=

# Custom field names on list tasks
CLICKUP_INVITE_EMAIL_FIELD=Email
CLICKUP_INVITE_INSTAGRAM_FIELD=Instagram

# Email content
INVITE_EMAIL_SUBJECT=You are invited — Gwenda
# INVITE_EMAIL_BODY=...  # optional; supports {name}

# SMTP (e.g. Gmail app password, SendGrid, Postmark)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Dan <dan@gwenda.co.uk>
