{
  "name": "ark",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "marketing/web",
    "marketing/brand",
    "marketing/studio",
    "marketing/site-deploy-webhook",
    "marketing/subscribe-mailchimp-sync",
    "marketing/site-health",
    "marketing/wifi-captive-portal",
    "ops/site"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web:dev": "npm run dev -w @gwenda/web",
    "web:dev:live": "npm run dev:live -w @gwenda/web",
    "ops:dev": "npm run dev -w @gwenda/ops",
    "ops:prod": "npm run dev:prod -w @gwenda/ops",
    "studio:dev": "npm run dev -w @gwenda/studio",
    "build": "npm run build -w @gwenda/web",
    "test": "npm run test -w @gwenda/web",
    "test:shared": "vitest run --project shared --project scripts",
    "web:build:serve": "npm run preview -w @gwenda/web",
    "dev:refresh": "npm run dev:refresh:sanity && npm run dev:refresh:data",
    "dev:refresh:data": "node scripts/copy-prod-to-dev.mjs --target=ops-data && node scripts/copy-prod-to-dev.mjs --target=website-data",
    "dev:refresh:sanity": "node scripts/sanity-dev-refresh.mjs",
    "studio:deploy": "npm run deploy -w @gwenda/studio",
    "migrate": "node scripts/migrate.mjs",
    "release:pr": "node scripts/release-pr.mjs",
    "rulesets:apply": "node scripts/rulesets-apply.mjs",
    "env:status": "node scripts/env-status.mjs",
    "brand:add": "node scripts/brand-add.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "brand:logo": "node scripts/trace-logo.mjs",
    "env:secrets:refresh": "node scripts/pull-app-env-from-sm.mjs",
    "env:ops:pull": "node scripts/pull-app-env-from-sm.mjs ops",
    "env:ops:push": "node scripts/push-app-env-to-sm.mjs ops",
    "env:web:pull": "node scripts/pull-app-env-from-sm.mjs web",
    "env:web:push": "node scripts/push-app-env-to-sm.mjs web",
    "env:ark:pull": "node scripts/pull-app-env-from-sm.mjs ark",
    "env:ark:push": "node scripts/push-app-env-to-sm.mjs ark",
    "setup:sanity-tokens": "node scripts/setup-sanity-tokens.mjs",
    "setup:uptime": "node scripts/with-env.mjs node scripts/setup-uptime-monitors.mjs",
    "setup:sentry": "node scripts/setup-sentry.mjs",
    "sentry:issues": "node scripts/sentry-issues.mjs",
    "secret:set": "node scripts/secret-set.mjs",
    "secrets:move-dev": "node scripts/sm-move-dev.mjs",
    "secrets:import-env": "node scripts/sm-import-env.mjs",
    "secrets:rename": "node scripts/sm-rename.mjs",
    "sync:print-menu-sections": "node scripts/with-ops-env.mjs node scripts/sync-print-menu-sections.mjs",
    "enrich:ops-inventory": "node scripts/with-ops-env.mjs node ops/site/scripts/enrich-inventory-suppliers.mjs",
    "ingest:lwc-price-list": "node scripts/with-ops-env.mjs node ops/site/scripts/ingest-lwc-price-list.mjs",
    "fetch:ops-menu-photos": "node scripts/with-ops-env.mjs node scripts/fetch-ops-menu-vendor-photos.mjs",
    "setup:site-deploy": "node scripts/setup-site-deploy.mjs",
    "setup:ops": "node scripts/setup-ops-secrets.mjs",
    "setup:subscribe-mailchimp-sync": "node scripts/setup-subscribe-mailchimp-sync.mjs",
    "setup:d1": "node scripts/setup-d1.mjs",
    "d1:freeze": "node scripts/d1-freeze.mjs",
    "data:move": "node scripts/data-move.mjs",
    "rehearse:rollout": "node scripts/with-ops-env.mjs node scripts/rehearse-rollout.mjs",
    "config:set": "node scripts/config-set.mjs",
    "setup:site-health": "node scripts/setup-site-health.mjs",
    "setup:wifi-portal": "node scripts/setup-wifi-portal.mjs",
    "subscribe-mailchimp-sync": "node scripts/with-env.mjs npm run cli -w @gwenda/subscribe-mailchimp-sync --",
    "wifi-portal": "node scripts/wifi-portal-dev.mjs",
    "wifi-portal:dev": "node scripts/wifi-portal-dev.mjs",
    "wifi-portal:deploy": "node scripts/with-env.mjs npm run deploy -w @gwenda/wifi-captive-portal",
    "generate:brand-assets": "npm run generate:brand-assets -w @gwenda/web",
    "sync:brand": "node .github/scripts/sync-brand-tokens.mjs",
    "lint": "npm run lint -w @gwenda/web",
    "lint:fix": "npm run lint:fix -w @gwenda/web"
  },
  "devDependencies": {
    "potrace": "2.1.8",
    "sharp": "0.33.5",
    "svgo": "4.1.0",
    "vitest": "^4.1.9"
  }
}
