{
  "name": "ark",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "web",
    "brand",
    "studio",
    "utils/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gwenda/web",
    "build": "npm run build -w @gwenda/web",
    "preview": "npm run preview -w @gwenda/web",
    "studio": "npm run dev -w @gwenda/studio",
    "studio:deploy": "SANITY_ACTIVE_ENV=production npm run deploy -w @gwenda/studio",
    "studio:deploy:dev": "SANITY_ACTIVE_ENV=development npm run deploy -w @gwenda/studio",
    "studio:dataset:create": "npm run dataset:create -w @gwenda/studio --",
    "studio:seed:dev": "env -u SANITY_API_TOKEN SANITY_DATASET=development node --env-file=.env studio/scripts/seed-menu.mjs",
    "studio:seed:production": "env -u SANITY_API_TOKEN SANITY_DATASET=production CONFIRM_PRODUCTION_SEED=1 node --env-file=.env studio/scripts/seed-menu.mjs",
    "studio:seed:events:dev": "env -u SANITY_API_TOKEN SANITY_DATASET=development node --env-file=.env studio/scripts/seed-events.mjs",
    "studio:seed:events:production": "env -u SANITY_API_TOKEN SANITY_DATASET=production CONFIRM_PRODUCTION_SEED=1 node --env-file=.env studio/scripts/seed-events.mjs",
    "studio:migrate:launch-event:dev": "node --env-file=.env studio/scripts/migrate-launch-event.mjs",
    "studio:migrate:launch-event:production": "SANITY_DATASET=production CONFIRM_PRODUCTION_MIGRATE=1 node --env-file=.env studio/scripts/migrate-launch-event.mjs",
    "studio:fix:events:dev": "node --env-file=.env studio/scripts/fix-events.mjs",
    "studio:fix:events:production": "SANITY_DATASET=production CONFIRM_PRODUCTION_MIGRATE=1 node --env-file=.env studio/scripts/fix-events.mjs",
    "setup:event-admin": "node scripts/setup-event-admin.mjs",
    "setup:event-ops": "node --env-file=.env scripts/setup-event-ops.mjs",
    "setup:baserow-rsvp": "node --env-file=.env scripts/setup-baserow-rsvp.mjs",
    "setup:instagram": "node --env-file=.env scripts/setup-instagram.mjs",
    "setup:ci-secrets": "node scripts/setup-ci-sanity-secrets.mjs",
    "setup:site-deploy": "node scripts/setup-site-deploy.mjs",
    "setup:subscribe-mailchimp-sync": "node scripts/setup-subscribe-mailchimp-sync.mjs",
    "subscribe-mailchimp-sync": "node scripts/with-env.mjs npm run cli -w @gwenda/subscribe-mailchimp-sync --",
    "setup:apple-wallet:csr": "node scripts/setup-apple-wallet.mjs csr",
    "setup:apple-wallet:import": "node scripts/setup-apple-wallet.mjs import",
    "event-invites": "node scripts/with-env.mjs npm run cli -w @gwenda/event-invites --",
    "generate:brand-assets": "npm run generate:brand-assets -w @gwenda/web",
    "sync:brand": "node .github/scripts/sync-brand-tokens.mjs",
    "test": "npm run test -w @gwenda/web",
    "lint": "npm run lint -w @gwenda/web",
    "lint:fix": "npm run lint:fix -w @gwenda/web"
  }
}
