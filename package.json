{
  "name": "ark",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "marketing/web",
    "marketing/brand",
    "marketing/studio",
    "marketing/site-deploy-webhook",
    "marketing/subscribe-mailchimp-sync",
    "marketing/site-health",
    "marketing/wifi-captive-portal",
    "ops/site",
    "ops/site/menu-app",
    "ops/recipe-cost-webhook"
  ],
  "scripts": {
    "dev": "npm run dev -w @gwenda/web",
    "build": "npm run build -w @gwenda/web",
    "preview": "npm run preview -w @gwenda/web",
    "studio": "npm run dev -w @gwenda/studio",
    "studio:deploy": "SANITY_ACTIVE_ENV=production npm run deploy -w @gwenda/studio",
    "studio:deploy:staging": "SANITY_ACTIVE_ENV=staging npm run deploy -w @gwenda/studio",
    "studio:deploy:dev": "SANITY_ACTIVE_ENV=development npm run deploy -w @gwenda/studio",
    "studio:dataset:create": "npm run dataset:create -w @gwenda/studio --",
    "studio:seed:dev": "env -u SANITY_API_TOKEN SANITY_DATASET=staging node --env-file=.env marketing/studio/scripts/seed-menu.mjs",
    "studio:seed:production": "env -u SANITY_API_TOKEN SANITY_DATASET=production CONFIRM_PRODUCTION_SEED=1 node --env-file=.env marketing/studio/scripts/seed-menu.mjs",
    "studio:seed:events:dev": "env -u SANITY_API_TOKEN SANITY_DATASET=staging node --env-file=.env marketing/studio/scripts/seed-events.mjs",
    "studio:seed:events:production": "env -u SANITY_API_TOKEN SANITY_DATASET=production CONFIRM_PRODUCTION_SEED=1 node --env-file=.env marketing/studio/scripts/seed-events.mjs",
    "studio:migrate:launch-event:dev": "node --env-file=.env marketing/studio/scripts/migrate-launch-event.mjs",
    "studio:migrate:launch-event:production": "SANITY_DATASET=production CONFIRM_PRODUCTION_MIGRATE=1 node --env-file=.env marketing/studio/scripts/migrate-launch-event.mjs",
    "studio:fix:events:dev": "node --env-file=.env marketing/studio/scripts/fix-events.mjs",
    "studio:fix:events:production": "SANITY_DATASET=production CONFIRM_PRODUCTION_MIGRATE=1 node --env-file=.env marketing/studio/scripts/fix-events.mjs",
    "studio:seed:forms:dev": "env -u SANITY_API_TOKEN SANITY_DATASET=staging node --env-file=.env marketing/studio/scripts/seed-forms.mjs",
    "studio:seed:forms:production": "env -u SANITY_API_TOKEN SANITY_DATASET=production CONFIRM_PRODUCTION_SEED=1 node --env-file=.env marketing/studio/scripts/seed-forms.mjs",
    "env:pull": "node scripts/pull-env-from-bitwarden.mjs",
    "env:push": "node scripts/push-env-to-bitwarden.mjs",
    "env:seed": "node scripts/seed-bitwarden-env.mjs",
    "env:set": "node scripts/set-bitwarden-env.mjs",
    "env:ops:pull": "node scripts/pull-app-env-from-sm.mjs ops",
    "env:ops:push": "node scripts/push-app-env-to-sm.mjs ops",
    "env:web:pull": "node scripts/pull-app-env-from-sm.mjs web",
    "env:web:push": "node scripts/push-app-env-to-sm.mjs web",
    "env:ark:pull": "node scripts/pull-app-env-from-sm.mjs ark",
    "env:ark:push": "node scripts/push-app-env-to-sm.mjs ark",
    "setup:sanity-tokens": "node scripts/setup-sanity-tokens.mjs",
    "sync:sanity-datasets": "node scripts/sync-sanity-datasets.mjs",
    "setup:baserow-rsvp": "node --env-file=.env scripts/setup-baserow-rsvp.mjs",
    "setup:baserow-form-submissions": "node --env-file=.env scripts/setup-baserow-form-submissions.mjs",
    "setup:baserow-ops": "node scripts/with-ops-env.mjs node scripts/setup-baserow-ops.mjs",
    "setup:baserow-config": "node scripts/setup-baserow-config.mjs",
    "clone:baserow-ops-dev": "node scripts/with-ops-env.mjs node scripts/clone-baserow-ops-db.mjs",
    "promote:baserow-ops-to-production": "node scripts/with-ops-env.mjs node scripts/promote-baserow-ops-to-production.mjs",
    "clone:baserow-web-dev": "node scripts/with-env.mjs node scripts/clone-baserow-web-db.mjs",
    "clone:baserow-web-staging": "node scripts/with-env.mjs node scripts/clone-baserow-web-db.mjs --target=staging",
    "seed:baserow-ops-menu": "node scripts/with-ops-env.mjs node scripts/seed-baserow-ops-menu.mjs",
    "seed:ops-print-menu": "node scripts/with-ops-env.mjs node scripts/seed-ops-print-menu.mjs",
    "sync:print-menu-sections": "node scripts/with-ops-env.mjs node scripts/sync-print-menu-sections.mjs",
    "enrich:ops-inventory": "node scripts/with-ops-env.mjs node scripts/enrich-ops-inventory-suppliers.mjs",
    "ingest:lwc-price-list": "node scripts/with-ops-env.mjs node scripts/ingest-lwc-price-list.mjs",
    "fetch:ops-menu-photos": "node scripts/with-ops-env.mjs node scripts/fetch-ops-menu-vendor-photos.mjs",
    "setup:ci-secrets": "node scripts/setup-ci-sanity-secrets.mjs",
    "setup:site-deploy": "node scripts/setup-site-deploy.mjs",
    "setup:ops": "node scripts/setup-ops-secrets.mjs",
    "teardown:ops-access": "node scripts/with-ops-env.mjs node scripts/teardown-ops-access.mjs",
    "setup:subscribe-mailchimp-sync": "node scripts/setup-subscribe-mailchimp-sync.mjs",
    "setup:site-health": "node scripts/setup-site-health.mjs",
    "setup:wifi-portal": "node scripts/setup-wifi-portal.mjs",
    "migrate:subscribe-sync-runs": "CONFIRM_PRODUCTION_MIGRATE=1 node --env-file=.env scripts/migrate-subscribe-sync-runs.mjs",
    "migrate:subscribe-wifi-tag": "node --env-file=.env scripts/migrate-subscribe-tag-multi.mjs",
    "migrate:subscribe-tag-multi": "node --env-file=.env scripts/migrate-subscribe-tag-multi.mjs",
    "subscribe-mailchimp-sync": "node scripts/with-env.mjs npm run cli -w @gwenda/subscribe-mailchimp-sync --",
    "wifi-portal": "node scripts/wifi-portal-dev.mjs",
    "wifi-portal:dev": "node scripts/wifi-portal-dev.mjs",
    "wifi-portal:deploy": "node scripts/with-env.mjs npm run deploy -w @gwenda/wifi-captive-portal",
    "setup:apple-wallet:csr": "node scripts/setup-apple-wallet.mjs csr",
    "setup:apple-wallet:import": "node scripts/setup-apple-wallet.mjs import",
    "generate:brand-assets": "npm run generate:brand-assets -w @gwenda/web",
    "sync:brand": "node .github/scripts/sync-brand-tokens.mjs",
    "test": "npm run test -w @gwenda/web",
    "lint": "npm run lint -w @gwenda/web",
    "lint:fix": "npm run lint:fix -w @gwenda/web"
  }
}
