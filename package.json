{
  "name": "gwenda-web",
  "private": true,
  "packageManager": "npm@11.13.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build && node scripts/write-seo-files.mjs && node scripts/write-build-headers.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "ensure:project": "node scripts/ensure-pages-project.mjs",
    "ensure:domain": "node scripts/ensure-pages-domain.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/lora": "^5.2.8",
    "astro": "^4.16.18"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  }
}
